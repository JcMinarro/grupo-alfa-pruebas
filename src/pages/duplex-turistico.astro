---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import ProjectLayout from "../layouts/ProjectLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectDetails from "../components/project/ProjectDetails.astro";
import ProjectFinancials from "../components/project/ProjectFinancials.astro";
import ProjectROI from "../components/project/ProjectROI.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ProjectLayout
    title={`Dúplex Turístico | ${t("brand.name")}`}
    bodyClass="duplex-page"
>
    <Hero
        title={t("projects.duplex.title")}
        location="CENTRO DE MURCIA"
        backgroundImage="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
        height="50vh"
    />

    <section class="project-details container fade-in">
        <a href="/proyectos" class="back-link">{t("projects.back")}</a>

        <h2>{t("projects.details.title")}</h2>
        <ProjectDetails
            type={t("projects.duplex.details.type")}
            location={t("projects.duplex.details.location")}
            surface="100 m² (70 + 30)"
            distribution={t("projects.duplex.details.distribution")}
        />

        <div
            class="project-showcase"
            style="margin: 40px 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;"
        >
            <img
                src="/assets/photo-1616046229478-9901c5536a456111.jpg"
                alt={t("projects.duplex.image1.alt")}
                style="width: 100%; border-radius: 8px;"
            />
            <img
                src="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
                alt={t("projects.duplex.image2.alt")}
                style="width: 100%; border-radius: 8px;"
            />
        </div>

        <ProjectFinancials
            costs={[
                {
                    concept: t("projects.common.costs.compra"),
                    amount: "85.000 €",
                },
                {
                    concept: t("projects.common.costs.reforma"),
                    amount: "50.000 €",
                },
                {
                    concept: t("projects.common.costs.licencias"),
                    amount: "8.000 €",
                },
                {
                    concept: t("projects.duplex.costs.muebles"),
                    amount: "12.000 €",
                },
                {
                    concept: t("projects.chalet.costs.imprevistos"),
                    amount: "5.000 €",
                },
            ]}
            total="160.000 €"
        />

        <ProjectROI
            strategy="both"
            saleData={{
                price: "210.000 € (Rentado)",
                profit: "50.000 € (neto est.)",
                roi: "41,25 %",
            }}
            rentData={{
                monthly: t("projects.duplex.roi.rent.monthly"),
                annual: t("projects.duplex.roi.rent.annual"),
                roi: "13,28 %",
            }}
        />

        <div class="executive-summary">
            <h3>{t("projects.executiveSummary")}</h3>
            <p>
                {t("projects.duplex.summary")}
            </p>
        </div>

        <div style="text-align: center; margin-top: 60px;">
            <a
                href="/#contacto"
                class="btn-primary"
                style="background-color: var(--color-primary); color: #000; padding: 15px 40px; text-decoration: none; border-radius: 50px; font-weight: 700; display: inline-block;"
                >{t("projects.interested")}</a
            >
        </div>
    </section>
</ProjectLayout>
