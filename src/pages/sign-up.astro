---
import { SignUp } from '@clerk/astro/components';
import BaseLayout from '../layouts/BaseLayout.astro';

if (Astro.locals.auth?.().isAuthenticated) {
    return Astro.redirect('/join');
}

const promo = Astro.url.searchParams.get('promo');
const ref = Astro.url.searchParams.get('ref');
const unsafeRedirectUrl = Astro.url.searchParams.toString();
const redirectUrl = unsafeRedirectUrl ? `/join?${unsafeRedirectUrl}` : '/join';
---

<BaseLayout title="Sign Up | Club Alfa" bodyClass="members-page auth-page bg-[#0f1012] text-white">
    <section class="auth-shell min-h-screen flex items-center justify-center px-4 py-28">
        <div class="auth-card w-full max-w-[640px] rounded-[34px] border border-white/10 bg-white/[0.06] p-5 shadow-[0_24px_90px_rgba(0,0,0,0.35)] md:p-8">
            <p class="text-primary uppercase tracking-[5px] text-sm font-bold mb-3">Club Alfa</p>
            <h1 class="text-[2.5rem] leading-[1.02] font-bold mb-4 md:text-5xl">Create your membership account</h1>
            <p class="text-white/70 mb-6 text-lg leading-[1.65]">Your Club Alfa account is required before checkout so we can activate access correctly.</p>
            {(promo || ref) && (
                <div class="mb-6 rounded-2xl border border-primary/40 bg-primary/10 px-4 py-3 text-sm text-white/80">
                    Campaign code detected. It will carry through the onboarding flow automatically.
                </div>
            )}
            <SignUp path="/sign-up" routing="path" signInUrl="/sign-in" fallbackRedirectUrl={redirectUrl} />
            <p class="mt-6 text-sm leading-[1.7] text-white/55">
                By creating an account you can review the <a href="/membership-terms" class="text-primary underline">Membership terms</a> and <a href="/privacy" class="text-primary underline">Privacy policy</a> before paid onboarding.
            </p>
        </div>
    </section>
</BaseLayout>
