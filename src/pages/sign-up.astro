---
import { SignUp } from '@clerk/astro/components';
import BaseLayout from '../layouts/BaseLayout.astro';

if (Astro.locals.auth?.().isAuthenticated) {
    return Astro.redirect('/api/checkout');
}

const promo = Astro.url.searchParams.get('promo');
const ref = Astro.url.searchParams.get('ref');
const reviewed = Astro.url.searchParams.get('reviewed') === '1';
const campaignParams = new URLSearchParams();
if (promo) campaignParams.set('promo', promo);
if (ref) campaignParams.set('ref', ref);

if ((promo || ref) && !reviewed) {
    return Astro.redirect(`/membership?${campaignParams.toString()}`);
}

const checkoutParams = new URLSearchParams();
if (promo) checkoutParams.set('promo', promo);
if (ref) checkoutParams.set('ref', ref);
const redirectUrl = `/api/checkout${checkoutParams.toString() ? `?${checkoutParams.toString()}` : ''}`;
---

<BaseLayout title="Registro | Club Alfa" bodyClass="members-page auth-page bg-[#0f1012] text-white">
    <section class="auth-shell min-h-screen flex items-center justify-center px-4 py-28">
        <div class="auth-card w-full max-w-[640px] rounded-[34px] border border-white/10 bg-white/[0.06] p-5 shadow-[0_24px_90px_rgba(0,0,0,0.35)] md:p-8">
            <p class="text-primary uppercase tracking-[5px] text-sm font-bold mb-3">Club Alfa</p>
            <h1 class="text-[2.5rem] leading-[1.02] font-bold mb-4 md:text-5xl">Crear cuenta de miembro</h1>
            <p class="text-white/70 mb-6 text-lg leading-[1.65]">Necesitas una cuenta de Club Alfa antes del pago para activar tu acceso correctamente.</p>
            {(promo || ref) && (
                <div class="mb-6 rounded-2xl border border-primary/40 bg-primary/10 px-4 py-3 text-sm text-white/80">
                    Código de campaña detectado. Lo mantendremos automáticamente durante el proceso.
                </div>
            )}
            <SignUp path="/sign-up" routing="path" signInUrl="/sign-in" fallbackRedirectUrl={redirectUrl} />
            <p class="mt-6 text-sm leading-[1.7] text-white/55">
                Al crear una cuenta podrás revisar las <a href="/membership-terms" class="text-primary underline">condiciones de membresía</a> y la <a href="/privacy" class="text-primary underline">política de privacidad</a> antes de continuar con el pago.
            </p>
        </div>
    </section>
</BaseLayout>
