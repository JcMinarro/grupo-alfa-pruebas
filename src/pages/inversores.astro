---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import ProjectLayout from "../layouts/ProjectLayout.astro";
import Hero from "../components/Hero.astro";
import { heros } from "../data/heros.js";
import InfoGrid from "../components/InfoGrid.astro";
import GridItem from "../components/GridItem.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ProjectLayout
    title={`Inversores | ${t("brand.name")}`}
    bodyClass="investor-page bg-white text-dark"
    activeNav="inversores"
>
    <Hero
        title={t("inversores.hero.title")}
        subtitle={t("inversores.hero.subtitle")}
        backgroundImage="/assets/photo-1707903244219-8ed71537554d3d83.jpg"
        backgroundVideo={heros.inversores}
        videoPoster="/assets/photo-1707903244219-8ed71537554d3d83.jpg"
        height="50vh"
    />

    <section class="max-w-[1200px] mx-auto py-20 px-5 fade-in">
        <h2 class="text-3xl font-bold mb-20 text-center text-dark">
            {t("inversores.steps.title")}
        </h2>

        <InfoGrid columns={3}>
            <GridItem
                title={t("inversores.step1.title")}
                description={t("inversores.step1.description")}
                number="01"
            />
            <GridItem
                title={t("inversores.step2.title")}
                description={t("inversores.step2.description")}
                number="02"
            />
            <GridItem
                title={t("inversores.step3.title")}
                description={t("inversores.step3.description")}
                number="03"
            />
            <GridItem
                title={t("inversores.step4.title")}
                description={t("inversores.step4.description")}
                number="04"
            />
            <GridItem
                title={t("inversores.step5.title")}
                description={t("inversores.step5.description")}
                number="05"
            />
            <GridItem
                title={t("inversores.step6.title")}
                description={t("inversores.step6.description")}
                number="06"
            />
        </InfoGrid>

        <div class="text-center mt-20">
            <a
                href="/contacto"
                class="bg-primary text-black px-10 py-[15px] rounded-full font-bold uppercase transition-all hover:scale-105 hover:bg-[#ffc400] inline-block"
                >{t("inversores.cta.button")}</a
            >
        </div>
    </section>
</ProjectLayout>
