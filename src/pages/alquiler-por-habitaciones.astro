---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import ProjectLayout from "../layouts/ProjectLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectDetails from "../components/project/ProjectDetails.astro";
import ProjectFinancials from "../components/project/ProjectFinancials.astro";
import ProjectROI from "../components/project/ProjectROI.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ProjectLayout
    title={`Alquiler por Habitaciones | ${t("brand.name")}`}
    bodyClass="rooms-page"
>
    <Hero
        title={t("projects.rooms.title")}
        location="MADRID"
        backgroundImage="/assets/photo-1616046229478-9901c5536a456111.jpg"
        height="50vh"
    />

    <section class="project-details container fade-in">
        <a href="/proyectos" class="back-link">{t("projects.back")}</a>

        <h2>{t("projects.details.title")}</h2>
        <ProjectDetails
            type={t("projects.rooms.details.type")}
            location={t("projects.rooms.details.location")}
            distribution={t("projects.rooms.details.distribution")}
        />

        <ProjectFinancials
            costs={[
                {
                    concept: t("projects.common.costs.compra"),
                    amount: "195.000 €",
                },
                {
                    concept: t("projects.common.costs.reforma"),
                    amount: "45.000 €",
                },
                {
                    concept: t("projects.common.costs.licencias"),
                    amount: "10.000 €",
                },
                {
                    concept: t("projects.common.costs.muebles"),
                    amount: "10.000 €",
                },
            ]}
            total="260.000 €"
        />

        <ProjectROI
            strategy="both"
            saleData={{
                price: "345.000 € (Rentado)",
                profit: "85.000 € (neto est.)",
                roi: "32,69 %",
            }}
            rentData={{
                monthly: "750 € (x hab)",
                annual: "45.000 €",
                roi: "14,71 %",
            }}
        />

        <div class="executive-summary">
            <h3>{t("projects.executiveSummary")}</h3>
            <p>
                {t("projects.rooms.summary")}
            </p>
        </div>

        <div style="text-align: center; margin-top: 60px;">
            <a
                href="/#contacto"
                class="btn-primary"
                style="background-color: var(--color-primary); color: #000; padding: 15px 40px; text-decoration: none; border-radius: 50px; font-weight: 700; display: inline-block;"
                >{t("projects.interested")}</a
            >
        </div>
    </section>
</ProjectLayout>
