---
import MemberLayout from '../../layouts/MemberLayout.astro';
import { requireActiveMembership } from '../../lib/server/membership';

await requireActiveMembership(Astro.locals);
---

<MemberLayout title="Expert Sessions" activePath="/members/expert-sessions">
    <section class="rounded-[28px] border border-dashed border-white/15 bg-white/5 p-8">
        <h2 class="text-2xl font-bold mb-4">Expert sessions</h2>
        <p class="text-white/70 leading-[1.8]">This private area is reserved for future appointment requests and specialist support workflows.</p>
    </section>
</MemberLayout>
