---
import MemberLayout from '../../layouts/MemberLayout.astro';
import { requireActiveMembership } from '../../lib/server/membership';

try {
    await requireActiveMembership(Astro.locals);
} catch (error) {
    return Astro.redirect(error instanceof Error ? error.message : '/membership?payment_required=1');
}
---

<MemberLayout title="Ventajas" activePath="/members/benefits">
    <section class="rounded-[28px] border border-white/10 bg-white/5 p-8">
        <h2 class="text-2xl font-bold mb-4">Ventajas para miembros</h2>
        <ul class="space-y-3 text-white/70 leading-[1.8]">
            <li>Acceso prioritario a oportunidades de Club Alfa.</li>
            <li>Soporte privado para miembros y acceso a expertos.</li>
            <li>Futuros recursos premium, masterclasses y seminarios.</li>
        </ul>
    </section>
</MemberLayout>
