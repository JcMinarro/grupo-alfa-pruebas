---
import MemberLayout from '../../layouts/MemberLayout.astro';
import { requireActiveMembership } from '../../lib/server/membership';
import ventajasClub from '../../data/member-benefits';

try {
    await requireActiveMembership(Astro.locals);
} catch (error) {
    return Astro.redirect(error instanceof Error ? error.message : '/membership?payment_required=1');
}
---

<MemberLayout title="Ventajas" activePath="/members/benefits">
    <section class="rounded-[32px] border border-white/10 bg-white/[0.06] p-6 md:p-10 mb-8 overflow-hidden relative">
        <div class="absolute inset-x-0 top-0 h-1 bg-primary"></div>
        <p class="text-primary uppercase tracking-[4px] text-sm font-bold mb-4">Ventajas exclusivas</p>
        <div class="max-w-[900px]">
            <h2 class="text-3xl md:text-5xl font-bold leading-tight mb-5">Todo el ecosistema Club Alfa en un solo lugar</h2>
            <p class="text-white/70 text-lg leading-[1.8]">Accede a servicios, acuerdos y oportunidades reservadas para socios. Entra en cada ventaja para ver qué incluye, para quién es y cómo solicitar el siguiente paso.</p>
        </div>
    </section>

    <section class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {ventajasClub.map((benefit) => (
            <a
                href={`/members/benefits/${benefit.slug}`}
                class="group rounded-[28px] border border-white/10 bg-white/5 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary/70 hover:bg-white/[0.08]"
            >
                <p class="text-primary uppercase tracking-[3px] text-xs font-bold mb-3">{benefit.category}</p>
                <div class="flex items-start justify-between gap-4 mb-4">
                    <h3 class="text-2xl font-bold leading-tight">{benefit.shortTitle}</h3>
                    <span class="rounded-full border border-white/15 px-3 py-1 text-xs uppercase tracking-[1px] text-white/60 group-hover:border-primary group-hover:text-primary">Ver ventaja</span>
                </div>
                <p class="text-white/70 leading-[1.7] mb-5">{benefit.summary}</p>
                <ul class="flex flex-wrap gap-2">
                    {benefit.highlights.slice(0, 3).map((highlight) => (
                        <li class="rounded-full bg-white/10 px-3 py-1 text-xs text-white/75">{highlight}</li>
                    ))}
                </ul>
            </a>
        ))}
    </section>

    <section class="mt-8 rounded-[28px] border border-white/10 bg-[#17191d] p-6 md:p-8">
        <h2 class="text-2xl font-bold mb-3">Cómo usar estas ventajas</h2>
        <p class="text-white/70 leading-[1.8]">Como socio de Club Alfa puedes solicitar cualquiera de estas ventajas desde tu área privada. Revisamos cada caso y te derivamos al equipo o colaborador especializado para activar el servicio adecuado.</p>
    </section>
</MemberLayout>
