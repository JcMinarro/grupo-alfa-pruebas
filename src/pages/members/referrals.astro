---
import MemberLayout from '../../layouts/MemberLayout.astro';
import { requireActiveMembership } from '../../lib/server/membership';

const membership = await requireActiveMembership(Astro.locals);
---

<MemberLayout title="Referrals" activePath="/members/referrals">
    <section class="rounded-[28px] border border-white/10 bg-white/5 p-8">
        <h2 class="text-2xl font-bold mb-4">Referral program</h2>
        <p class="text-white/70 leading-[1.8] mb-4">Referral attribution only applies on the initial membership purchase and never combines with organization promos.</p>
        <div class="rounded-2xl border border-primary/30 bg-primary/10 px-4 py-3 inline-flex text-primary font-bold uppercase tracking-[2px]">
            {membership.referralCodeUsed ?? 'Your referral code will appear here'}
        </div>
    </section>
</MemberLayout>
