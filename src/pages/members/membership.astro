---
import MemberLayout from '../../layouts/MemberLayout.astro';
import { requireActiveMembership } from '../../lib/server/membership';

const membership = await requireActiveMembership(Astro.locals);
---

<MemberLayout title="Membership" activePath="/members/membership">
    <section class="rounded-[28px] border border-white/10 bg-white/5 p-8">
        <h2 class="text-2xl font-bold mb-4">Current plan</h2>
        <p class="text-white/70 leading-[1.8] mb-3">Plan type: {membership.membershipType}</p>
        <p class="text-white/70 leading-[1.8] mb-8">Stripe remains the source of truth for billing, renewals, and cancel-at-period-end management.</p>
        <form method="POST" action="/api/billing-portal">
            <button type="submit" class="rounded-full bg-primary px-8 py-3 text-sm font-bold uppercase tracking-[2px] text-black">Open billing portal</button>
        </form>
    </section>
</MemberLayout>
