---
import MemberLayout from '../../layouts/MemberLayout.astro';
import { requireActiveMembership } from '../../lib/server/membership';

let membership;
try {
    membership = await requireActiveMembership(Astro.locals);
} catch (error) {
    return Astro.redirect(error instanceof Error ? error.message : '/membership?payment_required=1');
}
---

<MemberLayout title="Referidos" activePath="/members/referrals">
    <section class="rounded-[28px] border border-white/10 bg-white/5 p-8">
        <h2 class="text-2xl font-bold mb-4">Programa de referidos</h2>
        <p class="text-white/70 leading-[1.8] mb-4">La atribución de referido solo se aplica en la compra inicial de la membresía y nunca se combina con promociones de organización.</p>
        <div class="rounded-2xl border border-primary/30 bg-primary/10 px-4 py-3 inline-flex text-primary font-bold uppercase tracking-[2px]">
            {membership.referralCodeUsed ?? 'Tu código de referido aparecerá aquí'}
        </div>
    </section>
</MemberLayout>
