---
import MemberLayout from '../../layouts/MemberLayout.astro';
import { requireActiveMembership } from '../../lib/server/membership';

let membership;
try {
    membership = await requireActiveMembership(Astro.locals);
} catch (error) {
    return Astro.redirect(error instanceof Error ? error.message : '/membership?payment_required=1');
}
---

<MemberLayout title="Resumen de miembros" activePath="/members">
    <div class="grid gap-6 lg:grid-cols-3">
        <section class="lg:col-span-2 rounded-[28px] border border-white/10 bg-white/5 p-8">
            <p class="text-white/60 uppercase tracking-[3px] text-xs mb-2">Estado de la membresía</p>
            <h2 class="text-3xl font-bold mb-4 capitalize">{membership.membershipStatus}</h2>
            <p class="text-white/70 leading-[1.8]">Este es el inicio operativo del área privada de Club Alfa. Prioriza el estado de la membresía, referidos, ventajas y las próximas zonas premium que iremos desbloqueando.</p>
        </section>
        <section class="rounded-[28px] border border-white/10 bg-white/5 p-8">
            <p class="text-white/60 uppercase tracking-[3px] text-xs mb-2">Origen de alta</p>
            <h2 class="text-2xl font-bold mb-3 capitalize">{membership.initialAcquisitionSource}</h2>
            <p class="text-white/70 text-sm leading-[1.8]">La atribución de organización o referido queda asociada únicamente a la compra inicial.</p>
        </section>
    </div>
</MemberLayout>
