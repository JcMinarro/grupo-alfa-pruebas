---
import MemberLayout from '../../layouts/MemberLayout.astro';
import { requireActiveMembership } from '../../lib/server/membership';

const membership = await requireActiveMembership(Astro.locals);
---

<MemberLayout title="Members Overview" activePath="/members">
    <div class="grid gap-6 lg:grid-cols-3">
        <section class="lg:col-span-2 rounded-[28px] border border-white/10 bg-white/5 p-8">
            <p class="text-white/60 uppercase tracking-[3px] text-xs mb-2">Membership status</p>
            <h2 class="text-3xl font-bold mb-4 capitalize">{membership.membershipStatus}</h2>
            <p class="text-white/70 leading-[1.8]">This is the operational member home for Club Alfa. It prioritizes membership state, referrals, benefits, and the next premium areas to unlock.</p>
        </section>
        <section class="rounded-[28px] border border-white/10 bg-white/5 p-8">
            <p class="text-white/60 uppercase tracking-[3px] text-xs mb-2">Acquisition source</p>
            <h2 class="text-2xl font-bold mb-3 capitalize">{membership.initialAcquisitionSource}</h2>
            <p class="text-white/70 text-sm leading-[1.8]">Organization and referral attribution stays attached to the initial purchase only.</p>
        </section>
    </div>
</MemberLayout>
