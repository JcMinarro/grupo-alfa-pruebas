---
import MemberLayout from '../../layouts/MemberLayout.astro';
import { requireActiveMembership } from '../../lib/server/membership';

try {
    await requireActiveMembership(Astro.locals);
} catch (error) {
    return Astro.redirect(error instanceof Error ? error.message : '/membership?payment_required=1');
}
---

<MemberLayout title="Resources" activePath="/members/resources">
    <section class="rounded-[28px] border border-dashed border-white/15 bg-white/5 p-8">
        <h2 class="text-2xl font-bold mb-4">Resources are coming next</h2>
        <p class="text-white/70 leading-[1.8]">This member-only space is already reserved for future playbooks, recordings, and premium documents.</p>
    </section>
</MemberLayout>
