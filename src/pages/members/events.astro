---
import MemberLayout from '../../layouts/MemberLayout.astro';
import { requireActiveMembership } from '../../lib/server/membership';

await requireActiveMembership(Astro.locals);
---

<MemberLayout title="Events" activePath="/members/events">
    <section class="rounded-[28px] border border-dashed border-white/15 bg-white/5 p-8">
        <h2 class="text-2xl font-bold mb-4">Events and seminars</h2>
        <p class="text-white/70 leading-[1.8]">Member events will appear here once the editorial calendar is ready. The route is protected and live from day one.</p>
    </section>
</MemberLayout>
