---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceList from "../components/ServiceList.astro";
import ContactForm from "../components/ContactForm.astro";
import Hero from "../components/Hero.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t("meta.title")}>
    <!-- Hero Section -->
    <Hero
        id="inicio"
        backgroundImage="/assets/hero-bg.jpg"
        overlayOpacity={0.4}
        height="100vh"
    >
        <img
            src="/assets/logo-alfa-black-text.png"
            alt={t("home.hero.logo.alt")}
            class="section-logo"
            style="width: 250px; margin-bottom: 2rem;"
        />
        <img
            src="/assets/logo-alfa-wolf.png"
            alt={t("home.hero.bg.alt")}
            class="hero-logo"
            style="width: 500px; margin-bottom: 1rem;"
        />
        <h2 class="hero-subtitle">{t("hero.title")}</h2>
    </Hero>

    <!-- Value Props (Steps) -->
    <section class="steps-section">
        <div class="container">
            <div class="text-center fade-in" style="margin-bottom: 60px;">
                <h2 class="section-main-title">
                    {t("home.steps.title.main")}
                </h2>
                <h2 class="section-secondary-title text-primary">
                    {t("home.steps.title.secondary")}
                </h2>
                <p class="section-context">{t("home.steps.context")}</p>
            </div>

            <div class="steps-grid">
                <div class="step-item fade-in">
                    <div class="step-icon">
                        <img
                            src="/assets/lupa-AE0r2VjNOpI4LRQ7.png"
                            alt={t("home.steps.localizamos")}
                        />
                    </div>
                    <h3>{t("home.steps.localizamos")}</h3>
                </div>
                <div class="step-item fade-in">
                    <div class="step-icon">
                        <img
                            src="/assets/gestion-A3Q7anMajGcEW1Lx.png"
                            alt={t("home.steps.gestionamos")}
                        />
                    </div>
                    <h3>{t("home.steps.gestionamos")}</h3>
                </div>
                <div class="step-item fade-in">
                    <div class="step-icon">
                        <img
                            src="/assets/mrtillo-AR032ZKJrRh87JyG.png"
                            alt={t("home.steps.reformamos")}
                        />
                    </div>
                    <h3>{t("home.steps.reformamos")}</h3>
                </div>
                <div class="step-item fade-in">
                    <div class="step-icon">
                        <img
                            src="/assets/euros-YD0w8Okj99HLq6az.png"
                            alt={t("home.steps.rentabilizamos")}
                        />
                    </div>
                    <h3>{t("home.steps.rentabilizamos")}</h3>
                </div>
            </div>

            <div class="process-flow fade-in">
                <div class="flow-item">
                    <p>{t("home.steps.financiar")}</p>
                </div>

                <div class="arrow-triangle-down"></div>

                <div class="flow-item">
                    <p>{t("home.steps.inversion")}</p>
                </div>

                <div class="arrow-triangle-down"></div>

                <div class="flow-item">
                    <div class="flow-icon">
                        <img
                            src="/assets/casa-icon.png"
                            alt={t("home.steps.house.alt")}
                        />
                    </div>
                    <p>{t("home.steps.cobras")}</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Libertad Financiera Section -->
    <section class="libertad-section">
        <div class="container text-center">
            <h2 class="section-main-title">{t("home.libertad.title.main")}</h2>
            <h2 class="section-secondary-title text-primary">
                {t("home.libertad.title.secondary")}
            </h2>
            <img
                src="/assets/logo-alfa-wolf.png"
                alt={t("home.hero.logo.alt")}
                class="section-logo"
                style="height: 60px; filter: brightness(0) invert(1);"
            />
            <p class="rentability">
                {t("home.libertad.rentability")}
            </p>
            <p class="description">
                {t("home.libertad.description")}
            </p>
        </div>
    </section>

    <!-- Quote/Bedroom Section -->
    <section class="quote-section">
        <div class="container text-center fade-in">
            <img
                src="/assets/logo-alfa-black-text.png"
                alt={t("home.hero.logo.alt")}
                class="section-logo-small"
            />
            <p class="quote-text">
                {t("home.quote.text")}
            </p>
            <div class="bedroom-image">
                <img
                    src="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
                    alt="Bedroom"
                />
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section id="servicios" class="services-section">
        <div class="text-center services-header">
            <h2 class="section-secondary-title text-black">
                {t("home.services.title")}
            </h2>
        </div>

        <ServiceList />

        <div
            class="text-center"
            style="margin-top: 60px; padding-bottom: 80px; color: var(--color-text-dark);"
        >
            <p style="font-style: italic; margin-bottom: 20px;">
                {t("home.services.context")}
            </p>
            <a href="/contacto" class="btn-primary">{t("home.services.cta")}</a>
        </div>
    </section>

    <!-- Submarcas Section -->
    <section id="submarcas" class="submarcas-section fade-in">
        <div class="container">
            <div class="submarcas-grid">
                <a href="/flip-art" class="submarca-tag"
                    >{t("submarcas.flipArt")}</a
                >
                <a href="/lujo-rent" class="submarca-tag"
                    >{t("submarcas.lujoRent")}</a
                >
                <a
                    href="/seguros"
                    class="submarca-tag"
                    set:html={t("submarcas.seguros")}
                />
                <a href="/alfa-clean" class="submarca-tag"
                    >{t("submarcas.alfaClean")}</a
                >
                <a href="/rey-subastos" class="submarca-tag"
                    >{t("submarcas.reySubastos")}</a
                >
                <a href="/alfa-lab" class="submarca-tag"
                    >{t("submarcas.alfaLab")}</a
                >
            </div>
        </div>
    </section>

    <!-- Office and Contact Section -->
    <section id="contacto" class="office-section">
        <div class="container">
            <div class="office-grid">
                <div class="office-info fade-in">
                    <h2 class="section-main-title">{t("home.office.title")}</h2>
                    <p>{t("home.office.description")}</p>
                    <div class="contact-details">
                        <p>
                            {t("home.office.address.line1")}<br />{
                                t("home.office.address.line2")
                            }
                        </p>
                        <p>{t("home.office.address.city")}</p>
                    </div>
                </div>
                <div class="office-map fade-in">
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3144.136343513689!2d-1.131464323455642!3d37.98561730006764!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd6382101cc25555%3A0x6b8a8670868a867!2sC.%20Conde%20del%20Valle%20de%20San%20Juan%2C%201%2C%2030004%20Murcia!5e0!3m2!1sen!2ses!4v1700000000000!5m2!1sen!2ses"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>

            <div class="home-contact-section">
                <div class="office-grid">
                    <div class="fade-in">
                        <h2 class="section-main-title">
                            {t("home.contact.title")}
                        </h2>
                        <p>
                            {t("home.contact.description")}
                        </p>
                        <div class="contact-intro-logo">
                            <img
                                src="/assets/logo-alfa-wolf.png"
                                alt={t("home.hero.logo.alt")}
                            />
                        </div>
                    </div>
                    <div class="contact-form-home fade-in">
                        <ContactForm theme="light" />
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
