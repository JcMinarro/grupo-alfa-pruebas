---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceList from "../components/ServiceList.astro";
import ContactForm from "../components/ContactForm.astro";
import Hero from "../components/Hero.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t("meta.title")} bodyClass="home-page">
    <!-- Hero Section -->
    <Hero
        id="inicio"
        backgroundImage="/assets/hero-bg.jpg"
        overlayOpacity={0}
        height="100vh"
    >
        <img
            src="/assets/logo-alfa-black-text.png"
            alt={t("home.hero.logo.alt")}
            class="w-[180px] md:w-[250px] mb-8 mx-auto"
        />
        <img
            src="/assets/logo-alfa-wolf.png"
            alt={t("home.hero.bg.alt")}
            class="w-full max-w-[300px] md:max-w-[500px] mb-4 drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)] brightness-0 mx-auto"
        />
        <h2
            class="text-[1.2rem] md:text-[1.5rem] tracking-[3px] md:tracking-[5px] font-medium text-black uppercase"
        >
            {t("hero.title")}
        </h2>
    </Hero>

    <section class="bg-[#1d1e20] text-white py-20 border-t border-white/10">
        <div class="max-w-[1200px] mx-auto px-4 text-center fade-in">
            <p class="text-primary uppercase tracking-[4px] font-semibold mb-4">
                {t("home.club.eyebrow")}
            </p>
            <h2 class="text-[2.2rem] md:text-[3.5rem] font-bold uppercase leading-tight mb-6">
                {t("home.club.promo.title")}
            </h2>
            <p class="max-w-[760px] mx-auto text-white/80 text-[1rem] md:text-[1.1rem] leading-[1.8] mb-10">
                {t("home.club.promo.description")}
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a
                    href="/club"
                    class="bg-primary text-black px-10 py-[15px] rounded-full font-bold uppercase transition-all hover:scale-105 hover:bg-[#ffc400] inline-block"
                >{t("home.club.cta")}</a>
                <a
                    href="/contacto"
                    class="border border-white/30 text-white px-10 py-[15px] rounded-full font-bold uppercase transition-all hover:border-primary hover:text-primary inline-block"
                >{t("home.club.secondaryCta")}</a>
            </div>
        </div>
    </section>

    <!-- Value Props (Steps) -->
    <section class="py-24 bg-white text-dark">
        <div class="max-w-[1200px] mx-auto px-4">
            <div class="text-center fade-in mb-16">
                <h2
                    class="text-[2rem] md:text-[3rem] font-bold tracking-[2px] uppercase text-primary mb-3"
                >
                    {t("home.club.title")}
                </h2>
                <h2
                    class="text-[1.8rem] md:text-[2.2rem] font-light tracking-[2px] mb-1 text-dark"
                >
                    {t("home.steps.title.main")}
                </h2>
                <h2
                    class="text-[1.8rem] md:text-[2.2rem] font-bold text-primary tracking-[2px] mb-5"
                >
                    {t("home.steps.title.secondary")}
                </h2>
                <p class="text-[1rem] md:text-[1.1rem] text-[#666]">
                    {t("home.steps.context_01")}
                </p>
                <p class="text-[1rem] md:text-[1.1rem] text-[#666]">
                    {t("home.steps.context_02")}
                </p>
            </div>
        </div>
    </section>

    <!-- Libertad Financiera Section -->
    <section class="py-24 bg-white border-t border-[#f0f0f0] text-dark">
        <div class="max-w-[1200px] mx-auto px-4 text-center">
            <h2
                class="text-[1.8rem] md:text-[2.2rem] font-light tracking-[2px] mb-1 text-dark"
            >
                {t("home.libertad.title.main")}
            </h2>
            <h2
                class="text-[1.8rem] md:text-[2.2rem] font-bold text-primary tracking-[2px] mb-5"
            >
                {t("home.libertad.title.secondary")}
            </h2>
            <img
                src="/assets/logo-alfa-wolf.png"
                alt={t("home.hero.logo.alt")}
                class="block w-[120px] md:w-[150px] mx-auto my-10 brightness-0"
            />
            <p
                class="text-[1.2rem] md:text-[1.5rem] font-normal mb-5 text-dark"
            >
                {t("home.libertad.rentability")}
            </p>
            <p class="text-[#666] leading-[1.8] max-w-[600px] mx-auto mb-10">
                {t("home.libertad.description")}
            </p>
        </div>
    </section>

    <!-- Quote/Bedroom Section -->
    <section class="py-24 bg-white text-dark">
        <div class="max-w-[1200px] mx-auto px-4 text-center fade-in">
            <img
                src="/assets/logo-alfa-black-text.png"
                alt={t("home.hero.logo.alt")}
                class="block w-[150px] mx-auto mb-5"
            />
            <p
                class="text-[1.5rem] italic text-[#333] max-w-[800px] mx-auto mb-[60px] leading-[1.4]"
            >
                {t("home.quote.text")}
            </p>
            <p
                class="text-[1.5rem] italic text-[#333] max-w-[800px] mx-auto mb-[60px] leading-[1.4]"
            >
                {t("home.quote.text2")}
            </p>
            <button
                type="button"
                id="promo-video-trigger"
                class="group relative max-w-[1000px] mx-auto block w-full overflow-hidden rounded bg-black shadow-[0_20px_40px_rgba(0,0,0,0.1)] focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/70"
                aria-label="Reproducir vídeo promocional"
            >
                <img
                    src="/assets/video-promo-poster.jpg"
                    alt="Vista previa del vídeo promocional"
                    class="block w-full h-auto rounded shadow-[0_10px_30px_rgba(0,0,0,0.1)] transition duration-500 group-hover:scale-[1.03] group-focus-visible:scale-[1.03]"
                    loading="lazy"
                />
                <span
                    class="absolute inset-0 bg-gradient-to-t from-black/45 via-black/10 to-transparent transition duration-300 group-hover:from-black/55"
                    aria-hidden="true"></span>
                <span
                    class="absolute left-1/2 top-1/2 flex h-20 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-primary text-black shadow-[0_14px_35px_rgba(0,0,0,0.35)] transition duration-300 group-hover:scale-110 md:h-24 md:w-24"
                    aria-hidden="true"
                >
                    <span
                        class="ml-1 block h-0 w-0 border-y-[14px] border-l-[22px] border-y-transparent border-l-black md:border-y-[17px] md:border-l-[27px]"
                    ></span>
                </span>
            </button>
        </div>
    </section>

    <div
        id="promo-video-modal"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 px-4 py-8 opacity-0 transition-opacity duration-200 md:px-8"
        role="dialog"
        aria-modal="true"
        aria-label="Vídeo promocional"
    >
        <button
            type="button"
            id="promo-video-backdrop"
            class="absolute inset-0 cursor-default"
            aria-label="Cerrar vídeo"
        ></button>
        <div
            class="relative z-10 w-full max-w-[1100px] overflow-hidden rounded bg-black shadow-[0_30px_90px_rgba(0,0,0,0.7)]"
        >
            <button
                type="button"
                id="promo-video-close"
                class="absolute right-3 top-3 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-black/70 text-2xl leading-none text-white transition hover:bg-primary hover:text-black focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/70"
                aria-label="Cerrar vídeo"
            >
                ×
            </button>
            <video
                id="promo-video-player"
                class="block aspect-video w-full bg-black"
                controls
                preload="metadata"
                poster="/assets/video-promo-poster.jpg"
                playsinline
                webkit-playsinline
            >
                <source src="/assets/video-promo.mp4" type="video/mp4" />
            </video>
        </div>
    </div>

    <!-- Services Section -->
    <section id="servicios" class="p-0 bg-white text-dark">
        <div class="pt-20 pb-5 text-center">
            <h2
                class="text-[1.8rem] md:text-[2.2rem] font-bold text-primary tracking-[2px] mb-10 text-black"
            >
                {t("home.services.title")}
            </h2>
        </div>

        <ServiceList />
    </section>

    <!-- Office and Contact Section -->
    <section id="contacto" class="py-[100px] bg-white text-dark">
        <div class="max-w-[1200px] mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-20">
                <div class="fade-in">
                    <h2
                        class="text-[1.8rem] md:text-[2.2rem] font-light tracking-[2px] mb-1 text-dark"
                    >
                        {t("home.office.title")}
                    </h2>
                    <p>{t("home.office.description")}</p>
                    <div class="my-[30px] text-[1rem] text-[#555]">
                        <p class="mb-[15px]">
                            {t("home.office.address.line1")}<br />{
                                t("home.office.address.line2")
                            }
                        </p>
                        <p>{t("home.office.address.city")}</p>
                    </div>
                </div>
                <div class="fade-in">
                    <div
                        class="mt-10 rounded overflow-hidden h-[400px] w-full bg-[#eee]"
                    >
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3144.136343513689!2d-1.131464323455642!3d37.98561730006764!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd6382101cc25555%3A0x6b8a8670868a867!2sC.%20Conde%20del%20Valle%20de%20San%20Juan%2C%201%2C%2030004%20Murcia!5e0!3m2!1sen!2ses!4v1700000000000!5m2!1sen!2ses"
                            allowfullscreen=""
                            loading="lazy"
                            class="w-full h-full border-0"
                            referrerpolicy="no-referrer-when-downgrade"
                        ></iframe>
                    </div>
                </div>
            </div>

            <div class="mt-20 text-dark">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-20">
                    <div class="fade-in">
                        <h2
                            class="text-[1.8rem] md:text-[2.2rem] font-light tracking-[2px] mb-4 text-dark"
                        >
                            {t("home.contact.title")}
                        </h2>
                        <div class="mt-10 flex justify-center">
                            <img
                                src="/assets/logo-alfa-wolf.png"
                                alt={t("home.hero.logo.alt")}
                                class="w-[100px]"
                            />
                        </div>
                    </div>
                    <div class="fade-in">
                        <ContactForm
                            theme="light"
                            action="https://n8n.minarro.eu.org/webhook/contact-us"
                        />
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<script>
    const initPromoVideo = () => {
        const trigger = document.getElementById("promo-video-trigger");
        const modal = document.getElementById("promo-video-modal");
        const closeButton = document.getElementById("promo-video-close");
        const backdrop = document.getElementById("promo-video-backdrop");
        const video = document.getElementById("promo-video-player") as HTMLVideoElement | null;

        if (!trigger || !modal || !video) return;
        if (trigger.dataset.promoVideoInitialized === "true") return;

        trigger.dataset.promoVideoInitialized = "true";

        const openModal = () => {
            modal.classList.remove("hidden");
            modal.classList.add("flex");
            document.body.classList.add("overflow-hidden");

            requestAnimationFrame(() => {
                modal.classList.remove("opacity-0");
                closeButton?.focus();
                video.play().catch(() => undefined);

                if (window.matchMedia("(max-width: 767px)").matches) {
                    const mobileVideo = video as HTMLVideoElement & {
                        webkitEnterFullscreen?: () => void;
                    };

                    if (mobileVideo.requestFullscreen) {
                        mobileVideo.requestFullscreen().catch(() => undefined);
                    } else if (mobileVideo.webkitEnterFullscreen) {
                        mobileVideo.webkitEnterFullscreen();
                    }
                }
            });
        };

        const closeModal = () => {
            modal.classList.add("opacity-0");
            video.pause();
            video.currentTime = 0;
            document.body.classList.remove("overflow-hidden");

            window.setTimeout(() => {
                modal.classList.add("hidden");
                modal.classList.remove("flex");
                trigger.focus();
            }, 200);
        };

        trigger.addEventListener("click", openModal);
        closeButton?.addEventListener("click", closeModal);
        backdrop?.addEventListener("click", closeModal);
        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && !modal.classList.contains("hidden")) {
                closeModal();
            }
        });
    };

    document.addEventListener("DOMContentLoaded", initPromoVideo);
    document.addEventListener("astro:page-load", initPromoVideo);
</script>
