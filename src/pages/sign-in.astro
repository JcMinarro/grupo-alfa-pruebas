---
import { SignIn } from '@clerk/astro/components';
import BaseLayout from '../layouts/BaseLayout.astro';

if (Astro.locals.auth?.().isAuthenticated) {
    const redirectUrl = Astro.url.searchParams.get('redirect_url');
    return Astro.redirect(redirectUrl?.startsWith('/') ? redirectUrl : '/membership?payment_required=1');
}

const promo = Astro.url.searchParams.get('promo');
const ref = Astro.url.searchParams.get('ref');
const redirectParam = Astro.url.searchParams.get('redirect_url');
const checkoutParams = new URLSearchParams();
if (promo) checkoutParams.set('promo', promo);
if (ref) checkoutParams.set('ref', ref);
const fallbackRedirectUrl = redirectParam?.startsWith('/')
    ? redirectParam
    : `/api/checkout${checkoutParams.toString() ? `?${checkoutParams.toString()}` : ''}`;
---

<BaseLayout title="Acceso | Club Alfa" bodyClass="members-page auth-page bg-[#0f1012] text-white">
    <section class="auth-shell min-h-screen flex items-center justify-center px-4 py-28">
        <div class="auth-card w-full max-w-[600px] rounded-[34px] border border-white/10 bg-white/[0.06] p-5 shadow-[0_24px_90px_rgba(0,0,0,0.35)] md:p-8">
            <p class="text-primary uppercase tracking-[5px] text-sm font-bold mb-3">Club Alfa</p>
            <h1 class="text-[2.5rem] leading-[1.02] font-bold mb-4 md:text-5xl">Bienvenido de nuevo</h1>
            <p class="text-white/70 mb-6 text-lg leading-[1.65]">Accede para gestionar tu membresía, referidos y acceso privado.</p>
            <SignIn routing="hash" signUpUrl="/sign-up" fallbackRedirectUrl={fallbackRedirectUrl} />
        </div>
    </section>
</BaseLayout>
