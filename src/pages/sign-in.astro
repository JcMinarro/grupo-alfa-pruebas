---
import { SignIn } from '@clerk/astro/components';
import BaseLayout from '../layouts/BaseLayout.astro';

if (Astro.locals.auth?.().isAuthenticated) {
    return Astro.redirect('/join');
}
---

<BaseLayout title="Sign In | Club Alfa" bodyClass="members-page bg-[#0f1012] text-white">
    <section class="min-h-screen flex items-center justify-center px-4 py-28">
        <div class="auth-card w-full max-w-[520px] rounded-[28px] border border-white/10 bg-white/5 p-6 md:p-8 shadow-[0_20px_70px_rgba(0,0,0,0.25)]">
            <p class="text-primary uppercase tracking-[4px] text-sm font-bold mb-3">Club Alfa</p>
            <h1 class="text-4xl font-bold mb-4">Welcome back</h1>
            <p class="text-white/70 mb-6">Sign in to manage your membership, referrals, and private access.</p>
            <SignIn path="/sign-in" routing="path" signUpUrl="/sign-up" />
        </div>
    </section>
</BaseLayout>
