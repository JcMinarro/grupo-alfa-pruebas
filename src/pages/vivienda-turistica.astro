---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import ProjectLayout from "../layouts/ProjectLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectDetails from "../components/project/ProjectDetails.astro";
import ProjectFinancials from "../components/project/ProjectFinancials.astro";
import ProjectROI from "../components/project/ProjectROI.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ProjectLayout
    title={`Vivienda Turística | ${t("brand.name")}`}
    bodyClass="tourism-page"
>
    <Hero
        title={t("projects.tourism.title")}
        location="ÁGUILAS, MURCIA"
        backgroundImage="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
        height="50vh"
    />

    <section class="max-w-[1200px] mx-auto py-20 px-5 fade-in text-dark">
        <a
            href="/proyectos"
            class="inline-block mb-10 text-primary font-semibold hover:translate-x-[-5px] transition-transform"
            >← {t("projects.back")}</a
        >

        <h2 class="text-3xl font-bold mb-10 border-l-4 border-primary pl-5">
            {t("projects.details.title")}
        </h2>
        <ProjectDetails
            type={t("projects.tourism.details.type")}
            location={t("projects.tourism.details.location")}
            surface="85 m²"
            distribution={t("projects.tourism.details.distribution")}
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 my-10">
            <div class="image-item">
                <p class="font-bold mb-[10px]">
                    {t("projects.tourism.images.before")}
                </p>
                <img
                    src="/assets/photo-1616046229478-9901c5536a456111.jpg"
                    alt={t("projects.tourism.images.before")}
                    class="w-full rounded-lg"
                />
            </div>
            <div class="image-item">
                <p class="font-bold mb-[10px]">
                    {t("projects.tourism.images.after")}
                </p>
                <img
                    src="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
                    alt={t("projects.tourism.images.after")}
                    class="w-full rounded-lg"
                />
            </div>
        </div>

        <ProjectFinancials
            costs={[
                {
                    concept: t("projects.common.costs.compra"),
                    amount: "115.000 €",
                },
                {
                    concept: t("projects.tourism.costs.reforma"),
                    amount: "35.000 €",
                },
                {
                    concept: t("projects.tourism.costs.licencias"),
                    amount: "8.000 €",
                },
            ]}
            total="158.000 €"
        />

        <ProjectROI
            strategy="rent"
            rentData={{
                monthly: t("projects.tourism.roi.rent.monthly"),
                annual: t("projects.tourism.roi.rent.annual"),
                roi: "15,50 %",
            }}
        />

        <div
            class="bg-[var(--color-bg-dark)] text-white p-10 rounded-lg mt-15 text-center"
        >
            <h3 class="text-primary text-[1.5rem] mb-5 font-bold uppercase">
                {t("projects.executiveSummary")}
            </h3>
            <p
                class="text-[1.1rem] leading-relaxed max-w-[800px] mx-auto text-white"
            >
                {t("projects.tourism.summary")}
            </p>
        </div>

        <div class="text-center mt-15">
            <a
                href="/#contacto"
                class="bg-primary text-black px-10 py-[15px] rounded-full font-bold uppercase transition-all hover:scale-105 hover:bg-[#ffc400] inline-block shadow-lg"
                >{t("projects.interested")}</a
            >
        </div>
    </section>
</ProjectLayout>
