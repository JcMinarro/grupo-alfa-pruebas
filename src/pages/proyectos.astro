---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import ProjectLayout from "../layouts/ProjectLayout.astro";
import Hero from "../components/Hero.astro";
import { heros } from "../data/heros.js";

import ProjectGrid from "../components/ProjectGrid.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = [
    {
        title: t("projects.rooms.title"),
        location: "MADRID",
        beforeImage: "/assets/proyectos/vivienda-alquiler-habitaciones-before.jpeg",
        afterImage: "/assets/proyectos/vivienda-alquiler-habitaciones-after.jpeg",
        href: "/alquiler-por-habitaciones",
    },
    {
        title: t("projects.local.title"),
        location: "MURCIA",
        beforeImage: "/assets/proyectos/local-comercial-before.jpeg",
        afterImage: "/assets/proyectos/local-comercial-after.jpg",
        href: "/local-comercial",
    },
    {
        title: t("projects.studios.title"),
        location: "GRANADA",
        beforeImage: "/assets/proyectos/mal-distribuida-before.jpeg",
        afterImage: "/assets/proyectos/mal-distribuida-after.jpg",
        href: "/studios-granada",
    },
    {
        title: t("projects.tourism.title"),
        location: "ÁGUILAS, MURCIA",
        beforeImage: "/assets/proyectos/vivienda-turistica-before.jpeg",
        afterImage: "/assets/proyectos/vivienda-turistica-after.jpg",
        href: "/vivienda-turistica",
    },
    {
        title: t("projects.division.title"),
        location: "MURCIA",
        beforeImage: "/assets/proyectos/dividir-apartamento-before.jpeg",
        afterImage: "/assets/proyectos/dividir-apartamento-after.jpeg",
        href: "/piso-dividido",
    },
    {
        title: t("projects.chalet.title"),
        location: "ALICANTE",
        beforeImage: "/assets/proyectos/chalet-dividido-before.jpeg",
        afterImage: "/assets/proyectos/chalet-dividido-after.jpeg",
        href: "/chalet-dividido",
    },
    {
        title: t("projects.duplex.title"),
        location: "MURCIA",
        beforeImage: "/assets/proyectos/buhardilla-before.jpeg",
        afterImage: "/assets/proyectos/buhardilla-after.jpg",
        href: "/duplex-turistico",
    },
];
---

<ProjectLayout
    title={`Proyectos | ${t("brand.name")}`}
    bodyClass="portfolio-page bg-white text-dark"
    activeNav="proyectos"
>
    <Hero
        title={t("projects.hero.title")}
        subtitle={t("projects.hero.subtitle")}
        description={t("projects.hero.description")}
        backgroundImage="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
        backgroundVideo={heros.proyectos}
        videoPoster="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
        height="50vh"
    />

    <section class="max-w-[1200px] mx-auto pt-20 pb-10 px-5 text-center">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4">
            {t("projects.hero.subtitle")}
        </h2>
        <p class="text-gray-500 max-w-2xl mx-auto text-lg">
            {t("projects.hero.description")}
        </p>
    </section>

    <section class="max-w-[1200px] mx-auto pb-20 px-5">
        <ProjectGrid
            projects={projects}
            viewMoreText={t("projects.viewMore")}
            disabled={true}
        />
    </section>

    <section class="bg-[var(--component-bg)] py-20 text-center fade-in">
        <div class="max-w-[1200px] mx-auto px-5">
            <h2 class="text-3xl font-bold mb-8 text-black">
                {t("projects.cta.title")}
            </h2>
            <p class="mb-8 text-lg text-dark max-w-2xl mx-auto">
                {t("projects.cta.description")}
            </p>
            <a
                href="/#contacto"
                class="bg-primary text-black px-10 py-[15px] rounded-full font-bold uppercase transition-all hover:scale-105 hover:bg-[#ffc400] inline-block"
                >{t("projects.cta.button")}</a
            >
        </div>
    </section>
</ProjectLayout>
