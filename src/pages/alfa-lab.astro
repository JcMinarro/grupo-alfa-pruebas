---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
    title={`ALFA LAB | ${t("brand.name")}`}
    bodyClass="lab-page bg-[#1d1e20] text-white"
>
    <main class="max-w-[1200px] mx-auto py-20 px-5">
        <div class="flex gap-10 items-center justify-center mb-10 fade-in">
            <img
                src="/assets/logo-alfa-wolf.png"
                alt={t("brand.name")}
                class="h-[60px] brightness-0 invert"
            />
            <img
                src="/assets/logo-alfa-wolf.png"
                alt={t("brand.name")}
                class="h-10 brightness-0 invert opacity-50"
            />
        </div>

        <section
            class="max-w-[900px] mx-auto bg-[#2a2b2e] p-10 md:p-15 rounded-2xl shadow-2xl fade-in"
        >
            <h1
                class="text-4xl md:text-5xl font-bold mb-10 text-primary uppercase text-center"
            >
                {t("lab.title")}
            </h1>

            <div class="space-y-6 text-[#ccc] leading-relaxed text-lg">
                <p>
                    <strong class="text-white">{t("lab.p1.strong")}</strong>{
                        t("lab.p1.text")
                    }
                </p>
                <p>
                    {t("lab.p2.text1")}<strong class="text-white"
                        >{t("lab.p2.strong")}</strong
                    >{t("lab.p2.text2")}
                </p>
                <ul class="space-y-4 my-10">
                    <li class="flex gap-3">
                        <span class="text-primary font-bold">✓</span>
                        <span
                            ><strong class="text-white"
                                >{t("lab.feature1.strong")}</strong
                            >{t("lab.feature1.text")}</span
                        >
                    </li>
                    <li class="flex gap-3">
                        <span class="text-primary font-bold">✓</span>
                        <span
                            ><strong class="text-white"
                                >{t("lab.feature2.strong")}</strong
                            >{t("lab.feature2.text")}</span
                        >
                    </li>
                    <li class="flex gap-3">
                        <span class="text-primary font-bold">✓</span>
                        <span
                            ><strong class="text-white"
                                >{t("lab.feature3.strong")}</strong
                            >{t("lab.feature3.text")}</span
                        >
                    </li>
                    <li class="flex gap-3">
                        <span class="text-primary font-bold">✓</span>
                        <span
                            ><strong class="text-white"
                                >{t("lab.feature4.strong")}</strong
                            >{t("lab.feature4.text")}</span
                        >
                    </li>
                    <li class="flex gap-3">
                        <span class="text-primary font-bold">✓</span>
                        <span
                            ><strong class="text-white"
                                >{t("lab.feature5.strong")}</strong
                            >{t("lab.feature5.text")}</span
                        >
                    </li>
                    <li class="flex gap-3">
                        <span class="text-primary font-bold">✓</span>
                        <span
                            ><strong class="text-white"
                                >{t("lab.feature6.strong")}</strong
                            >{t("lab.feature6.text")}</span
                        >
                    </li>
                </ul>
                <p>
                    {t("lab.p3.text")}
                </p>
                <p>
                    {t("lab.p4.text")}
                </p>
            </div>

            <div class="mt-12 text-center">
                <a
                    href="/#servicios"
                    class="text-primary font-bold uppercase tracking-widest hover:opacity-80 transition-opacity"
                    >← {t("common.back").toUpperCase()}</a
                >
            </div>
        </section>
    </main>
</BaseLayout>
