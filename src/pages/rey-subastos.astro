---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
    title={`Rey SuBastos | ${t("brand.name")}`}
    bodyClass="rey-page"
    footerStyle="background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)), url('/assets/lab/lab-footer-bg.jpg') no-repeat center center/cover;"
>
    <section class="rey-hero fade-in">
        <h1>REY <span>SUBASTOS</span></h1>
        <p>
            {t("reysubastos.subtitle")}
        </p>
    </section>

    <section class="expertise-section fade-in">
        <div class="section-heading">
            <h2>{t("reysubastos.expertise.title")}</h2>
            <p>
                {t("reysubastos.expertise.desc")}
            </p>
        </div>

        <div class="process-grid">
            <div class="process-card">
                <div class="process-icon">📍</div>
                <h3>{t("reysubastos.process.step1.title")}</h3>
                <p>
                    {t("reysubastos.process.step1.desc")}
                </p>
            </div>
            <div class="process-card">
                <div class="process-icon">⚖️</div>
                <h3>{t("reysubastos.process.step2.title")}</h3>
                <p>
                    {t("reysubastos.process.step2.desc")}
                </p>
            </div>
            <div class="process-card">
                <div class="process-icon">🤝</div>
                <h3>{t("reysubastos.process.step3.title")}</h3>
                <p>
                    {t("reysubastos.process.step3.desc")}
                </p>
            </div>
            <div class="process-card">
                <div class="process-icon">🔑</div>
                <h3>{t("reysubastos.process.step4.title")}</h3>
                <p>
                    {t("reysubastos.process.step4.desc")}
                </p>
            </div>
        </div>
    </section>

    <section class="security-banner fade-in">
        <div class="security-content">
            <h2>{t("reysubastos.security.title")}</h2>
            <p>
                {t("reysubastos.security.desc")}
            </p>
        </div>
        <a href="/#contacto" class="btn-rey"
            >{t("reysubastos.security.button")}</a
        >
    </section>
</BaseLayout>
