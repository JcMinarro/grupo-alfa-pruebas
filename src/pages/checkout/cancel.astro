---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Checkout Cancelled | Club Alfa" bodyClass="members-page bg-[#0f1012] text-white">
    <section class="min-h-screen flex items-center justify-center px-4 py-28">
        <div class="max-w-[760px] rounded-[30px] border border-white/10 bg-white/5 p-8 md:p-10 text-center">
            <p class="text-primary uppercase tracking-[4px] text-sm font-bold mb-3">Club Alfa</p>
            <h1 class="text-[2.8rem] font-bold mb-4">Checkout cancelled</h1>
            <p class="text-white/70 text-lg leading-[1.8] mb-8">No membership has been activated. You can review your annual plan and restart the secure checkout whenever you want.</p>
            <a href="/join" class="rounded-full bg-primary px-8 py-3 text-sm font-bold uppercase tracking-[2px] text-black">Return to join</a>
        </div>
    </section>
</BaseLayout>
