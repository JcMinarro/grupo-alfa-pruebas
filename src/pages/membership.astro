---
import BaseLayout from '../layouts/BaseLayout.astro';
import { previewDiscountCode } from '../lib/server/billing';
import { ACTIVE_MEMBERSHIP_STATUSES, getCurrentMembershipUser, isTransientProviderError } from '../lib/server/membership';

const ref = Astro.url.searchParams.get('ref');
const promo = Astro.url.searchParams.get('promo');
const code = ref ?? promo ?? '';
const paymentRequired = Astro.url.searchParams.get('payment_required') === '1';
const accessCheckPending = Astro.url.searchParams.get('access_check') === 'pending';
const authState = Astro.locals.auth?.();
let membershipLookupPending = accessCheckPending;
let currentUser = null;

if (authState?.isAuthenticated) {
    try {
        currentUser = await getCurrentMembershipUser(Astro.locals);
    } catch (error) {
        membershipLookupPending = isTransientProviderError(error);
        if (!membershipLookupPending) {
            throw error;
        }
    }
}
const isActivePaidMember = ACTIVE_MEMBERSHIP_STATUSES.includes(currentUser?.publicMetadata?.membershipStatus);
let discountPreview = null;

if (code) {
    try {
        discountPreview = await previewDiscountCode(code);
    } catch (_error) {
        discountPreview = null;
    }
}

const signUpParams = new URLSearchParams();
if (ref) signUpParams.set('ref', ref);
if (promo) signUpParams.set('promo', promo);
if (code) signUpParams.set('reviewed', '1');
const signUpHref = `/sign-up${signUpParams.toString() ? `?${signUpParams.toString()}` : ''}`;

const benefits = [
    'Seminarios mensuales sobre inversión, banca, libertad financiera e inmuebles.',
    'Acceso preferente a oportunidades y operaciones reservadas dentro de Grupo Alfa.',
    'Acompañamiento para invertir con criterio y moverte con más seguridad.',
    'Ventajas exclusivas, reducción de costes de intermediación y acuerdos internos.',
];
---

<BaseLayout title="Membresía | Club Alfa" bodyClass="members-page bg-[#0f1012] text-white">
    <section class="pt-32 pb-20 px-4">
        <div class="mx-auto grid max-w-[1100px] gap-8 lg:grid-cols-[1.05fr_0.95fr]">
            <div class="rounded-[34px] border border-white/10 bg-white/[0.06] p-8 shadow-[0_24px_90px_rgba(0,0,0,0.35)] md:p-10">
                <p class="text-primary uppercase tracking-[5px] text-sm font-bold mb-4">Club Alfa</p>
                <h1 class="text-[3rem] leading-[1] font-bold mb-6 md:text-[4.5rem]">Membresía anual Club Alfa</h1>
                <p class="text-white/70 text-lg leading-[1.8] mb-8">Revisa todo lo que incluye tu entrada a la manada. El pago de la membresía empieza después de crear la cuenta, para que tu acceso quede preparado desde el primer momento.</p>
                {paymentRequired && !isActivePaidMember && !membershipLookupPending && (
                    <div class="mb-8 rounded-2xl border border-primary/40 bg-primary/10 px-5 py-4 text-primary">
                        Tu membresía todavía no está pagada o ya no está activa. Continúa abajo para completar el pago.
                    </div>
                )}
                {membershipLookupPending && !isActivePaidMember && (
                    <div class="mb-8 rounded-2xl border border-sky-300/40 bg-sky-300/10 px-5 py-4 text-sky-100">
                        Estamos verificando tu membresía. Si acabas de pagar, espera unos segundos y vuelve a intentar entrar al área privada.
                    </div>
                )}
                {isActivePaidMember && (
                    <div class="mb-8 rounded-2xl border border-emerald-400/40 bg-emerald-400/10 px-5 py-4 text-emerald-200">
                        Tu membresía ya está activa. Puedes acceder directamente al área privada de miembros.
                    </div>
                )}
                <ul class="grid gap-4 text-white/75 md:grid-cols-2">
                    {benefits.map((benefit) => (
                        <li class="rounded-2xl border border-white/10 bg-black/20 p-5 leading-[1.65]">{benefit}</li>
                    ))}
                </ul>
            </div>

            <aside class="rounded-[34px] border border-primary/25 bg-[#171411] p-8 shadow-[0_24px_90px_rgba(0,0,0,0.35)] md:p-10">
                <p class="text-white/60 uppercase tracking-[4px] text-xs mb-3">Plan de pago</p>
                <h2 class="text-3xl font-bold mb-5">Club Alfa Anual</h2>
                {discountPreview?.hasPricePreview && (
                    <p data-discount-badge class="mb-5 inline-flex rounded-full border border-primary/40 bg-primary px-4 py-2 text-xs font-bold uppercase tracking-[2px] text-black">Oferta aplicada</p>
                )}
                <div class="mb-6 flex flex-wrap items-end gap-3">
                    <span data-original-price class={`font-bold ${discountPreview?.hasPricePreview ? 'text-3xl line-through text-white/45' : 'text-5xl'}`}>99 EUR</span>
                    {discountPreview?.hasPricePreview && (
                        <span data-discounted-price class="text-6xl font-bold text-primary md:text-7xl">{discountPreview.finalPrice}</span>
                    )}
                    <span class="mb-1 text-white/60">/ año</span>
                </div>
                {discountPreview?.hasPricePreview && (
                    <p class="mb-6 rounded-2xl border border-primary/30 bg-primary/10 px-4 py-3 text-primary">Tu enlace tiene un descuento activo: {discountPreview.discountLabel}. Se aplicará automáticamente al continuar.</p>
                )}
                {code && !discountPreview?.hasPricePreview && (
                    <p class="mb-6 rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white/70">Comprobaremos tu enlace de acceso antes del pago. Si tiene una oferta activa, se aplicará automáticamente.</p>
                )}
                {isActivePaidMember ? (
                    <>
                        <p class="mb-8 text-white/70 leading-[1.8]">Tu pago ya está confirmado. Desde aquí puedes entrar al área privada para consultar tus ventajas y gestionar tu membresía.</p>
                        <a href="/members/benefits" class="block rounded-full bg-primary px-8 py-4 text-center text-sm font-bold uppercase tracking-[2px] text-black transition-transform hover:scale-[1.01] hover:bg-[#ffc400]">Ir al área de miembros</a>
                        <p class="mt-5 text-xs leading-[1.7] text-white/50">Si necesitas gestionar facturación o cancelación, entra en el área privada y abre la sección de membresía.</p>
                    </>
                ) : membershipLookupPending ? (
                    <>
                        <p class="mb-8 text-white/70 leading-[1.8]">No hemos podido confirmar el estado exacto de tu membresía porque uno de los proveedores externos ha limitado o retrasado la respuesta.</p>
                        <a href="/members/benefits" class="block rounded-full bg-primary px-8 py-4 text-center text-sm font-bold uppercase tracking-[2px] text-black transition-transform hover:scale-[1.01] hover:bg-[#ffc400]">Reintentar acceso al área de miembros</a>
                        <p class="mt-5 text-xs leading-[1.7] text-white/50">Si el pago ya está confirmado, el acceso debería activarse en cuanto termine la sincronización.</p>
                    </>
                ) : (
                    <>
                        <p class="mb-8 text-white/70 leading-[1.8]">Crea primero tu cuenta. Justo después del registro irás al pago seguro para activar tu membresía anual.</p>
                        <a href={signUpHref} class="block rounded-full bg-primary px-8 py-4 text-center text-sm font-bold uppercase tracking-[2px] text-black transition-transform hover:scale-[1.01] hover:bg-[#ffc400]">Crear cuenta</a>
                        <p class="mt-5 text-xs leading-[1.7] text-white/50">Tu acceso privado se activa solo cuando el pago queda confirmado. Si cancelas o el pago falla, podrás volver a intentarlo.</p>
                    </>
                )}
            </aside>
        </div>
    </section>
</BaseLayout>
