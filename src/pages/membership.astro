---
import BaseLayout from '../layouts/BaseLayout.astro';
import { previewDiscountCode } from '../lib/server/billing';

const ref = Astro.url.searchParams.get('ref');
const promo = Astro.url.searchParams.get('promo');
const code = ref ?? promo ?? '';
const paymentRequired = Astro.url.searchParams.get('payment_required') === '1';
let discountPreview = null;

if (code) {
    try {
        discountPreview = await previewDiscountCode(code);
    } catch (_error) {
        discountPreview = null;
    }
}

const signUpParams = new URLSearchParams();
if (ref) signUpParams.set('ref', ref);
if (promo) signUpParams.set('promo', promo);
if (code) signUpParams.set('reviewed', '1');
const signUpHref = `/sign-up${signUpParams.toString() ? `?${signUpParams.toString()}` : ''}`;
---

<BaseLayout title="Membresía | Club Alfa" bodyClass="members-page bg-[#0f1012] text-white">
    <section class="pt-32 pb-20 px-4">
        <div class="mx-auto grid max-w-[1100px] gap-8 lg:grid-cols-[1.05fr_0.95fr]">
            <div class="rounded-[34px] border border-white/10 bg-white/[0.06] p-8 shadow-[0_24px_90px_rgba(0,0,0,0.35)] md:p-10">
                <p class="text-primary uppercase tracking-[5px] text-sm font-bold mb-4">Club Alfa</p>
                <h1 class="text-[3rem] leading-[1] font-bold mb-6 md:text-[4.5rem]">Membresía anual antes del pago</h1>
                <p class="text-white/70 text-lg leading-[1.8] mb-8">Revisa la membresía antes de crear tu cuenta. El pago de la membresía empieza después de crear la cuenta, así tu pago queda vinculado a tu identidad de Club Alfa.</p>
                {paymentRequired && (
                    <div class="mb-8 rounded-2xl border border-primary/40 bg-primary/10 px-5 py-4 text-primary">
                        Tu membresía todavía no está pagada o ya no está activa. Continúa abajo para completar el pago.
                    </div>
                )}
                <ul class="grid gap-4 text-white/75 md:grid-cols-2">
                    <li class="rounded-2xl border border-white/10 bg-black/20 p-5">Área privada de miembros tras confirmar el pago.</li>
                    <li class="rounded-2xl border border-white/10 bg-black/20 p-5">Facturación anual gestionada de forma segura por Stripe.</li>
                    <li class="rounded-2xl border border-white/10 bg-black/20 p-5">Estado de membresía confirmado por webhooks de Stripe.</li>
                    <li class="rounded-2xl border border-white/10 bg-black/20 p-5">Descuentos de campaña aplicados desde tu enlace de acceso.</li>
                </ul>
            </div>

            <aside class="rounded-[34px] border border-primary/25 bg-[#171411] p-8 shadow-[0_24px_90px_rgba(0,0,0,0.35)] md:p-10">
                <p class="text-white/60 uppercase tracking-[4px] text-xs mb-3">Plan de pago</p>
                <h2 class="text-3xl font-bold mb-5">Club Alfa Anual</h2>
                <div class="mb-6 flex flex-wrap items-end gap-3">
                    <span data-original-price class={`text-5xl font-bold ${discountPreview?.hasPricePreview ? 'line-through text-white/45' : ''}`}>99 EUR</span>
                    {discountPreview?.hasPricePreview && (
                        <span data-discounted-price class="text-5xl font-bold text-primary">{discountPreview.finalPrice}</span>
                    )}
                    <span class="mb-1 text-white/60">/ año</span>
                </div>
                {discountPreview?.hasPricePreview && (
                    <p class="mb-6 rounded-2xl border border-primary/30 bg-primary/10 px-4 py-3 text-primary">Descuento de tu enlace aplicado: {discountPreview.discountLabel}. Enviaremos el mismo descuento a Stripe Checkout.</p>
                )}
                {code && !discountPreview?.hasPricePreview && (
                    <p class="mb-6 rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white/70">Comprobaremos tu enlace de acceso de nuevo antes del pago. Si es válido, Stripe aplicará el descuento configurado.</p>
                )}
                <p class="mb-8 text-white/70 leading-[1.8]">Crea primero tu cuenta. Justo después del registro abriremos el pago seguro de Stripe para la membresía anual.</p>
                <a href={signUpHref} class="block rounded-full bg-primary px-8 py-4 text-center text-sm font-bold uppercase tracking-[2px] text-black transition-transform hover:scale-[1.01] hover:bg-[#ffc400]">Crear cuenta y continuar al pago</a>
                <p class="mt-5 text-xs leading-[1.7] text-white/50">La membresía de pago empieza solo cuando Stripe confirma el pago. Los pagos cancelados o fallidos no desbloquean el contenido privado.</p>
            </aside>
        </div>
    </section>
</BaseLayout>
