---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import { heros } from "../data/heros.js";
import InfoGrid from "../components/InfoGrid.astro";
import GridItem from "../components/GridItem.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
    title={`ALFA HUNTERS | ${t("brand.name")}`}
    bodyClass="hunters-page bg-white text-dark"
    activeNav="hunters"
>
    <Hero
        title="ALFA HUNTERS"
        backgroundImage="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
        backgroundVideo={heros['alfa-hunters'] || heros.alfaHunters}
        videoPoster="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
        height="50vh"
        overlayOpacity={0.4}
    />
    <section
        class="max-w-[1200px] mt-10 md:mt-20 mx-auto py-12 md:py-25 px-5 text-center fade-in text-dark"
    >
        <h2 class="text-3xl md:text-4xl font-bold mb-8 md:mb-15 leading-tight">
            {t("hunters.team.title.prefix")}
            <span class="text-primary">{t("hunters.team.title.team")}</span>
            {t("hunters.team.title.of")}
            <br /><span class="text-primary"
                >{t("hunters.team.title.hunters")}</span
            >
        </h2>
        <InfoGrid class="mt-10 md:mt-20" columns={3}>
            <GridItem
                title={t("hunters.benefits.flexibility.title")}
                description={t("hunters.benefits.flexibility.desc")}
            />
            <GridItem
                title={t("hunters.benefits.success.title")}
                description={t("hunters.benefits.success.desc")}
            />
            <GridItem
                title={t("hunters.benefits.commissions.title")}
                description={t("hunters.benefits.commissions.desc")}
            />
        </InfoGrid>
    </section>

    <!-- detailed Benefits Section -->
    <section class="max-w-[1200px] mx-auto py-20 px-5 text-dark">
        <h2 class="text-3xl font-bold text-center mb-12 fade-in">
            {t("hunters.cta.title")}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <div
                class="bg-white p-8 border-l-4 border-primary shadow-[0_5px_20px_rgba(0,0,0,0.05)] fade-in"
            >
                <h3 class="text-xl font-bold mb-4">
                    {t("hunters.cta.work.title")}
                </h3>
                <p class="text-[#444] leading-relaxed">
                    {t("hunters.cta.work.desc")}
                </p>
            </div>
            <div
                class="bg-white p-8 border-l-4 border-primary shadow-[0_5px_20px_rgba(0,0,0,0.05)] fade-in"
            >
                <h3 class="text-xl font-bold mb-4">
                    {t("hunters.cta.training.title")}
                </h3>
                <p class="text-[#444] leading-relaxed">
                    {t("hunters.cta.training.desc")}
                </p>
            </div>
            <div
                class="bg-white p-8 border-l-4 border-primary shadow-[0_5px_20px_rgba(0,0,0,0.05)] fade-in"
            >
                <h3 class="text-xl font-bold mb-4">
                    {t("hunters.cta.hours.title")}
                </h3>
                <p class="text-[#444] leading-relaxed">
                    {t("hunters.cta.hours.desc")}
                </p>
            </div>
            <div
                class="bg-white p-8 border-l-4 border-primary shadow-[0_5px_20px_rgba(0,0,0,0.05)] fade-in"
            >
                <h3 class="text-xl font-bold mb-4">
                    {t("hunters.cta.growth.title")}
                </h3>
                <p class="text-[#444] leading-relaxed">
                    {t("hunters.cta.growth.desc")}
                </p>
            </div>
        </div>
    </section>

    <!-- Form Section -->
    <section class="bg-[#f8f8f8] py-20 text-dark">
        <div class="max-w-[1200px] mx-auto px-5">
            <div
                class="max-w-[600px] mx-auto bg-white p-10 shadow-[0_10px_40px_rgba(0,0,0,0.05)] rounded-lg fade-in"
            >
                <h2 class="text-2xl font-bold text-center mb-5">
                    {t("hunters.form.title")}
                </h2>
                <p class="text-center text-[#666] mb-8">
                    {t("hunters.form.subtitle")}
                </p>
                <form
                    action="https://n8n.minarro.eu.org/webhook/alfa-hunter"
                    method="POST"
                    class="flex flex-col gap-5"
                    id="hunters-form"
                >
                    <div class="flex flex-col gap-2">
                        <label
                            for="name"
                            class="font-bold text-sm uppercase tracking-wide"
                            >{t("hunters.form.name")}</label
                        >
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder={t("hunters.form.name")}
                            class="p-[15px] border border-[#ddd] focus:outline-none focus:border-primary"
                            required
                        />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label
                            for="phone"
                            class="font-bold text-sm uppercase tracking-wide"
                            >{t("hunters.form.phone")}</label
                        >
                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            placeholder={t("hunters.form.phone")}
                            class="p-[15px] border border-[#ddd] focus:outline-none focus:border-primary"
                            required
                        />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label
                            for="email"
                            class="font-bold text-sm uppercase tracking-wide"
                            >{t("hunters.form.email")}</label
                        >
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder={t("contact.form.email.placeholder")}
                            class="p-[15px] border border-[#ddd] focus:outline-none focus:border-primary"
                            required
                        />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label
                            for="location"
                            class="font-bold text-sm uppercase tracking-wide"
                            >{t("hunters.form.location")}</label
                        >
                        <input
                            type="text"
                            id="location"
                            name="location"
                            placeholder={t("hunters.form.location.placeholder")}
                            class="p-[15px] border border-[#ddd] focus:outline-none focus:border-primary"
                            required
                        />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label class="font-bold text-sm uppercase tracking-wide"
                            >{t("hunters.form.experience.label")}</label
                        >
                        <div class="flex gap-5 flex-wrap mt-2.5">
                            <label
                                class="font-normal flex items-center gap-2 cursor-pointer"
                                ><input
                                    type="radio"
                                    name="experience"
                                    value="2+"
                                />
                                {t("hunters.form.experience.more2")}</label
                            >
                            <label
                                class="font-normal flex items-center gap-2 cursor-pointer"
                                ><input
                                    type="radio"
                                    name="experience"
                                    value="<2"
                                />
                                {t("hunters.form.experience.less2")}</label
                            >
                            <label
                                class="font-normal flex items-center gap-2 cursor-pointer"
                                ><input
                                    type="radio"
                                    name="experience"
                                    value="none"
                                />
                                {t("hunters.form.experience.none")}</label
                            >
                        </div>
                    </div>
                    <button
                        type="submit"
                        class="w-full bg-primary text-black py-4 rounded font-bold uppercase cursor-pointer transition-all hover:bg-[#ffc400] mt-5"
                        >{t("contact.form.submit")}</button
                    >
                </form>
                <p class="text-[0.8rem] mt-5 text-[#666] text-center">
                    {t("hunters.form.privacy")}
                </p>
            </div>
        </div>
    </section>

    <!-- Custom Modal -->
    <div
        id="modal"
        class="fixed inset-0 z-50 hidden opacity-0 transition-opacity duration-300"
        aria-labelledby="modal-title"
        role="dialog"
        aria-modal="true"
    >
        <div
            class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity"
            id="modal-backdrop"
        >
        </div>
        <div
            class="flex min-h-full items-center justify-center p-4 text-center sm:p-0"
        >
            <div
                class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-md p-8"
            >
                <div
                    class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-green-100 mb-6"
                    id="modal-icon-bg"
                >
                    <svg
                        class="h-8 w-8 text-green-600"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        aria-hidden="true"
                        id="modal-icon-success"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4.5 12.75l6 6 9-13.5"></path>
                    </svg>
                    <svg
                        class="h-8 w-8 text-red-600 hidden"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        aria-hidden="true"
                        id="modal-icon-error"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"
                        ></path>
                    </svg>
                </div>
                <div class="text-center">
                    <h3
                        class="text-2xl font-bold leading-6 text-gray-900 mb-2"
                        id="modal-title"
                    >
                        ¡Éxito!
                    </h3>
                    <div class="mt-2 text-center">
                        <p class="text-md text-gray-500" id="modal-message">
                            Hemos recibido tu solicitud correctamente.
                        </p>
                    </div>
                </div>
                <div class="mt-8">
                    <button
                        type="button"
                        class="inline-flex w-full justify-center rounded-md bg-primary px-3 py-3 text-sm font-bold uppercase text-black shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-[#ffc400] transition-all"
                        id="modal-close-btn"
                    >
                        Entendido
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("astro:page-load", () => {
            const form = document.getElementById("hunters-form");
            const modal = document.getElementById("modal");
            const modalBackdrop = document.getElementById("modal-backdrop");
            const modalCloseBtn = document.getElementById("modal-close-btn");
            const modalTitle = document.getElementById("modal-title");
            const modalMessage = document.getElementById("modal-message");
            const modalIconSuccess =
                document.getElementById("modal-icon-success");
            const modalIconError = document.getElementById("modal-icon-error");
            const modalIconBg = document.getElementById("modal-icon-bg");

            const showModal = (isSuccess, title, message) => {
                if (!modal) return;

                // Content
                if (modalTitle) modalTitle.textContent = title;
                if (modalMessage) modalMessage.textContent = message;

                // Icons
                if (isSuccess) {
                    modalIconSuccess?.classList.remove("hidden");
                    modalIconError?.classList.add("hidden");
                    modalIconBg?.classList.remove("bg-red-100");
                    modalIconBg?.classList.add("bg-green-100");
                } else {
                    modalIconSuccess?.classList.add("hidden");
                    modalIconError?.classList.remove("hidden");
                    modalIconBg?.classList.remove("bg-green-100");
                    modalIconBg?.classList.add("bg-red-100");
                }

                // Show
                modal.classList.remove("hidden");
                // Small delay to allow reflow for transition
                setTimeout(() => {
                    modal.classList.remove("opacity-0");
                }, 10);
            };

            const closeModal = () => {
                if (!modal) return;
                modal.classList.add("opacity-0");
                setTimeout(() => {
                    modal.classList.add("hidden");
                }, 300); // match duration-300
            };

            modalCloseBtn?.addEventListener("click", closeModal);
            modalBackdrop?.addEventListener("click", closeModal);

            if (form) {
                form.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    const submitBtn = form.querySelector(
                        'button[type="submit"]',
                    );
                    const originalText = submitBtn.innerText;

                    try {
                        submitBtn.disabled = true;
                        submitBtn.innerText = "Enviando...";

                        const formData = new FormData(form);
                        const data = Object.fromEntries(formData.entries());

                        const response = await fetch(form.action, {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                            },
                            body: JSON.stringify(data),
                        });

                        if (response.ok) {
                            showModal(
                                true,
                                "¡Recibido!",
                                "Gracias por tu solicitud. Nos pondremos en contacto contigo pronto.",
                            );
                            form.reset();
                        } else {
                            throw new Error("Error en el envío");
                        }
                    } catch (error) {
                        console.error("Error submitting form:", error);
                        showModal(
                            false,
                            "Vaya...",
                            "Hubo un error al enviar la solicitud. Por favor, inténtelo de nuevo más tarde.",
                        );
                    } finally {
                        submitBtn.disabled = false;
                        submitBtn.innerText = originalText;
                    }
                });
            }
        });
    </script>
</BaseLayout>
