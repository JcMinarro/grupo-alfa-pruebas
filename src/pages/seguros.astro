---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={`Seguros | ${t("brand.name")}`} bodyClass="seguros-page">
    <style slot="head">
        body {
            font-family: "DM Sans", sans-serif;
            background-color: #000;
        }

        .site-header {
            background-color: #fff;
        }
    </style>

    <main class="seguros-main">
        <div class="container">
            <div class="seguros-grid fade-in">
                <!-- Left Column -->
                <div class="seguros-col-left">
                    <div class="seguros-logo-wrapper">
                        <img
                            src="/assets/logo-alfa-wolf.png"
                            alt={t("brand.name")}
                            class="seguros-logo-desktop"
                            style="filter: brightness(0) invert(1);"
                        />
                        <img
                            src="/assets/logo-alfa-wolf.png"
                            alt={t("brand.name")}
                            class="seguros-logo-mobile"
                            style="filter: brightness(0) invert(1);"
                        />
                    </div>

                    <div class="seguros-image-1">
                        <img
                            src="/assets/6-xagwOQuvpmdAZmfW.png"
                            alt={t("seguros.family.alt")}
                        />
                    </div>
                </div>

                <!-- Right Column -->
                <div class="seguros-col-right">
                    <div class="seguros-image-2">
                        <img
                            src="/assets/7-ucrml6fvi2VS6Vcd.png"
                            alt={t("seguros.protection.alt")}
                        />
                    </div>

                    <div class="seguros-image-3">
                        <img
                            src="/assets/8-2TH51lWR8ULK9DcB.png"
                            alt={t("seguros.home.alt")}
                        />
                    </div>
                </div>
            </div>

            <!-- Back Button -->
            <div class="seguros-back-container fade-in">
                <a href="/#submarcas" class="seguros-btn-back"
                    >{t("common.back")}</a
                >
            </div>
        </div>
    </main>
</BaseLayout>
