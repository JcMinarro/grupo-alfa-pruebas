---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
    title={`Seguros | ${t("brand.name")}`}
    bodyClass="seguros-page bg-black text-white"
>
    <main class="py-20">
        <div class="max-w-[1200px] mx-auto px-5">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-10 fade-in">
                <!-- Left Column -->
                <div class="md:col-span-6 flex flex-col gap-10">
                    <div class="flex items-center">
                        <img
                            src="/assets/logo-alfa-wolf.png"
                            alt={t("brand.name")}
                            class="h-16 brightness-0 invert"
                        />
                    </div>

                    <div
                        class="rounded-2xl overflow-hidden border border-[rgba(255,255,255,0.1)] shadow-2xl"
                    >
                        <img
                            src="/assets/6-xagwOQuvpmdAZmfW.png"
                            alt={t("seguros.family.alt")}
                            class="w-full h-full object-cover"
                        />
                    </div>
                </div>

                <!-- Right Column -->
                <div class="md:col-span-6 flex flex-col gap-10">
                    <div
                        class="rounded-2xl overflow-hidden border border-[rgba(255,255,255,0.1)] shadow-2xl"
                    >
                        <img
                            src="/assets/7-ucrml6fvi2VS6Vcd.png"
                            alt={t("seguros.protection.alt")}
                            class="w-full h-full object-cover"
                        />
                    </div>

                    <div
                        class="rounded-2xl overflow-hidden border border-[rgba(255,255,255,0.1)] shadow-2xl"
                    >
                        <img
                            src="/assets/8-2TH51lWR8ULK9DcB.png"
                            alt={t("seguros.home.alt")}
                            class="w-full h-full object-cover"
                        />
                    </div>
                </div>
            </div>

            <!-- Back Button -->
            <div class="mt-20 text-center fade-in">
                <a
                    href="/#submarcas"
                    class="bg-primary text-black px-10 py-[15px] rounded-full font-bold uppercase transition-all hover:scale-105 hover:bg-[#ffc400] inline-block"
                    >{t("common.back")}</a
                >
            </div>
        </div>
    </main>
</BaseLayout>
