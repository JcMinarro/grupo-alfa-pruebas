---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import ProjectLayout from "../layouts/ProjectLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectDetails from "../components/project/ProjectDetails.astro";
import ProjectFinancials from "../components/project/ProjectFinancials.astro";
import ProjectROI from "../components/project/ProjectROI.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ProjectLayout
    title={`Chalet Dividido | ${t("brand.name")}`}
    bodyClass="chalet-page"
>
    <Hero
        title={t("projects.chalet.title")}
        location="ALICANTE"
        backgroundImage="/assets/whatsapp-image-2025-08-01-at-17.09.17-dWxOKaxe5VIGjv0Y.jpg"
        height="50vh"
    />

    <section class="max-w-[1200px] mx-auto py-20 px-5 fade-in text-dark">
        <a
            href="/proyectos"
            class="inline-block mb-10 text-primary font-semibold hover:translate-x-[-5px] transition-transform"
            >← {t("projects.back")}</a
        >

        <h2 class="text-3xl font-bold mb-10 border-l-4 border-primary pl-5">
            {t("projects.details.title")}
        </h2>
        <ProjectDetails
            type={t("projects.common.details.type")}
            location={t("projects.chalet.details.location")}
            surface="140 m²"
            distribution={t("projects.chalet.details.distribution")}
        />

        <ProjectFinancials
            costs={[
                {
                    concept: t("projects.common.costs.compra"),
                    amount: "140.000 €",
                },
                {
                    concept: t("projects.common.costs.reforma"),
                    amount: "55.000 €",
                },
                {
                    concept: t("projects.common.costs.licencias"),
                    amount: "15.000 €",
                },
                {
                    concept: t("projects.common.costs.muebles"),
                    amount: "10.000 €",
                },
                {
                    concept: t("projects.chalet.costs.imprevistos"),
                    amount: "10.000 €",
                },
            ]}
            total="230.000 €"
        />

        <ProjectROI
            strategy="both"
            saleData={{
                price: "155.000 € (x unidad)",
                profit: "80.000 € (neto est.)",
                roi: "34,78 %",
            }}
            rentData={{
                monthly: "850 € (x unidad)",
                annual: "20.400 €",
                roi: "7,98 %",
            }}
        />

        <div
            class="bg-[var(--color-bg-dark)] text-white p-10 rounded-lg mt-15 text-center"
        >
            <h3 class="text-primary text-[1.5rem] mb-5 font-bold uppercase">
                {t("projects.executiveSummary")}
            </h3>
            <p
                class="text-[1.1rem] leading-relaxed max-w-[800px] mx-auto text-white"
            >
                {t("projects.chalet.summary")}
            </p>
        </div>

        <div class="text-center mt-15">
            <a
                href="/#contacto"
                class="bg-primary text-black px-10 py-[15px] rounded-full font-bold uppercase transition-all hover:scale-105 hover:bg-[#ffc400] inline-block shadow-lg"
                >{t("projects.interested")}</a
            >
        </div>
    </section>
</ProjectLayout>
