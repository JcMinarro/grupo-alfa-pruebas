---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ContactForm from "../components/ContactForm.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
    title={`Contacto | ${t("brand.name")}`}
    bodyClass="contact-page bg-white text-dark"
    activeNav="contacto"
>
    <Hero
        title={t("contact.hero.title")}
        description={t("home.contact.description")}
        backgroundImage="/assets/whatsapp-image-2025-08-01-at-17.09.16-YbNJVMNBJQt0a97a.jpg"
        height="50vh"
    />

    <section
        class="max-w-[1200px] mx-auto py-20 px-5 grid grid-cols-1 md:grid-cols-2 gap-10 fade-in text-dark"
    >
        <div class="md:pr-10">
            <h2
                class="text-[2rem] mb-[30px] relative pb-[15px] after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-[60px] after:height-[4px] after:bg-primary"
            >
                {t("contact.info.title")}
            </h2>

            <div class="mb-8">
                <h3 class="text-[1.2rem] mb-2.5 text-dark font-bold">
                    {t("contact.info.address.title")}
                </h3>
                <p class="text-[1.1rem] text-[#444] leading-relaxed">
                    {t("home.office.address.line1")}
                </p>
                <p class="text-[1.1rem] text-[#444] leading-relaxed">
                    {t("home.office.address.line2")}
                </p>
                <p class="text-[1.1rem] text-[#444] leading-relaxed">
                    {t("home.office.address.city")}
                </p>
            </div>

            <div class="mb-8">
                <h3 class="text-[1.2rem] mb-2.5 text-dark font-bold">
                    {t("contact.info.email.title")}
                </h3>
                <p class="text-[1.1rem] text-[#444] leading-relaxed">
                    <a
                        href="mailto:info@grupoalfa.net"
                        class="text-inherit no-underline hover:text-primary transition-colors"
                        >info@grupoalfa.net</a
                    >
                </p>
                <p class="text-[1.1rem] text-[#444] leading-relaxed">
                    <a
                        href="mailto:joseantonio@grupoalfa.net"
                        class="text-inherit no-underline hover:text-primary transition-colors"
                        >joseantonio@grupoalfa.net</a
                    >
                </p>
                <p class="text-[1.1rem] text-[#444] leading-relaxed">
                    <a
                        href="mailto:luciomerlini@grupoalfa.net"
                        class="text-inherit no-underline hover:text-primary transition-colors"
                        >luciomerlini@grupoalfa.net</a
                    >
                </p>
            </div>

            <div class="mb-8">
                <h3 class="text-[1.2rem] mb-2.5 text-dark font-bold">
                    {t("contact.info.schedule.title")}
                </h3>
                <p class="text-[1.1rem] text-[#444] leading-relaxed">
                    {t("contact.info.schedule.text")}
                </p>
            </div>
        </div>

        <div
            class="bg-white p-10 shadow-[0_10px_40px_rgba(0,0,0,0.05)] rounded-lg"
        >
            <ContactForm
                showPhone={true}
                showPrivacy={true}
                theme="light"
                action="https://n8n.minarro.eu.org/webhook/contact-us"
            />
        </div>
    </section>

    <section class="h-[500px] bg-[#eee] mt-[60px] fade-in">
        <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3144.136343513689!2d-1.1221808!3d37.9923932!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd63821642bf0d0b%3A0xb27e472055ff1bc!2sP.%C2%BA+Virgen+de+la+Fuensanta%2C+10%2C+30008+Murcia!5e0!3m2!1sen!2ses!4v1700000000000!5m2!1sen!2ses"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
    </section>
</BaseLayout>
