---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ContactForm from "../components/ContactForm.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={`Contacto | ${t("brand.name")}`} bodyClass="contact-page">
    <Hero
        title={t("contact.hero.title")}
        subtitle={t("home.contact.description")}
        backgroundImage="/assets/whatsapp-image-2025-08-01-at-17.09.16-YbNJVMNBJQt0a97a.jpg"
        height="50vh"
    />

    <section class="contact-wrapper fade-in">
        <div class="contact-info">
            <h2>{t("contact.info.title")}</h2>

            <div class="info-item">
                <h3>{t("contact.info.address.title")}</h3>
                <p>{t("home.office.address.line1")}</p>
                <p>{t("home.office.address.line2")}</p>
                <p>{t("home.office.address.city")}</p>
            </div>

            <div class="info-item">
                <h3>{t("contact.info.email.title")}</h3>
                <p>
                    <a
                        href="mailto:info@grupoalfa.net"
                        style="color: inherit; text-decoration: none;"
                        >info@grupoalfa.net</a
                    >
                </p>
                <p>
                    <a
                        href="mailto:joseantonio@grupoalfa.net"
                        style="color: inherit; text-decoration: none;"
                        >joseantonio@grupoalfa.net</a
                    >
                </p>
                <p>
                    <a
                        href="mailto:luciomerlini@grupoalfa.net"
                        style="color: inherit; text-decoration: none;"
                        >luciomerlini@grupoalfa.net</a
                    >
                </p>
            </div>

            <div class="info-item">
                <h3>{t("contact.info.schedule.title")}</h3>
                <p>{t("contact.info.schedule.text")}</p>
            </div>
        </div>

        <div class="contact-form-container">
            <ContactForm showPhone={true} showPrivacy={true} theme="light" />
        </div>
    </section>

    <section class="map-section fade-in">
        <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3143.6062835955677!2d-1.1325456846755864!3d37.98399597972186!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd6382106318991d%3A0x6d116248c821104e!2sC.%20Conde%20del%20Valle%20de%20San%20Juan%2C%201%2C%2030004%20Murcia!5e0!3m2!1ses!2ses!4v1684318723521!5m2!1ses!2ses"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
    </section>
</BaseLayout>
