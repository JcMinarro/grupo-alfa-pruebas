---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

interface SaleData {
    price: string;
    profit: string;
    roi: string;
}

interface RentData {
    monthly: string;
    annual: string;
    operationalCosts?: string;
    netAnnual?: string;
    roi: string;
}

interface Props {
    title?: string;
    strategy?: "sale" | "rent" | "both";
    saleData?: SaleData;
    rentData?: RentData;
    class?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
    title = t("projects.division.roi.title"),
    strategy = "both",
    saleData,
    rentData,
    class: className = "",
} = Astro.props;
---

<div class={`mb-15 ${className}`}>
    <h2
        class="text-[1.5rem] mb-[25px] uppercase border-l-4 border-primary pl-[15px] text-[var(--component-text)]"
    >
        {title}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        {
            (strategy === "sale" || strategy === "both") && saleData && (
                <div class="p-[30px] bg-[var(--component-bg)] border border-[var(--component-border)] flex flex-col gap-[25px]">
                    <h3 class="text-[1.2rem] m-0 uppercase text-[var(--component-text)]">
                        {t("projects.division.roi.sale.label")}
                    </h3>
                    <div class="grid grid-cols-2 gap-5">
                        <div class="flex flex-col gap-[5px]">
                            <span class="text-[0.75rem] opacity-70 tracking-[1px] text-[var(--component-text-muted)]">
                                {t("projects.common.roi.sale.price")}
                            </span>
                            <strong class="text-[1.1rem] text-primary">
                                {saleData.price}
                            </strong>
                        </div>
                        <div class="flex flex-col gap-[5px]">
                            <span class="text-[0.75rem] opacity-70 tracking-[1px] text-[var(--component-text-muted)]">
                                {t("projects.common.roi.sale.profit")}
                            </span>
                            <strong class="text-[1.1rem] text-primary">
                                {saleData.profit}
                            </strong>
                        </div>
                    </div>
                    <div class="mt-auto pt-5 border-t border-[var(--component-border)] flex justify-between items-center">
                        <span class="font-bold tracking-[2px] text-[var(--component-text)]">
                            {t("projects.common.roi.label")}
                        </span>
                        <strong class="text-[2rem] text-primary">
                            {saleData.roi}
                        </strong>
                    </div>
                </div>
            )
        }

        {
            (strategy === "rent" || strategy === "both") && rentData && (
                <div class="p-[30px] bg-[var(--component-bg)] border border-[var(--component-border)] flex flex-col gap-[25px]">
                    <h3 class="text-[1.2rem] m-0 uppercase text-[var(--component-text)]">
                        {t("projects.division.roi.rent.label")}
                    </h3>
                    <div class="grid grid-cols-2 gap-5">
                        <div class="flex flex-col gap-[5px]">
                            <span class="text-[0.75rem] opacity-70 tracking-[1px] text-[var(--component-text-muted)]">
                                {t("projects.common.roi.rent.monthly")}
                            </span>
                            <strong class="text-[1.1rem] text-primary">
                                {rentData.monthly}
                            </strong>
                        </div>
                        <div class="flex flex-col gap-[5px]">
                            <span class="text-[0.75rem] opacity-70 tracking-[1px] text-[var(--component-text-muted)]">
                                {t("projects.common.roi.rent.annual")}
                            </span>
                            <strong class="text-[1.1rem] text-primary">
                                {rentData.annual}
                            </strong>
                        </div>
                    </div>
                    <div class="mt-auto pt-5 border-t border-[var(--component-border)] flex justify-between items-center">
                        <span class="font-bold tracking-[2px] text-[var(--component-text)]">
                            {t("projects.common.roi.label")}
                        </span>
                        <strong class="text-[2rem] text-primary">
                            {rentData.roi}
                        </strong>
                    </div>
                </div>
            )
        }
    </div>
</div>
