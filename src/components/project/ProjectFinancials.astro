---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

interface Cost {
    concept: string;
    amount: string;
}

interface Props {
    title?: string;
    costs: Cost[];
    total?: string;
    class?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
    title = t("projects.division.costs.title"),
    costs,
    total,
    class: className = "",
} = Astro.props;
---

<div class={`mb-15 ${className}`}>
    <h2
        class="text-[1.5rem] mb-[25px] uppercase border-l-4 border-primary pl-[15px] text-[var(--component-text)]"
    >
        {title}
    </h2>
    <table class="w-full border-collapse bg-[var(--component-bg)]">
        <tbody>
            {
                costs.map((cost) => (
                    <tr>
                        <td class="p-[15px_20px] border border-[var(--component-border)] text-base text-[var(--component-text)]">
                            {cost.concept}
                        </td>
                        <td class="p-[15px_20px] border border-[var(--component-border)] text-base text-[var(--component-text)] font-bold text-right text-primary">
                            {cost.amount}
                        </td>
                    </tr>
                ))
            }
            {
                total && (
                    <tr class="bg-[rgba(255,170,0,0.1)]">
                        <td class="p-[15px_20px] border border-[var(--component-border)] text-base text-[var(--component-text)] font-bold border-t-2 border-t-primary">
                            {t("projects.costs.total")}
                        </td>
                        <td class="p-[15px_20px] border border-[var(--component-border)] text-base text-[var(--component-text)] font-bold border-t-2 border-t-primary text-right text-primary">
                            {total}
                        </td>
                    </tr>
                )
            }
        </tbody>
    </table>
</div>
