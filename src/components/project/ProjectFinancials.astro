---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

interface Cost {
    concept: string;
    amount: string;
}

interface Props {
    title?: string;
    costs: Cost[];
    total?: string;
    class?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
    title = t("projects.division.costs.title"),
    costs,
    total,
    class: className = "",
} = Astro.props;
---

<div class={`project-financials ${className}`}>
    <h2>{title}</h2>
    <table class="data-table">
        <tbody>
            {
                costs.map((cost) => (
                    <tr>
                        <td>{cost.concept}</td>
                        <td class="amount">{cost.amount}</td>
                    </tr>
                ))
            }
            {
                total && (
                    <tr class="total-row">
                        <td>{t("projects.costs.total")}</td>
                        <td class="amount">{total}</td>
                    </tr>
                )
            }
        </tbody>
    </table>
</div>

<style>
    .project-financials {
        margin-bottom: 60px;
    }

    h2 {
        font-size: 1.5rem;
        margin-bottom: 25px;
        text-transform: uppercase;
        border-left: 4px solid var(--color-primary);
        padding-left: 15px;
        color: var(--component-text);
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        background: var(--component-bg);
    }

    .data-table td {
        padding: 15px 20px;
        border: 1px solid var(--component-border);
        font-size: 1rem;
        color: var(--component-text);
    }

    .amount {
        font-weight: 700;
        text-align: right;
        color: var(--color-primary);
    }

    .total-row {
        background: rgba(255, 170, 0, 0.1);
    }

    .total-row td {
        font-weight: 700;
        border-top: 2px solid var(--color-primary);
    }
</style>
