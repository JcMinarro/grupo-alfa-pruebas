---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

interface Props {
    location?: string;
    type?: string;
    surface?: string;
    distribution?: string;
    class?: string;
}

const {
    location,
    type,
    surface,
    distribution,
    class: className = "",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div
    class={`grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-5 mb-10 ${className}`}
>
    {
        type && (
            <div class="p-5 bg-[var(--component-bg)] border border-[var(--component-border)]">
                <h4 class="text-[0.85rem] text-primary uppercase mb-[10px] opacity-80">
                    {t("projects.common.details.type")}
                </h4>
                <p class="text-[1.1rem] font-medium text-[var(--component-text)] m-0">
                    {type}
                </p>
            </div>
        )
    }
    {
        location && (
            <div class="p-5 bg-[var(--component-bg)] border border-[var(--component-border)]">
                <h4 class="text-[0.85rem] text-primary uppercase mb-[10px] opacity-80">
                    {t("projects.common.details.location")}
                </h4>
                <p class="text-[1.1rem] font-medium text-[var(--component-text)] m-0">
                    {location}
                </p>
            </div>
        )
    }
    {
        surface && (
            <div class="p-5 bg-[var(--component-bg)] border border-[var(--component-border)]">
                <h4 class="text-[0.85rem] text-primary uppercase mb-[10px] opacity-80">
                    {t("projects.common.details.surface")}
                </h4>
                <p class="text-[1.1rem] font-medium text-[var(--component-text)] m-0">
                    {surface}
                </p>
            </div>
        )
    }
    {
        distribution && (
            <div class="p-5 bg-[var(--component-bg)] border border-[var(--component-border)]">
                <h4 class="text-[0.85rem] text-primary uppercase mb-[10px] opacity-80">
                    {t("projects.common.details.distribution")}
                </h4>
                <p class="text-[1.1rem] font-medium text-[var(--component-text)] m-0">
                    {distribution}
                </p>
            </div>
        )
    }
</div>
