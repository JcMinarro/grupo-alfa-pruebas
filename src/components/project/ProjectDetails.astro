---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

interface Props {
    location?: string;
    type?: string;
    surface?: string;
    distribution?: string;
    class?: string;
}

const {
    location,
    type,
    surface,
    distribution,
    class: className = "",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class={`project-details-grid ${className}`}>
    {
        type && (
            <div class="detail-card">
                <h4>{t("projects.common.details.type")}</h4>
                <p>{type}</p>
            </div>
        )
    }
    {
        location && (
            <div class="detail-card">
                <h4>{t("projects.common.details.location")}</h4>
                <p>{location}</p>
            </div>
        )
    }
    {
        surface && (
            <div class="detail-card">
                <h4>{t("projects.common.details.surface")}</h4>
                <p>{surface}</p>
            </div>
        )
    }
    {
        distribution && (
            <div class="detail-card">
                <h4>{t("projects.common.details.distribution")}</h4>
                <p>{distribution}</p>
            </div>
        )
    }
</div>

<style>
    .project-details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .detail-card {
        padding: 20px;
        background: var(--component-bg);
        border: 1px solid var(--component-border);
    }

    .detail-card h4 {
        font-size: 0.85rem;
        color: var(--color-primary);
        text-transform: uppercase;
        margin-bottom: 10px;
        opacity: 0.8;
    }

    .detail-card p {
        font-size: 1.1rem;
        font-weight: 500;
        color: var(--component-text);
        margin: 0;
    }
</style>
