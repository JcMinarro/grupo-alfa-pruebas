---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { ACTIVE_MEMBERSHIP_STATUSES } from "../lib/server/membership";
import MembershipLink from "./MembershipLink.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { activeNav = "inicio" } = Astro.props;
const authState = Astro.locals.auth?.();
const isAuthenticated = authState?.isAuthenticated ?? false;
const currentUser = isAuthenticated && Astro.locals.currentUser ? await Astro.locals.currentUser() : null;
const isActivePaidMember = ACTIVE_MEMBERSHIP_STATUSES.includes(currentUser?.publicMetadata?.membershipStatus);

const publicNavLinks = [
  { id: "inicio", href: "/", label: t("nav.inicio") },
  { id: "club", href: "/club", label: t("nav.club") },
  { id: "proyectos", href: "/proyectos", label: t("nav.proyectos") },
  { id: "promotores", href: "/promotores", label: t("nav.promotores") },
  { id: "inversores", href: "/inversores", label: t("nav.inversores") },
  { id: "hunters", href: "/alfa-hunters", label: t("nav.hunters") },
  { id: "contacto", href: "/contacto", label: t("nav.contacto") },
];

const navLinks = isActivePaidMember
  ? publicNavLinks.filter(({ id }) => id !== "club")
  : publicNavLinks;

const authLinks = isAuthenticated
  ? [{ href: isActivePaidMember ? "/members/benefits" : "/membership?payment_required=1", label: t("nav.members") }]
  : [{ href: "/sign-in", label: t("nav.signIn") }];
---

<header
  class="fixed top-0 left-0 w-full z-[1000] bg-transparent text-white transition-all duration-300 py-5 [&.scrolled]:bg-[#1d1e20]/95 [&.scrolled]:py-2.5 [&.scrolled]:shadow-[0_2px_10px_rgba(0,0,0,0.3)]"
  id="header"
>
  <div
    class="max-w-[1200px] mx-auto px-4 w-full flex justify-between items-center"
  >
    <a href="/" class="block relative z-[1001]">
      <img
        src="/assets/logo-alfa-wolf.png"
        alt={t("brand.name")}
        class="header-logo h-[40px]"
      />
    </a>

    <!-- Mobile Menu Toggle -->
    <button
      class="mobile-menu-toggle md:hidden flex flex-col justify-center items-center gap-1.5 w-10 h-10 z-[1001] bg-transparent border-none cursor-pointer group text-current"
      aria-label="Toggle Menu"
    >
      <span
        class="w-6 h-0.5 bg-current transition-all duration-300 group-[.active]:rotate-45 group-[.active]:translate-y-2"
      ></span>
      <span
        class="w-6 h-0.5 bg-current transition-all duration-300 group-[.active]:opacity-0"
      ></span>
      <span
        class="w-6 h-0.5 bg-current transition-all duration-300 group-[.active]:-rotate-45 group-[.active]:-translate-y-2"
      ></span>
    </button>

    <!-- Desktop Navigation -->
    <nav class="hidden md:block">
      <ul class="flex gap-[30px] list-none m-0 p-0 items-center">
        {
          navLinks.map(({ id, href, label }) => (
            <li>
              <a
                href={href}
                class={`header-link text-[0.9rem] font-medium tracking-[1px] uppercase transition-colors hover:text-primary ${activeNav === id ? "text-primary" : "text-current"}`}
              >
                {label}
              </a>
            </li>
          ))
        }
        {
          authLinks.map(({ href, label }) => (
            <li>
              <MembershipLink
                href={href}
                label={label}
                className="inline-flex items-center rounded-full border border-current/20 px-5 py-2 text-[0.82rem] font-bold tracking-[1px] uppercase transition-colors hover:border-primary hover:text-primary"
              />
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Mobile Navigation Overlay -->
    <div
      class="nav-menu fixed top-0 right-0 w-full h-screen bg-[#1d1e20]/95 text-white backdrop-blur-lg translate-x-full transition-transform duration-500 ease-in-out z-[1000] flex flex-col items-center justify-center gap-8 md:hidden [&.active]:translate-x-0"
    >
      <ul class="flex flex-col items-center gap-8 list-none m-0 p-0">
        {
          navLinks.map(({ id, href, label }) => (
            <li>
              <a
                href={href}
                class={`header-link text-[1.5rem] font-medium tracking-[2px] uppercase transition-colors hover:text-primary ${activeNav === id ? "text-primary" : "text-current"}`}
              >
                {label}
              </a>
            </li>
          ))
        }
        {
          authLinks.map(({ href, label }) => (
            <li>
              <MembershipLink
                href={href}
                label={label}
                className="inline-flex items-center rounded-full border border-white/30 px-6 py-3 text-[1rem] font-bold tracking-[2px] uppercase transition-colors hover:border-primary hover:text-primary"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>
