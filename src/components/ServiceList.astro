---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
    {
        title: t("services.personalShopper.title"),
        description: t("services.personalShopper.description"),
        icon: "/assets/lupa-AE0r2VjNOpI4LRQ7.png",
    },
    {
        title: t("services.reforma.title"),
        description: t("services.reforma.description"),
        icon: "/assets/mrtillo-AR032ZKJrRh87JyG.png",
    },
    {
        title: t("services.broker.title"),
        description: t("services.broker.description"),
        icon: "/assets/casa-AR032qQw99I1yKM5.png",
    },
    {
        title: t("services.interiorismo.title"),
        description: t("services.interiorismo.description"),
        icon: "/assets/interiorismo-m6LbP1Zkv6HB177D.png",
    },
    {
        title: t("services.alquiler.title"),
        description: t("services.alquiler.description"),
        icon: "/assets/llave-YX4x19levpIeRQRZ.png",
    },
];
---

<div class="flex flex-col">
    {
        services.map((service, index) => (
            <div
                class={`py-15 ${index % 2 === 0 ? "bg-white" : "bg-[#f2f2f2]"}`}
            >
                <div
                    class={`max-w-[1000px] mx-auto px-5 flex flex-col md:flex-row items-center gap-15 ${index % 2 !== 0 ? "md:flex-row-reverse" : ""}`}
                >
                    <div class="flex-1 text-center md:text-left">
                        <h3 class="text-[1.4rem] font-bold mb-5 uppercase bg-primary inline-block px-[15px] py-[5px] text-black italic tracking-wide">
                            {service.title}
                        </h3>
                        <p class="text-[1.1rem] leading-relaxed text-[#333]">
                            {service.description}
                        </p>
                    </div>
                    <div class="shrink-0 w-[150px] flex justify-center items-center">
                        <img
                            src={service.icon}
                            alt={t("services.icon.alt")}
                            class="w-25 h-auto object-contain brightness-0 grayscale opacity-80"
                        />
                    </div>
                </div>
            </div>
        ))
    }
</div>
