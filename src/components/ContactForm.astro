---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
    id,
    action = "#",
    method = "POST",
    showPhone = false,
    showPrivacy = true,
    buttonText = t("contact.form.submit"),
    theme = "dark",
} = Astro.props;
---

<form
    id={id}
    action={action}
    method={method}
    class="flex flex-col gap-5 text-left"
    data-contact-form
>
    <div class="flex flex-col gap-2">
        <label
            for="name"
            class={`text-sm font-medium opacity-90 ${theme === "dark" ? "text-white" : "text-dark"}`}
            >{t("contact.form.name")} *</label
        >
        <input
            type="text"
            id="name"
            name="name"
            class={`p-3 border transition-colors focus:outline-none focus:border-primary ${theme === "dark" ? "bg-white/5 border-white/20 text-white" : "bg-[#f8f9fa] border-[#ddd] text-dark"}`}
            required
        />
    </div>

    {
        showPhone && (
            <div class="flex flex-col gap-2">
                <label
                    for="phone"
                    class={`text-sm font-medium opacity-90 ${theme === "dark" ? "text-white" : "text-dark"}`}
                >
                    {t("contact.form.phone")}
                </label>
                <input
                    type="tel"
                    id="phone"
                    name="phone"
                    class={`p-3 border transition-colors focus:outline-none focus:border-primary ${theme === "dark" ? "bg-white/5 border-white/20 text-white" : "bg-[#f8f9fa] border-[#ddd] text-dark"}`}
                />
            </div>
        )
    }

    <div class="flex flex-col gap-2">
        <label
            for="email"
            class={`text-sm font-medium opacity-90 ${theme === "dark" ? "text-white" : "text-dark"}`}
            >{t("contact.form.email")} *</label
        >
        <input
            type="email"
            id="email"
            name="email"
            class={`p-3 border transition-colors focus:outline-none focus:border-primary ${theme === "dark" ? "bg-white/5 border-white/20 text-white" : "bg-[#f8f9fa] border-[#ddd] text-dark"}`}
            placeholder={t("contact.form.email.placeholder")}
            required
        />
    </div>

    <div class="flex flex-col gap-2">
        <label
            for="message"
            class={`text-sm font-medium opacity-90 ${theme === "dark" ? "text-white" : "text-dark"}`}
            >{t("contact.form.message")}</label
        >
        <textarea
            id="message"
            name="message"
            class={`p-3 border transition-colors focus:outline-none focus:border-primary ${theme === "dark" ? "bg-white/5 border-white/20 text-white" : "bg-[#f8f9fa] border-[#ddd] text-dark"}`}
            rows="4"></textarea>
    </div>

    {
        showPrivacy && (
            <div class="flex flex-row items-start gap-2.5 mt-1.25 w-full text-left">
                <input
                    type="checkbox"
                    id="privacy"
                    name="privacy"
                    class="mt-1 cursor-pointer shrink-0"
                    required
                />
                <label
                    for="privacy"
                    class={`text-[0.85rem] font-normal leading-[1.4] cursor-pointer inline-block m-0 text-left ${theme === "dark" ? "text-white/80" : "text-[#666]"}`}
                >
                    {t("contact.form.privacy.prefix")}{" "}
                    <a href="/privacidad" class="text-primary hover:underline">
                        {t("contact.form.privacy.link")}
                    </a>{" "}
                    {t("contact.form.privacy.suffix")}
                </label>
            </div>
        )
    }

    <button
        type="submit"
        class="p-4 bg-primary text-black border-none font-bold uppercase cursor-pointer transition-all hover:bg-[#ffc400] hover:-translate-y-0.5 mt-2.5"
        >{buttonText}</button
    >
</form>

<script>
    document.addEventListener("astro:page-load", () => {
        const forms = document.querySelectorAll("form[data-contact-form]");

        forms.forEach((form) => {
            form.addEventListener("submit", async (e) => {
                e.preventDefault();
                const submitBtn = form.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerText;

                try {
                    submitBtn.disabled = true;
                    submitBtn.innerText = "Enviando...";

                    const formData = new FormData(form);
                    const data = Object.fromEntries(formData.entries());

                    // Handle checkboxes separately if needed, but FormData handles them fine usually.
                    // However, checkboxes not checked don't appear in FormData.
                    if (
                        form.querySelector('input[name="privacy"]') &&
                        !formData.get("privacy")
                    ) {
                        // Should be caught by 'required' attribute, but just in case
                        throw new Error(
                            "Debe aceptar la política de privacidad",
                        );
                    }

                    const response = await fetch(form.action, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify(data),
                    });

                    if (response.ok) {
                        alert(
                            "Gracias por tu mensaje. Nos pondremos en contacto contigo pronto.",
                        );
                        form.reset();
                    } else {
                        throw new Error("Error en el envío");
                    }
                } catch (error) {
                    console.error("Error submitting form:", error);
                    alert(
                        "Hubo un error al enviar el mensaje. Por favor, inténtelo de nuevo.",
                    );
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerText = originalText;
                }
            });
        });
    });
</script>
