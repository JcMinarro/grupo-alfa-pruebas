---
interface Props {
    title?: string;
    description?: string;
    number?: string;
    icon?: string;
    animation?: string;
    class?: string;
}

const {
    title,
    description,
    number,
    icon,
    animation = "fade-in",
    class: className = "",
} = Astro.props;
---

<div
    class={`flex flex-col gap-5 p-[30px] bg-[var(--component-bg)] border border-[var(--component-border)] transition-all duration-300 hover:-translate-y-[5px] hover:border-primary hover:shadow-[0_10px_30px_rgba(0,0,0,0.2)] ${animation} ${className}`}
>
    {
        number && (
            <span class="text-[3rem] font-bold text-primary leading-none opacity-50">
                {number}
            </span>
        )
    }
    {
        icon && (
            <div class="w-[50px] h-[50px] flex items-center justify-center">
                <img
                    src={icon}
                    alt=""
                    aria-hidden="true"
                    class="max-w-full max-h-full object-contain"
                />
            </div>
        )
    }
    <slot name="icon" />

    <div class="flex flex-col gap-[10px]">
        {
            title && (
                <h3 class="text-[1.2rem] font-semibold mb-[0.8rem] uppercase text-[var(--component-text)]">
                    {title}
                </h3>
            )
        }
        {
            description && (
                <p class="text-[0.95rem] leading-[1.6] text-[var(--component-text-muted)]">
                    {description}
                </p>
            )
        }
        <slot />
    </div>
</div>
