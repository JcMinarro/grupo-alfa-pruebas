---
interface Props {
    title?: string;
    description?: string;
    number?: string;
    icon?: string;
    animation?: string;
    class?: string;
}

const {
    title,
    description,
    number,
    icon,
    animation = "fade-in",
    class: className = "",
} = Astro.props;
---

<div class={`grid-item ${animation} ${className}`}>
    {number && <span class="item-number">{number}</span>}
    {
        icon && (
            <div class="item-icon">
                <img src={icon} alt="" aria-hidden="true" />
            </div>
        )
    }
    <slot name="icon" />

    <div class="item-content">
        {title && <h3>{title}</h3>}
        {description && <p>{description}</p>}
        <slot />
    </div>
</div>

<style>
    .grid-item {
        display: flex;
        flex-direction: column;
        gap: 20px;
        padding: 30px;
        background: var(--component-bg);
        border: 1px solid var(--component-border);
        transition:
            transform 0.3s,
            border-color 0.3s,
            box-shadow 0.3s;
    }

    .grid-item:hover {
        transform: translateY(-5px);
        border-color: var(--color-primary);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .item-number {
        font-size: 3rem;
        font-weight: 700;
        color: var(--color-primary);
        line-height: 1;
        opacity: 0.5;
    }

    .item-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .item-icon img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    .item-content h3 {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 0.8rem;
        text-transform: uppercase;
        color: var(--component-text);
    }

    .item-content p {
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--component-text-muted);
    }
</style>
