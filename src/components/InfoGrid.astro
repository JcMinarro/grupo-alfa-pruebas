---
interface Props {
    columns?: number;
    gap?: string;
    class?: string;
}

const { columns = 3, gap = "40px", class: className = "" } = Astro.props;

const style = {
    "--grid-cols": columns,
    "--grid-gap": gap,
};
---

<div class={`info-grid ${className}`} style={style}>
    <slot />
</div>

<style>
    .info-grid {
        display: grid;
        grid-template-columns: repeat(var(--grid-cols), 1fr);
        gap: var(--grid-gap);
        width: 100%;
    }

    @media (max-width: 992px) {
        .info-grid {
            grid-template-columns: repeat(min(2, var(--grid-cols)), 1fr);
        }
    }

    @media (max-width: 640px) {
        .info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
