---
interface Props {
    columns?: number;
    gap?: string;
    class?: string;
}

const { columns = 3, gap = "40px", class: className = "" } = Astro.props;

const style = {
    "--grid-cols": columns,
    "--grid-gap": gap,
};
---

<div
    class={`grid w-full ${columns === 2 ? "grid-cols-1 md:grid-cols-2" : columns === 4 ? "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"} gap-10 ${className}`}
>
    <slot />
</div>
