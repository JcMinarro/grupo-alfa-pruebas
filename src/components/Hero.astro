---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
    title?: string;
    subtitle?: string;
    description?: string;
    location?: string;
    backgroundImage?: string;
    backgroundVideo?: string;
    videoPoster?: string;
    overlayOpacity?: number;
    height?: string;
    class?: string;
    id?: string;
}

const {
    title,
    subtitle,
    description,
    location,
    backgroundImage,
    backgroundVideo,
    videoPoster,
    overlayOpacity = 0.5,
    height = "60vh",
    class: className = "",
    id,
} = Astro.props;
---

<section
    id={id}
    class={`relative flex items-center justify-center text-center text-white overflow-hidden bg-bg-dark py-20 min-h-[400px] md:min-h-[var(--hero-height)] ${className}`}
    style={`--overlay-opacity: ${overlayOpacity}; --hero-height: ${height}; --bg-image: ${backgroundImage ? `url('${backgroundImage}')` : "none"};`}
>
    {
        /* Support: string URL or array of variants: [{url, width, bitrate}] */
        backgroundVideo && (
            <div class="absolute top-0 left-0 w-full h-full object-cover z-0">
                <video
                    aria-label={title || "Hero video"}
                    muted
                    loop
                    playsinline
                    webkit-playsinline
                    poster={videoPoster}
                    class="absolute top-0 left-0 w-full h-full object-cover"
                    preload="none"
                >
                    {
                    Array.isArray(backgroundVideo)
                        ? backgroundVideo.map(variant => (
                            <source data-src={variant.url} type={variant.type || "video/mp4"} />
                        ))
                        : <source data-src={backgroundVideo} type="video/mp4" />
                    }
                </video>

                <!-- Pause/Play control for accessibility -->
                <button
                    class="absolute bottom-4 right-4 z-10 bg-black bg-opacity-50 text-white px-3 py-2 rounded"
                    type="button"
                    aria-pressed="false"
                    aria-label="Pause background video"
                    data-hero-control
                >Reproducir</button>
            </div>
        )
    }

    {
        !backgroundVideo && backgroundImage && (
            <div
                class="absolute top-0 left-0 w-full h-full object-cover z-0 bg-no-repeat bg-center bg-cover"
                style="background-image: var(--bg-image);"
            />
        )
    }

    <div
        class="absolute top-0 left-0 w-full h-full z-[1]"
        style="background: rgba(0, 0, 0, var(--overlay-opacity));"
    >
    </div>

    <div
        class="max-w-[1200px] mx-auto px-4 w-full relative z-[2] flex flex-col items-center justify-center text-white"
    >
        <div class="max-w-[800px]">
            <div
                class="fade-in-content opacity-0 translate-y-5 transition-all duration-1000 ease-out [&.visible]:opacity-100 [&.visible]:translate-y-0"
            >
                {
                    location && (
                        <p class="text-[0.85rem] tracking-[2px] uppercase mb-4 opacity-80 text-white">
                            {location}
                        </p>
                    )
                }
                {
                    title && (
                        <h1 class="text-[2rem] md:text-[4rem] font-bold mb-4 uppercase text-white">
                            {title}
                        </h1>
                    )
                }
                {
                    subtitle && (
                        <h2 class="text-[1rem] md:text-[1.5rem] font-normal tracking-[4px] opacity-90 text-white">
                            {subtitle}
                        </h2>
                    )
                }
                {
                    description && (
                        <p class="text-[1.1rem] opacity-90 mt-5 max-w-[700px] mx-auto text-white leading-relaxed">
                            {description}
                        </p>
                    )
                }
                <slot />
            </div>
        </div>
    </div>
</section>

<script>
    // Trigger fade-in animations on page load and during view transitions
    const animateHero = () => {
        const fadeElements = document.querySelectorAll(".fade-in-content");
        fadeElements.forEach((el) => {
            // Remove visible class first in case it was already there (from a previous page)
            el.classList.remove("visible");
            setTimeout(() => {
                el.classList.add("visible");
            }, 100);
        });
    };

    // Initial load
    document.addEventListener("DOMContentLoaded", animateHero);
    // On every page navigation (View Transitions)
    document.addEventListener("astro:page-load", animateHero);

    // Lazy-load and connection-aware selection for hero videos
    const initHeroVideos = () => {
        const heroVideos = document.querySelectorAll('section video');
        heroVideos.forEach((video) => {
            const container = video.closest('section');
            const control = container && container.querySelector('[data-hero-control]');

            const loadVideoSources = (force = false) => {
                const sources = video.querySelectorAll('source[data-src]');
                if (!sources || sources.length === 0) return;

                // If sources are already set, no-op
                if (sources[0].getAttribute('src')) return;

                // Choose order based on connection.effectiveType if available
                const conn = navigator.connection && navigator.connection.effectiveType ? navigator.connection.effectiveType : '4g';

                // If the connection is poor and not forced, *do not* set src attributes yet.
                const poorConnection = (conn === '2g' || conn === 'slow-2g');
                if (poorConnection && !force) {
                    // Signal to the control that loading is deferred
                    if (control) {
                        control.textContent = 'Load background video';
                        control.setAttribute('data-deferred', 'true');
                        control.setAttribute('aria-pressed', 'false');
                    }
                    return;
                }

                // The editorial data should order variants from low->high bitrate
                const ordered = Array.from(sources);
                if (poorConnection) {
                    // keep order (assumes low->high)
                } else {
                    // reverse to prefer higher quality when connection is good
                    ordered.reverse();
                }

                ordered.forEach(src => {
                    const real = src.getAttribute('data-src');
                    if (real) src.setAttribute('src', real);
                });

                // start loading
                try { video.load(); } catch (e) { /* ignore */ }

                // Autoplay only on non-poor connections unless forced
                const shouldAutoplay = (!poorConnection && window.innerWidth > 640) || force;
                if (shouldAutoplay) {
                    video.play().catch(()=>{/* autoplay blocked */});
                }

                // Clear deferred flag on control
                if (control) {
                    control.removeAttribute('data-deferred');
                    control.textContent = video.paused ? 'Play' : 'Pause';
                    control.setAttribute('aria-pressed', video.paused ? 'true' : 'false');
                }
            };

            const obs = new IntersectionObserver((entries, obs) => {
                entries.forEach(e => {
                    if (e.isIntersecting) {
                        loadVideoSources();
                        obs.unobserve(e.target);
                    }
                });
            }, {rootMargin: '200px'});

            obs.observe(container || video);

            if (control) {
                control.addEventListener('click', () => {
                    const deferred = control.getAttribute('data-deferred') === 'true';
                    if (deferred) {
                        // User explicitly requested to load video on poor connection
                        loadVideoSources(true);
                        // try to play after loading
                        setTimeout(() => {
                            video.play().catch(()=>{});
                        }, 50);
                        return;
                    }

                    // If video sources weren't set yet (but not deferred), ensure they're loaded
                    const firstSource = video.querySelector('source');
                    if (firstSource && !firstSource.getAttribute('src')) {
                        loadVideoSources(true);
                        setTimeout(() => {
                            video.play().catch(()=>{});
                        }, 50);
                        return;
                    }

                    if (video.paused) {
                        video.play();
                        control.textContent = 'Pause';
                        control.setAttribute('aria-pressed','false');
                    } else {
                        video.pause();
                        control.textContent = 'Play';
                        control.setAttribute('aria-pressed','true');
                    }
                });
            }
        });
    };

    document.addEventListener('DOMContentLoaded', initHeroVideos);
    document.addEventListener('astro:page-load', initHeroVideos);
</script>
