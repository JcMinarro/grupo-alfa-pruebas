---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import HeroVideo from "./HeroVideo.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
    title?: string;
    subtitle?: string;
    description?: string;
    location?: string;
    backgroundImage?: string;
    backgroundVideo?: string | any[];
    videoPoster?: string;
    overlayOpacity?: number;
    height?: string;
    class?: string;
    id?: string;
    contentAlignment?: "center" | "bottom";
}

const {
    title,
    subtitle,
    description,
    location,
    backgroundImage,
    backgroundVideo,
    videoPoster,
    overlayOpacity = 0.3,
    height = "60vh",
    class: className = "",
    id,
    contentAlignment = "center",
} = Astro.props;

const alignmentClass = contentAlignment === "bottom" ? "items-end pb-20" : "items-center";
---

<section
    id={id}
    class={`relative flex ${alignmentClass} justify-center text-center text-white overflow-hidden bg-bg-dark py-20 min-h-[400px] md:min-h-[var(--hero-height)] ${className}`}
    style={`--overlay-opacity: ${overlayOpacity}; --hero-height: ${height}; --bg-image: ${backgroundImage ? `url('${backgroundImage}')` : "none"};`}
>
    {
        /* Use new HeroVideo component for playback behavior */
        backgroundVideo && (
            <div class="absolute top-0 left-0 w-full h-full object-cover z-0">
                <HeroVideo
                    sources={backgroundVideo}
                    poster={videoPoster}
                    title={title}
                />
            </div>
        )
    }

    {
        !backgroundVideo && backgroundImage && (
            <div
                class="absolute top-0 left-0 w-full h-full object-cover z-0 bg-no-repeat bg-center bg-cover"
                style="background-image: var(--bg-image);"
            />
        )
    }

    <div
        class="absolute top-0 left-0 w-full h-full z-[1]"
        style="background: rgba(0, 0, 0, var(--overlay-opacity));"
    >
    </div>


    <div
        class="max-w-[1200px] mx-auto px-4 w-full relative z-[2] flex flex-col items-center justify-center text-white"
    >
        <div class="max-w-[800px]">
            <div
                class="fade-in-content opacity-0 translate-y-5 transition-all duration-1000 ease-out [&.visible]:opacity-100 [&.visible]:translate-y-0"
            >
                {
                    title && (
                        <h1 class="text-[2rem] md:text-[4rem] font-bold mb-4 uppercase text-white">
                            {title}
                        </h1>
                    )
                }
                {
                    subtitle && (
                        <h2 class="text-[1rem] md:text-[1.5rem] font-normal tracking-[4px] opacity-90 text-white">
                            {subtitle}
                        </h2>
                    )
                }
                {
                    description && (
                        <p class="text-[1.1rem] opacity-90 mt-5 max-w-[700px] mx-auto text-white leading-relaxed">
                            {description}
                        </p>
                    )
                }
                <slot />
            </div>
        </div>
    </div>
</section>

<script>
// Trigger fade-in animations on page load and during view transitions
    const animateHero = () => {
        const fadeElements = document.querySelectorAll(".fade-in-content");
        fadeElements.forEach((el) => {
            // Remove visible class first in case it was already there (from a previous page)
            el.classList.remove("visible");
            setTimeout(() => {
                el.classList.add("visible");
            }, 100);
        });
    };

    // Initial load
    document.addEventListener("DOMContentLoaded", animateHero);
    // On every page navigation (View Transitions)
    document.addEventListener("astro:page-load", animateHero);
</script>
