---
import BeforeAfterSlider from "./BeforeAfterSlider.astro";

interface Props {
    title: string;
    location: string;
    beforeImage: string;
    afterImage: string;
    href: string;
    viewMoreText: string;
    disabled?: boolean;
}

const {
    title,
    location,
    beforeImage,
    afterImage,
    href,
    viewMoreText,
    disabled = false,
} = Astro.props;
---

<div
    class:list={[
        "card-project group bg-white rounded-2xl overflow-hidden border border-gray-100 shadow-[0_10px_30px_rgba(0,0,0,0.05)] transition-all duration-500",
        {
            "opacity-95 grayscale-[0.3]": disabled,
            "hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(0,0,0,0.12)]":
                !disabled,
        },
    ]}
>
    <!-- Before/After Slider Area -->
    <div class="relative">
        <BeforeAfterSlider beforeImage={beforeImage} afterImage={afterImage} />

        <!-- Location Badge Overlay -->
        <div class="absolute top-4 left-4 z-10">
            <span
                class="bg-black/70 backdrop-blur-md text-[#f9da78] text-[0.7rem] px-3 py-1.5 rounded-full font-bold uppercase tracking-widest border border-[#f9da78]/30"
            >
                {location}
            </span>
        </div>
    </div>

    <!-- Content Area -->
    <div class="p-8 flex flex-col items-center text-center">
        <h3
            class="text-xl font-heading font-bold text-dark mb-4 leading-tight group-hover:text-primary transition-colors duration-300"
        >
            {title}
        </h3>

        <div
            class="w-12 h-[2px] bg-primary/30 mb-6 group-hover:w-24 transition-all duration-500"
        >
        </div>

        <a
            href={href}
            class:list={[
                "inline-flex items-center gap-2 text-[0.85rem] font-bold uppercase tracking-widest transition-all duration-300",
                disabled
                    ? "text-gray-400 pointer-events-none"
                    : "text-dark hover:text-primary",
            ]}
        >
            {viewMoreText}
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="translate-x-0 group-hover:translate-x-1 transition-transform"
            >
                <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
            </svg>
        </a>
    </div>
</div>

<style>
    .card-project {
        backface-visibility: hidden;
    }
</style>
