---
const links = [
    { href: '/members', label: 'Resumen' },
    { href: '/members/profile', label: 'Perfil' },
    { href: '/members/membership', label: 'Membresía' },
    { href: '/members/benefits', label: 'Ventajas' },
    { href: '/members/resources', label: 'Recursos' },
    { href: '/members/events', label: 'Eventos' },
    { href: '/members/expert-sessions', label: 'Sesiones expertas' },
    { href: '/members/referrals', label: 'Referidos' }
];

const { activePath = '/members' } = Astro.props;
---

<nav class="border-b border-white/10 bg-[#141517]">
    <div class="max-w-[1200px] mx-auto px-4 py-4 flex flex-wrap gap-3">
        {links.map(({ href, label }) => (
            <a
                href={href}
                class={`rounded-full px-4 py-2 text-sm uppercase tracking-[1px] ${activePath === href ? 'bg-primary text-black font-bold' : 'border border-white/15 text-white/75 hover:text-white hover:border-primary'}`}
            >
                {label}
            </a>
        ))}
    </div>
</nav>
