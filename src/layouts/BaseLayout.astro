---
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/theme.css";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
    title = t("meta.title"),
    bodyClass = "",
    footerStyle = "",
    activeNav = "inicio",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={t("meta.description")} />
        <title>{title}</title>
        <!-- Favicon -->
        <link rel="icon" type="image/png" href="/assets/logo-alfa-wolf.png" />
        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;700&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap"
            rel="stylesheet"
        />

        <slot name="head" />
        <Analytics />
        <ClientRouter />
        <script src="/src/scripts/main.js"></script>
    </head>
    <body
        class={`bg-bg-dark text-white font-main leading-[1.6] overflow-x-hidden ${bodyClass}`}
    >
        <Header activeNav={activeNav} />

        <main>
            <slot />
        </main>

        <Footer customStyle={footerStyle} />

        <script type="text/javascript" is:inline>
            (function (d, t) {
                var v = d.createElement(t),
                    s = d.getElementsByTagName(t)[0];
                v.onload = function () {
                    window.voiceflow.chat.load({
                        verify: { projectID: "693b13be70471ab1f2a6eab6" },
                        url: "https://general-runtime.voiceflow.com",
                        versionID: "production",
                        voice: {
                            url: "https://runtime-api.voiceflow.com",
                        },
                    });
                };
                v.src = "https://cdn.voiceflow.com/widget-next/bundle.mjs";
                v.type = "text/javascript";
                s.parentNode.insertBefore(v, s);
            })(document, "script");
        </script>
    </body>
</html>
