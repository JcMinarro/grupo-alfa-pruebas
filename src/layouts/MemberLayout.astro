---
import BaseLayout from './BaseLayout.astro';
import MemberNav from '../components/MemberNav.astro';

const { title, activePath = '/members' } = Astro.props;
---

<BaseLayout title={title} bodyClass="members-page bg-[#0f1012] text-white">
    <section class="pt-32 pb-8 px-4 border-b border-white/10 bg-[#121316]">
        <div class="max-w-[1200px] mx-auto">
            <p class="text-primary uppercase tracking-[4px] text-sm font-bold mb-3">Club Alfa</p>
            <h1 class="text-[2.4rem] md:text-[3.4rem] font-bold">{title}</h1>
        </div>
    </section>
    <MemberNav activePath={activePath} />
    <main class="max-w-[1200px] mx-auto px-4 py-12">
        <slot />
    </main>
</BaseLayout>
