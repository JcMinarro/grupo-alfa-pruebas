---
import ProjectLayout from "../layouts/ProjectLayout.astro";
---

<ProjectLayout
    title="Flip House | Grupo Alfa"
    bodyClass="flip-house-page"
    footerStyle="background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)), url('/assets/lab/lab-footer-bg.jpg') no-repeat center center/cover;"
>
    <section class="project-hero">
        <div class="hero-content fade-in">
            <p class="hero-location">MURCIA</p>
            <h1>Flip House Urbano</h1>
        </div>
    </section>

    <section class="project-details fade-in">
        <a href="/proyectos" class="back-link">← Volver a Proyectos</a>

        <div class="detail-section" style="margin-top: 40px;">
            <h2>Detalles del Proyecto</h2>
            <div class="info-grid">
                <div class="info-card">
                    <h4>Tipo de activo</h4>
                    <p>Piso para reforma (2ª planta)</p>
                </div>
                <div class="info-card">
                    <h4>Ubicación</h4>
                    <p>Murcia Centro</p>
                </div>
                <div class="info-card">
                    <h4>Superficie</h4>
                    <p>90 m²</p>
                </div>
                <div class="info-card">
                    <h4>Estrategia</h4>
                    <p>Reforma integral para reventa (Flip)</p>
                </div>
            </div>
        </div>

        <div class="detail-section">
            <h2>Costes del Proyecto</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Concepto</th>
                        <th>Importe</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Compra del Inmueble</td>
                        <td>105.000 €</td>
                    </tr>
                    <tr>
                        <td>Reforma Integral</td>
                        <td>30.000 €</td>
                    </tr>
                    <tr>
                        <td>Licencias y Arquitecto</td>
                        <td>5.000 €</td>
                    </tr>
                    <tr>
                        <td>Amueblamiento Básico</td>
                        <td>5.000 €</td>
                    </tr>
                    <tr>
                        <td>Costes Imprevistos y Cierre</td>
                        <td>5.000 €</td>
                    </tr>
                    <tr>
                        <td><strong>Inversión Total</strong></td>
                        <td><strong>150.000 €</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="detail-section">
            <h2>Rentabilidad</h2>
            <div
                style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px;"
            >
                <!-- Rentabilidad por Venta -->
                <div
                    class="info-card"
                    style="background: #fff; border: 1px solid #eee;"
                >
                    <h3 style="font-size: 1.5rem; margin-bottom: 20px;">
                        Por Venta
                    </h3>
                    <ul
                        style="list-style: none; padding: 0; margin-bottom: 20px;"
                    >
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>Precio Venta Tras Reforma</span>
                            <strong>210.000 €</strong>
                        </li>
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>Beneficio Neto est.</span>
                            <strong>60.000 €</strong>
                        </li>
                    </ul>
                    <div
                        style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #eee; padding-top: 15px;"
                    >
                        <span>ROI Neto:</span>
                        <span class="roi-badge highlight">40,00 %</span>
                    </div>
                </div>

                <!-- Rentabilidad por Alquiler -->
                <div
                    class="info-card"
                    style="background: #fff; border: 1px solid #eee; opacity: 0.6;"
                >
                    <h3 style="font-size: 1.5rem; margin-bottom: 20px;">
                        Por Alquiler
                    </h3>
                    <p
                        style="font-style: italic; color: #666; margin-bottom: 20px;"
                    >
                        Este modelo no está optimizado para alquiler. La
                        rentabilidad por alquiler tradicional es baja comparada
                        con el potencial de reventa.
                    </p>
                </div>
            </div>
        </div>

        <div class="executive-summary">
            <h3>Resumen Ejecutivo</h3>
            <p>
                Proyecto orientado a revalorización. La vivienda se reforma
                íntegramente para su venta en corto plazo. Ideal para inversores
                centrados en operaciones tipo flip.
            </p>
        </div>

        <div style="text-align: center; margin-top: 60px;">
            <a
                href="/#contacto"
                class="btn-primary"
                style="background-color: var(--flip-accent); color: #000; padding: 15px 40px; text-decoration: none; border-radius: 50px; font-weight: 700; display: inline-block;"
                >ME INTERESA ESTE MODELO</a
            >
        </div>
    </section>
</ProjectLayout>
