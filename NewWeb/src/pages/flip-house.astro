---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import ProjectLayout from "../layouts/ProjectLayout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ProjectLayout
    title={`Flip House | ${t("brand.name")}`}
    bodyClass="flip-house-page"
    footerStyle="background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)), url('/assets/lab/lab-footer-bg.jpg') no-repeat center center/cover;"
>
    <section class="project-hero">
        <div class="hero-content fade-in">
            <p class="hero-location">MURCIA</p>
            <h1>{t("projects.fliphouse.title")}</h1>
        </div>
    </section>

    <section class="project-details fade-in">
        <a href="/proyectos" class="back-link">{t("projects.back")}</a>

        <div class="detail-section" style="margin-top: 40px;">
            <h2>{t("projects.details.title")}</h2>
            <div class="info-grid">
                <div class="info-card">
                    <h4>{t("projects.common.details.type")}</h4>
                    <p>{t("projects.fliphouse.details.type")}</p>
                </div>
                <div class="info-card">
                    <h4>{t("projects.common.details.location")}</h4>
                    <p>{t("projects.fliphouse.details.location")}</p>
                </div>
                <div class="info-card">
                    <h4>{t("projects.common.details.surface")}</h4>
                    <p>90 m²</p>
                </div>
                <div class="info-card">
                    <h4>
                        {t("projects.common.details.strategy") || "Estrategia"}
                    </h4>
                    <p>{t("projects.fliphouse.details.strategy")}</p>
                </div>
            </div>
        </div>

        <div class="detail-section">
            <h2>{t("projects.division.costs.title")}</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>{t("contact.form.message") || "Concepto"}</th>
                        <th>{t("projects.costs.total") || "Importe"}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{t("projects.common.costs.compra")}</td>
                        <td>105.000 €</td>
                    </tr>
                    <tr>
                        <td>{t("projects.common.costs.reforma")}</td>
                        <td>30.000 €</td>
                    </tr>
                    <tr>
                        <td>{t("projects.common.costs.licencias")}</td>
                        <td>5.000 €</td>
                    </tr>
                    <tr>
                        <td>{t("projects.common.costs.muebles")}</td>
                        <td>5.000 €</td>
                    </tr>
                    <tr>
                        <td>{t("projects.chalet.costs.imprevistos")}</td>
                        <td>5.000 €</td>
                    </tr>
                    <tr>
                        <td
                            ><strong
                                >{
                                    t("projects.costs.total") ||
                                        "Inversión Total"
                                }</strong
                            ></td
                        >
                        <td><strong>150.000 €</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="detail-section">
            <h2>{t("projects.division.roi.title")}</h2>
            <div
                style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px;"
            >
                <!-- Rentabilidad por Venta -->
                <div
                    class="info-card"
                    style="background: #fff; border: 1px solid #eee;"
                >
                    <h3 style="font-size: 1.5rem; margin-bottom: 20px;">
                        {t("projects.division.roi.sale.label")}
                    </h3>
                    <ul
                        style="list-style: none; padding: 0; margin-bottom: 20px;"
                    >
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>{t("projects.fliphouse.roi.sale.price")}</span
                            >
                            <strong>210.000 €</strong>
                        </li>
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>{t("projects.division.roi.sale.profit")}</span
                            >
                            <strong>60.000 €</strong>
                        </li>
                    </ul>
                    <div
                        style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #eee; padding-top: 15px;"
                    >
                        <span>{t("projects.division.roi.net")}</span>
                        <span class="roi-badge highlight">40,00 %</span>
                    </div>
                </div>

                <!-- Rentabilidad por Alquiler -->
                <div
                    class="info-card"
                    style="background: #fff; border: 1px solid #eee; opacity: 0.6;"
                >
                    <h3 style="font-size: 1.5rem; margin-bottom: 20px;">
                        {t("projects.division.roi.rent.label")}
                    </h3>
                    <p
                        style="font-style: italic; color: #666; margin-bottom: 20px;"
                    >
                        {t("projects.fliphouse.roi.rent.description")}
                    </p>
                </div>
            </div>
        </div>

        <div class="executive-summary">
            <h3>{t("projects.executiveSummary")}</h3>
            <p>
                {t("projects.fliphouse.summary")}
            </p>
        </div>

        <div style="text-align: center; margin-top: 60px;">
            <a
                href="/#contacto"
                class="btn-primary"
                style="background-color: var(--flip-accent); color: #000; padding: 15px 40px; text-decoration: none; border-radius: 50px; font-weight: 700; display: inline-block;"
                >{t("projects.interested")}</a
            >
        </div>
    </section>
</ProjectLayout>
