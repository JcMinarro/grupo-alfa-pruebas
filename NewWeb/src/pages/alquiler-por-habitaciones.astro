---
import ProjectLayout from "../layouts/ProjectLayout.astro";
---

<ProjectLayout
    title="Alquiler por Habitaciones | Grupo Alfa"
    bodyClass="rooms-page"
    footerStyle="background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)), url('/assets/lab/lab-footer-bg.jpg') no-repeat center center/cover;"
>
    <link slot="head" rel="stylesheet" href="/src/styles/rooms.css" />

    <section class="project-hero">
        <div class="hero-content fade-in">
            <p class="hero-location">MADRID</p>
            <h1>Vivienda para Alquiler por Habitaciones</h1>
        </div>
    </section>

    <section class="project-details fade-in">
        <a href="/proyectos" class="back-link">← Volver a Proyectos</a>

        <div class="detail-section" style="margin-top: 40px;">
            <h2>Detalles del Proyecto</h2>
            <div class="info-grid">
                <div class="info-card">
                    <h4>Tipo de activo</h4>
                    <p>Piso amplio (110 m²)</p>
                </div>
                <div class="info-card">
                    <h4>Ubicación</h4>
                    <p>Madrid, zona universitaria</p>
                </div>
                <div class="info-card">
                    <h4>Distribución</h4>
                    <p>5 Habitaciones + 2 Baños</p>
                </div>
                <div class="info-card">
                    <h4>Extras</h4>
                    <p>Zonas Comunes</p>
                </div>
            </div>
        </div>

        <div class="detail-section">
            <h2>Costes del Proyecto</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Concepto</th>
                        <th>Importe</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Compra del Inmueble</td>
                        <td>195.000 €</td>
                    </tr>
                    <tr>
                        <td>Reforma Integral</td>
                        <td>45.000 €</td>
                    </tr>
                    <tr>
                        <td>Licencias y Arquitecto</td>
                        <td>10.000 €</td>
                    </tr>
                    <tr>
                        <td>Amueblamiento Básico</td>
                        <td>10.000 €</td>
                    </tr>
                    <tr>
                        <td><strong>Inversión Total</strong></td>
                        <td><strong>260.000 €</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="detail-section">
            <h2>Rentabilidad</h2>
            <div
                style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px;"
            >
                <!-- Rentabilidad por Venta -->
                <div
                    class="info-card"
                    style="background: #fff; border: 1px solid #eee;"
                >
                    <h3 style="font-size: 1.5rem; margin-bottom: 20px;">
                        Por Venta
                    </h3>
                    <ul
                        style="list-style: none; padding: 0; margin-bottom: 20px;"
                    >
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>Venta Piso (Rentado)</span>
                            <strong>345.000 €</strong>
                        </li>
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>Beneficio Neto est.</span>
                            <strong>85.000 €</strong>
                        </li>
                    </ul>
                    <div
                        style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #eee; padding-top: 15px;"
                    >
                        <span>ROI Neto:</span>
                        <span class="roi-badge">32,69 %</span>
                    </div>
                </div>

                <!-- Rentabilidad por Alquiler -->
                <div
                    class="info-card"
                    style="background: #fff; border: 1px solid #eee;"
                >
                    <h3 style="font-size: 1.5rem; margin-bottom: 20px;">
                        Por Alquiler
                    </h3>
                    <ul
                        style="list-style: none; padding: 0; margin-bottom: 20px;"
                    >
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>Alquiler Mensual/hab.</span>
                            <strong>750 €</strong>
                        </li>
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>Ingresos Anuales</span>
                            <strong>45.000 €</strong>
                        </li>
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between; color: #666;"
                        >
                            <span>Gastos Operativos (15%)</span>
                            <span>-6.750 €</span>
                        </li>
                    </ul>
                    <div
                        style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #eee; padding-top: 15px;"
                    >
                        <span>ROI Neto:</span>
                        <span class="roi-badge">14,71 %</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="executive-summary">
            <h3>Resumen Ejecutivo</h3>
            <p>
                Modelo excelente de rentabilidad intensiva. Rentabilidad muy
                alta en alquiler y atractiva reventa como activo en explotación.
                En zonas universitarias es una apuesta sólida.
            </p>
        </div>

        <div style="text-align: center; margin-top: 60px;">
            <a
                href="/#contacto"
                class="btn-primary"
                style="background-color: var(--rooms-accent); color: #000; padding: 15px 40px; text-decoration: none; border-radius: 50px; font-weight: 700; display: inline-block;"
                >ME INTERESA ESTE MODELO</a
            >
        </div>
    </section>
</ProjectLayout>
