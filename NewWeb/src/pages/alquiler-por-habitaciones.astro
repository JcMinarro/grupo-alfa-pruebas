---
import ProjectLayout from "../layouts/ProjectLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectDetails from "../components/project/ProjectDetails.astro";
import ProjectFinancials from "../components/project/ProjectFinancials.astro";
import ProjectROI from "../components/project/ProjectROI.astro";
---

<ProjectLayout
    title="Alquiler por Habitaciones | Grupo Alfa"
    bodyClass="rooms-page"
>
    <Hero
        title="Vivienda para Alquiler por Habitaciones"
        location="MADRID"
        backgroundImage="/assets/photo-1616046229478-9901c5536a456111.jpg"
        height="50vh"
    />

    <section class="project-details container fade-in">
        <a href="/proyectos" class="back-link">← Volver a Proyectos</a>

        <h2>Detalles del Proyecto</h2>
        <ProjectDetails
            type="Piso amplio (110 m²)"
            location="Madrid, zona universitaria"
            distribution="5 Habitaciones + 2 Baños"
        />

        <ProjectFinancials
            costs={[
                { concept: "Compra del Inmueble", amount: "195.000 €" },
                { concept: "Reforma Integral", amount: "45.000 €" },
                { concept: "Licencias y Arquitecto", amount: "10.000 €" },
                { concept: "Amueblamiento Básico", amount: "10.000 €" },
            ]}
            total="260.000 €"
        />

        <ProjectROI
            strategy="both"
            saleData={{
                price: "345.000 € (Rentado)",
                profit: "85.000 € (neto est.)",
                roi: "32,69 %",
            }}
            rentData={{
                monthly: "750 € (x hab)",
                annual: "45.000 €",
                roi: "14,71 %",
            }}
        />

        <div class="executive-summary">
            <h3>Resumen Ejecutivo</h3>
            <p>
                Modelo excelente de rentabilidad intensiva. Rentabilidad muy
                alta en alquiler y atractiva reventa como activo en explotación.
                En zonas universitarias es una apuesta sólida.
            </p>
        </div>

        <div style="text-align: center; margin-top: 60px;">
            <a
                href="/#contacto"
                class="btn-primary"
                style="background-color: var(--color-primary); color: #000; padding: 15px 40px; text-decoration: none; border-radius: 50px; font-weight: 700; display: inline-block;"
                >ME INTERESA ESTE MODELO</a
            >
        </div>
    </section>
</ProjectLayout>
