---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Flip Art | Grupo Alfa"
    bodyClass="flip-art-page"
    footerStyle="background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)), url('/assets/lab/lab-footer-bg.jpg') no-repeat center center/cover;"
>
    <section class="flip-hero fade-in">
        <div class="container">
            <h1>FLIP <span>ART</span></h1>
            <p
                style="font-size: 1.5rem; letter-spacing: 2px; text-transform: uppercase; margin-top: 20px; opacity: 0.8;"
            >
                El arte de transformar espacios
            </p>
        </div>
    </section>

    <section class="flip-content fade-in">
        <p class="flip-intro">
            En Grupo Alfa, entendemos el "Flipping" no solo como una inversión,
            sino como un arte.
            <br /><strong>Flip Art</strong> es nuestra división dedicada a la excelencia
            estética y funcional en cada reforma.
        </p>

        <div class="art-grid">
            <div
                class="art-card"
                style="background-image: url('/assets/projects/project1.jpg'); background-size: cover; color: transparent;"
            >
                Diseño
            </div>
            <div
                class="art-card"
                style="background-image: url('/assets/projects/project2.jpg'); background-size: cover; color: transparent;"
            >
                Calidad
            </div>
            <div
                class="art-card"
                style="background-image: url('/assets/projects/project3.jpg'); background-size: cover; color: transparent;"
            >
                Detalle
            </div>
        </div>

        <div style="margin-top: 60px;">
            <a href="/#submarcas" class="btn-back">VOLVER</a>
        </div>
    </section>
</BaseLayout>
