---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
    title={`ALFA LAB | ${t("brand.name")}`}
    bodyClass="lab-page"
    footerStyle="background: #1d1e20; color: #fff; padding: 60px 0;"
>
    <link
        slot="head"
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Krona+One&display=swap"
    />
    <link
        slot="head"
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Krona+One&display=swap"
    />

    <main class="lab-container">
        <div
            class="lab-logos fade-in"
            style="display: flex; gap: 40px; align-items: center; justify-content: center; margin-bottom: 40px;"
        >
            <img
                src="/assets/logo-alfa-wolf.png"
                alt={t("brand.name")}
                style="height: 60px; filter: brightness(0) invert(1);"
            />
            <img
                src="/assets/logo-alfa-wolf.png"
                alt={t("brand.name")}
                style="height: 40px; filter: brightness(0) invert(1);"
            />
        </div>

        <section class="lab-content fade-in">
            <h1>{t("lab.title")}</h1>

            <div class="lab-description">
                <p>
                    <strong>{t("lab.p1.strong")}</strong>{t("lab.p1.text")}
                </p>
                <p>
                    {t("lab.p2.text1")}<strong>{t("lab.p2.strong")}</strong>{
                        t("lab.p2.text2")
                    }
                </p>
                <ul>
                    <li>
                        <strong>{t("lab.feature1.strong")}</strong>{
                            t("lab.feature1.text")
                        }
                    </li>
                    <li>
                        <strong>{t("lab.feature2.strong")}</strong>{
                            t("lab.feature2.text")
                        }
                    </li>
                    <li>
                        <strong>{t("lab.feature3.strong")}</strong>{
                            t("lab.feature3.text")
                        }
                    </li>
                    <li>
                        <strong>{t("lab.feature4.strong")}</strong>{
                            t("lab.feature4.text")
                        }
                    </li>
                    <li>
                        <strong>{t("lab.feature5.strong")}</strong>{
                            t("lab.feature5.text")
                        }
                    </li>
                    <li>
                        <strong>{t("lab.feature6.strong")}</strong>{
                            t("lab.feature6.text")
                        }
                    </li>
                </ul>
                <p>
                    {t("lab.p3.text")}
                </p>
                <p>
                    {t("lab.p4.text")}
                </p>
            </div>

            <a href="/#servicios" class="btn-volver"
                >{t("common.back").toUpperCase()}</a
            >
        </section>
    </main>
</BaseLayout>
