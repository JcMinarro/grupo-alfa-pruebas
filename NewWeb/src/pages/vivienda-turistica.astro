---
import ProjectLayout from "../layouts/ProjectLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectDetails from "../components/project/ProjectDetails.astro";
import ProjectFinancials from "../components/project/ProjectFinancials.astro";
import ProjectROI from "../components/project/ProjectROI.astro";
---

<ProjectLayout title="Vivienda Turística | Grupo Alfa" bodyClass="tourism-page">
    <Hero
        title="Vivienda Antigua transformada en Vivienda Turística"
        location="ÁGUILAS, MURCIA"
        backgroundImage="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
        height="50vh"
    />

    <section class="project-details container fade-in">
        <a href="/proyectos" class="back-link">← Volver a Proyectos</a>

        <h2>Detalles del Proyecto</h2>
        <ProjectDetails
            type="Vivienda Unifamiliar"
            location="Costa de Águilas, Murcia"
            surface="85 m²"
            distribution="2 Dormitorios + Solárium"
        />

        <div
            class="tourism-images"
            style="margin: 40px 0; display: grid; grid-template-columns: 1fr 1fr; gap: 20px;"
        >
            <div class="image-item">
                <p style="font-weight: 700; margin-bottom: 10px;">ANTES</p>
                <img
                    src="/assets/photo-1616046229478-9901c5536a456111.jpg"
                    alt="Antes"
                    style="width: 100%; border-radius: 8px;"
                />
            </div>
            <div class="image-item">
                <p style="font-weight: 700; margin-bottom: 10px;">DESPUÉS</p>
                <img
                    src="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
                    alt="Después"
                    style="width: 100%; border-radius: 8px;"
                />
            </div>
        </div>

        <ProjectFinancials
            costs={[
                { concept: "Compra del Inmueble", amount: "115.000 €" },
                { concept: "Reforma y Equipamiento", amount: "35.000 €" },
                { concept: "Licencias y Gestión", amount: "8.000 €" },
            ]}
            total="158.000 €"
        />

        <ProjectROI
            strategy="rent"
            rentData={{
                monthly: "110 € / noche (media)",
                annual: "24.500 € (neta est.)",
                roi: "15,50 %",
            }}
        />

        <div class="executive-summary">
            <h3>Resumen Ejecutivo</h3>
            <p>
                Las viviendas turísticas representan una de las inversiones más
                rentables y líquidas en el sector inmobiliario actual. En zonas
                costeras como Águilas, la demanda es constante y la rentabilidad
                neta supera con creces el alquiler tradicional.
            </p>
        </div>

        <div style="text-align: center; margin-top: 60px;">
            <a
                href="/#contacto"
                class="btn-primary"
                style="background-color: var(--color-primary); color: #000; padding: 15px 40px; text-decoration: none; border-radius: 50px; font-weight: 700; display: inline-block;"
                >ME INTERESA ESTE MODELO</a
            >
        </div>
    </section>
</ProjectLayout>
