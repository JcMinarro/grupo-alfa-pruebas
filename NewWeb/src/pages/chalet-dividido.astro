---
import ProjectLayout from "../layouts/ProjectLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectDetails from "../components/project/ProjectDetails.astro";
import ProjectFinancials from "../components/project/ProjectFinancials.astro";
import ProjectROI from "../components/project/ProjectROI.astro";
---

<ProjectLayout title="Chalet Dividido | Grupo Alfa" bodyClass="chalet-page">
    <Hero
        title="Chalet dividido en 2 Viviendas"
        location="ALICANTE"
        backgroundImage="/assets/whatsapp-image-2025-08-01-at-17.09.17-dWxOKaxe5VIGjv0Y.jpg"
        height="50vh"
    />

    <section class="project-details container fade-in">
        <a href="/proyectos" class="back-link">← Volver a Proyectos</a>

        <h2>Detalles del Proyecto</h2>
        <ProjectDetails
            type="Chalet"
            location="Periferia Urbana de Alicante"
            surface="140 m²"
            distribution="2 Viviendas Independientes"
        />

        <ProjectFinancials
            costs={[
                { concept: "Compra del Inmueble", amount: "140.000 €" },
                { concept: "Reforma Integral", amount: "55.000 €" },
                { concept: "Licencias y Arquitecto", amount: "15.000 €" },
                { concept: "Amueblamiento Básico", amount: "10.000 €" },
                { concept: "Costes Imprevistos y Cierre", amount: "10.000 €" },
            ]}
            total="230.000 €"
        />

        <ProjectROI
            strategy="both"
            saleData={{
                price: "155.000 € (x unidad)",
                profit: "80.000 € (neto est.)",
                roi: "34,78 %",
            }}
            rentData={{
                monthly: "850 € (x unidad)",
                annual: "20.400 €",
                roi: "7,98 %",
            }}
        />

        <div class="executive-summary">
            <h3>Resumen Ejecutivo</h3>
            <p>
                Alta rentabilidad por venta. Alquiler ligeramente por debajo del
                umbral del 8 %, pero estable. Interesante para estrategias de
                venta por separado o alquiler vacacional.
            </p>
        </div>

        <div style="text-align: center; margin-top: 60px;">
            <a
                href="/#contacto"
                class="btn-primary"
                style="background-color: var(--color-primary); color: #000; padding: 15px 40px; text-decoration: none; border-radius: 50px; font-weight: 700; display: inline-block;"
                >ME INTERESA ESTE MODELO</a
            >
        </div>
    </section>
</ProjectLayout>
