---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ContactForm from "../components/ContactForm.astro";
---

<BaseLayout title="Contacto | Grupo Alfa" bodyClass="contact-page">
    <Hero
        title="CONTÁCTANOS"
        subtitle="Responderemos encantados a su consulta a la mayor brevedad posible."
        backgroundImage="/assets/whatsapp-image-2025-08-01-at-17.09.16-YbNJVMNBJQt0a97a.jpg"
        height="50vh"
    />

    <section class="contact-wrapper fade-in">
        <div class="contact-info">
            <h2>NUESTRA OFICINA</h2>

            <div class="info-item">
                <h3>Dirección</h3>
                <p>C/ Conde del Valle de San Juan, 1</p>
                <p>(Gran Vía Escultor Salzillo, 1)</p>
                <p>30004, Murcia</p>
            </div>

            <div class="info-item">
                <h3>Email</h3>
                <p>
                    <a
                        href="mailto:info@grupoalfa.net"
                        style="color: inherit; text-decoration: none;"
                        >info@grupoalfa.net</a
                    >
                </p>
                <p>
                    <a
                        href="mailto:joseantonio@grupoalfa.net"
                        style="color: inherit; text-decoration: none;"
                        >joseantonio@grupoalfa.net</a
                    >
                </p>
                <p>
                    <a
                        href="mailto:luciomerlini@grupoalfa.net"
                        style="color: inherit; text-decoration: none;"
                        >luciomerlini@grupoalfa.net</a
                    >
                </p>
            </div>

            <div class="info-item">
                <h3>Horario</h3>
                <p>Lunes - Viernes: 9:00 - 14:00 | 16:00 - 20:00</p>
            </div>
        </div>

        <div class="contact-form-container">
            <ContactForm showPhone={true} showPrivacy={true} theme="light" />
        </div>
    </section>

    <section class="map-section fade-in">
        <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3143.6062835955677!2d-1.1325456846755864!3d37.98399597972186!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd6382106318991d%3A0x6d116248c821104e!2sC.%20Conde%20del%20Valle%20de%20San%20Juan%2C%201%2C%2030004%20Murcia!5e0!3m2!1ses!2ses!4v1684318723521!5m2!1ses!2ses"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
    </section>
</BaseLayout>
