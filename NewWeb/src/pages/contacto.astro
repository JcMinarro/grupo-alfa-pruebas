---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Contacto | Grupo Alfa"
    bodyClass="contact-page"
    footerStyle="background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)), url('/assets/lab/lab-footer-bg.jpg') no-repeat center center/cover;"
>
    <link slot="head" rel="stylesheet" href="/src/styles/contact.css" />

    <section class="contact-hero fade-in">
        <div class="container">
            <h1>CONTÁCTANOS</h1>
            <p>
                Responderemos encantados a su consulta a la mayor brevedad
                posible.
            </p>
        </div>
    </section>

    <section class="contact-wrapper fade-in">
        <div class="contact-info">
            <h2>NUESTRA OFICINA</h2>

            <div class="info-item">
                <h3>Dirección</h3>
                <p>C/ Conde del Valle de San Juan, 1</p>
                <p>(Gran Vía Escultor Salzillo, 1)</p>
                <p>30004, Murcia</p>
            </div>

            <div class="info-item">
                <h3>Email</h3>
                <p>
                    <a
                        href="mailto:info@grupoalfa.net"
                        style="color: inherit; text-decoration: none;"
                        >info@grupoalfa.net</a>
                </p>
                <p>
                    <a
                        href="mailto:joseantonio@grupoalfa.net"
                        style="color: inherit; text-decoration: none;"
                        >joseantonio@grupoalfa.net</a>
                </p>
                <p>
                    <a
                        href="mailto:luciomerlini@grupoalfa.net"
                        style="color: inherit; text-decoration: none;"
                        >luciomerlini@grupoalfa.net</a>
                </p>
            </div>

            <div class="info-item">
                <h3>Horario</h3>
                <p>Lunes - Viernes: 9:00 - 14:00 | 16:00 - 20:00</p>
            </div>
        </div>

        <div class="contact-form-container">
            <form action="#" method="POST">
                <div class="form-group">
                    <label for="name">Nombre *</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        class="form-control"
                        required
                    />
                </div>

                <div class="form-group">
                    <label for="email">Email *</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="form-control"
                        required
                    />
                </div>

                <div class="form-group">
                    <label for="phone">Teléfono</label>
                    <input
                        type="tel"
                        id="phone"
                        name="phone"
                        class="form-control"
                    />
                </div>

                <div class="form-group">
                    <label for="message">Mensaje</label>
                    <textarea id="message" name="message" class="form-control"
                    ></textarea>
                </div>

                <div
                    class="form-group"
                    style="display: flex; align-items: start; gap: 10px;"
                >
                    <input
                        type="checkbox"
                        id="privacy"
                        name="privacy"
                        required
                        style="margin-top: 5px;"
                    />
                    <label
                        for="privacy"
                        style="font-weight: 400; font-size: 0.9rem;"
                    >
                        Acepto la política de privacidad y el tratamiento de mis
                        datos.
                    </label>
                </div>

                <button type="submit" class="btn-submit">ENVIAR</button>
            </form>
        </div>
    </section>

    <section class="map-section fade-in">
        <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3143.6062835955677!2d-1.1325456846755864!3d37.98399597972186!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd6382106318991d%3A0x6d116248c821104e!2sC.%20Conde%20del%20Valle%20de%20San%20Juan%2C%201%2C%2030004%20Murcia!5e0!3m2!1ses!2ses!4v1684318723521!5m2!1ses!2ses"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
    </section>
</BaseLayout>
