---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={`Alfa Clean | ${t("brand.name")}`} bodyClass="clean-page">
    <style slot="head">
        body {
            font-family: "DM Sans", sans-serif;
            background-color: #000;
        }

        .site-header {
            background-color: #fff;
        }
    </style>

    <main class="container" style="padding: 80px 0;">
        <div class="clean-content-box fade-in">
            <div
                class="clean-logo-section"
                style="text-align: center; margin-bottom: 40px;"
            >
                <img
                    src="/assets/logo-alfa-wolf.png"
                    alt={t("clean.logo.white.alt")}
                    style="height: 60px; filter: brightness(0) invert(1);"
                />
            </div>

            <div class="clean-text-section">
                <h1>
                    {t("clean.title.prefix")}
                    <span>{t("clean.title.name")}</span>
                </h1>

                <div class="clean-services-grid">
                    <div class="clean-service-item">
                        <img
                            src="/assets/edificio-YX4x1WW477Irx3p5.png"
                            alt={t("clean.service.communities")}
                        />
                        <p>{t("clean.service.communities")}</p>
                    </div>
                    <div class="clean-service-item">
                        <img
                            src="/assets/buscar-casa-YanJ6aBZVKc969wa.png"
                            alt={t("clean.service.private")}
                        />
                        <p>{t("clean.service.private")}</p>
                    </div>
                    <div class="clean-service-item">
                        <img
                            src="/assets/flecha-abajo-AzGN41EZW0T39oZP.png"
                            alt={t("clean.service.vacation")}
                            style="transform: rotate(-90deg);"
                        />
                        <p>{t("clean.service.vacation")}</p>
                    </div>
                </div>

                <div class="clean-description">
                    <p>
                        {t("clean.description")}
                    </p>
                </div>

                <a href="/#servicios" class="clean-volver">{t("common.back")}</a
                >
            </div>
        </div>
    </main>
</BaseLayout>
