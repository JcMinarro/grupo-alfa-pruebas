---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={`Promotores | ${t("brand.name")}`} bodyClass="promoter-page">
    <Hero
        title={t("promotores.hero.title")}
        subtitle={t("promotores.hero.subtitle")}
        backgroundImage="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
        height="50vh"
    >
        <p
            class="promoter-intro"
            style="margin-top: 20px; font-size: 1.1rem; opacity: 0.9;"
        >
            {t("promotores.hero.description")}
        </p>
    </Hero>

    <section class="promoter-container fade-in">
        <h2 style="font-size: 2rem; margin-bottom: 40px; text-align: center;">
            {t("promotores.intro.title")}
        </h2>

        <div class="promoter-services-list">
            <div class="service-item">
                <h3>{t("promotores.service1")}</h3>
            </div>
            <div class="service-item">
                <h3>{t("promotores.service2")}</h3>
            </div>
            <div class="service-item">
                <h3>{t("promotores.service3")}</h3>
            </div>
            <div class="service-item">
                <h3>{t("promotores.service4")}</h3>
            </div>
        </div>
    </section>

    <section class="value-prop fade-in">
        <div class="container" style="text-align: center;">
            <h2>
                {t("promotores.cta.text")}
            </h2>
            <a href="/#contacto" class="btn-promoter"
                >{t("promotores.cta.button")}</a
            >
        </div>
    </section>
</BaseLayout>
