---
import ProjectLayout from "../layouts/ProjectLayout.astro";
import Hero from "../components/Hero.astro";
import InfoGrid from "../components/InfoGrid.astro";
import GridItem from "../components/GridItem.astro";
---

<ProjectLayout title="Inversores | Grupo Alfa" bodyClass="investor-page">
    <Hero
        title="INVERSORES"
        subtitle="TU DINERO, TRABAJANDO SIN DESCANSO"
        backgroundImage="/assets/photo-1707903244219-8ed71537554d3d83.jpg"
        height="50vh"
    />

    <section class="project-details container fade-in">
        <h2
            class="section-title"
            style="margin-bottom: 60px; text-align: center;"
        >
            Paso a paso de una inversión con Grupo Alfa
        </h2>

        <InfoGrid columns={3}>
            <GridItem
                title="ASESORÍA GRATUITA"
                description="Analizamos tus objetivos financieros y tolerancia al riesgo."
                number="01"
            />
            <GridItem
                title="OFERTA DE INMUEBLES"
                description="Seleccionamos las mejores oportunidades del mercado."
                number="02"
            />
            <GridItem
                title="FINANCIACIÓN"
                description="Buscamos las mejores condiciones hipotecarias para ti."
                number="03"
            />
            <GridItem
                title="REFORMA E INTERIORISMO"
                description="Maximizamos el valor del activo antes de comercializarlo."
                number="04"
            />
            <GridItem
                title="RENTABILIDAD ACTIVA"
                description="Ejecutamos la estrategia definida para generar ingresos."
                number="05"
            />
            <GridItem
                title="GESTIÓN PASIVA"
                description="Gestión integral para que tu inversión sea 100% pasiva."
                number="06"
            />
        </InfoGrid>

        <div style="text-align: center; margin-top: 80px;">
            <a href="/contacto" class="btn-primary">QUIERO EMPEZAR A INVERTIR</a>
        </div>
    </section>
</ProjectLayout>
