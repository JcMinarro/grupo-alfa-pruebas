---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import ProjectLayout from "../layouts/ProjectLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectDetails from "../components/project/ProjectDetails.astro";
import InfoGrid from "../components/InfoGrid.astro";
import GridItem from "../components/GridItem.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ProjectLayout
    title={`Local Comercial | ${t("brand.name")}`}
    bodyClass="premises-page"
>
    <Hero
        title={t("projects.local.title")}
        location="MURCIA"
        backgroundImage="/assets/photo-1616046229478-9901c5536a456111.jpg"
        height="50vh"
    />

    <section class="project-details container fade-in">
        <a href="/proyectos" class="back-link">{t("projects.back")}</a>

        <h2>{t("projects.details.title")}</h2>
        <ProjectDetails
            type={t("projects.local.details.type")}
            location={t("projects.local.details.location")}
            surface="120 m²"
            distribution={t("projects.local.details.distribution")}
        />

        <h2 style="margin-top: 60px;">
            {t("projects.local.transformation.title")}
        </h2>
        <InfoGrid columns={3}>
            <GridItem
                title={t("projects.local.transformation.step1.title")}
                description={t("projects.local.transformation.step1.desc")}
                number="01"
            />
            <GridItem
                title={t("projects.local.transformation.step2.title")}
                description={t("projects.local.transformation.step2.desc")}
                number="02"
            />
            <GridItem
                title={t("projects.local.transformation.step3.title")}
                description={t("projects.local.transformation.step3.desc")}
                number="03"
            />
        </InfoGrid>
    </section>
</ProjectLayout>
