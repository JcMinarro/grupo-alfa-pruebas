---
import ProjectLayout from "../layouts/ProjectLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectDetails from "../components/project/ProjectDetails.astro";
import InfoGrid from "../components/InfoGrid.astro";
import GridItem from "../components/GridItem.astro";
---

<ProjectLayout title="Local Comercial | Grupo Alfa" bodyClass="premises-page">
    <Hero
        title="Local Comercial convertido en Estudios"
        location="MURCIA"
        backgroundImage="/assets/photo-1616046229478-9901c5536a456111.jpg"
        height="50vh"
    />

    <section class="project-details container fade-in">
        <a href="/proyectos" class="back-link">← Volver a Proyectos</a>

        <h2>Detalles del Proyecto</h2>
        <ProjectDetails
            type="Bajo Comercial"
            location="Zona Urbana de Murcia"
            surface="120 m²"
            distribution="3 Estudios de 40 m²"
        />

        <h2 style="margin-top: 60px;">Transformación Eficiente</h2>
        <InfoGrid columns={3}>
            <GridItem
                title="ESTUDIO DE VIABILIDAD"
                description="Análisis técnico y normativo para el cambio de uso."
                number="01"
            />
            <GridItem
                title="DISEÑO OPTIMIZADO"
                description="Máximo aprovechamiento del espacio para confort."
                number="02"
            />
            <GridItem
                title="EJECUCIÓN INTEGRAL"
                description="Obra llave en mano con acabados de alta calidad."
                number="03"
            />
        </InfoGrid>
    </section>
</ProjectLayout>
