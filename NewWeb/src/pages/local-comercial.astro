---
import ProjectLayout from "../layouts/ProjectLayout.astro";
---

<ProjectLayout
    title="Local Comercial | Grupo Alfa"
    bodyClass="premises-page"
    footerStyle="background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)), url('/assets/lab/lab-footer-bg.jpg') no-repeat center center/cover;"
>
    <link slot="head" rel="stylesheet" href="/src/styles/premises.css" />

    <section class="project-hero">
        <div class="hero-content fade-in">
            <p class="hero-location">MURCIA</p>
            <h1>Local Comercial convertido en Estudios</h1>
        </div>
    </section>

    <section class="project-details fade-in">
        <a href="/proyectos" class="back-link">← Volver a Proyectos</a>

        <div class="detail-section" style="margin-top: 40px;">
            <h2>Detalles del Proyecto</h2>
            <div class="info-grid">
                <div class="info-card">
                    <h4>Tipo de activo</h4>
                    <p>Bajo Comercial</p>
                </div>
                <div class="info-card">
                    <h4>Ubicación</h4>
                    <p>Zona Urbana de Murcia</p>
                </div>
                <div class="info-card">
                    <h4>Superficie</h4>
                    <p>120 m²</p>
                </div>
                <div class="info-card">
                    <h4>Distribución</h4>
                    <p>3 Estudios de 40 m²</p>
                </div>
            </div>
        </div>

        <div class="detail-section">
            <h2>Costes del Proyecto</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Concepto</th>
                        <th>Importe</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Compra del Inmueble</td>
                        <td>90.000 €</td>
                    </tr>
                    <tr>
                        <td>Reforma Integral (3x40.000)</td>
                        <td>120.000 €</td>
                    </tr>
                    <tr>
                        <td>Licencias y Arquitecto</td>
                        <td>15.000 €</td>
                    </tr>
                    <tr>
                        <td>Amueblamiento Básico</td>
                        <td>9.000 €</td>
                    </tr>
                    <tr>
                        <td>Costes Imprevistos y Cierre</td>
                        <td>6.000 €</td>
                    </tr>
                    <tr>
                        <td><strong>Inversión Total</strong></td>
                        <td><strong>240.000 €</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="detail-section">
            <h2>Rentabilidad</h2>
            <div
                style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px;"
            >
                <!-- Rentabilidad por Venta -->
                <div
                    class="info-card"
                    style="background: #fff; border: 1px solid #eee;"
                >
                    <h3 style="font-size: 1.5rem; margin-bottom: 20px;">
                        Por Venta
                    </h3>
                    <ul
                        style="list-style: none; padding: 0; margin-bottom: 20px;"
                    >
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>Precio Venta (tras Reforma)</span>
                            <strong>105.000 €</strong>
                        </li>
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>Beneficio Neto est.</span>
                            <strong>75.000 €</strong>
                        </li>
                    </ul>
                    <div
                        style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #eee; padding-top: 15px;"
                    >
                        <span>ROI Neto:</span>
                        <span class="roi-badge">31,25 %</span>
                    </div>
                </div>

                <!-- Rentabilidad por Alquiler -->
                <div
                    class="info-card"
                    style="background: #fff; border: 1px solid #eee;"
                >
                    <h3 style="font-size: 1.5rem; margin-bottom: 20px;">
                        Por Alquiler
                    </h3>
                    <ul
                        style="list-style: none; padding: 0; margin-bottom: 20px;"
                    >
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>Alquiler Mensual/estudio</span>
                            <strong>600 €</strong>
                        </li>
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>Ingresos Anuales</span>
                            <strong>21.600 €</strong>
                        </li>
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between; color: #666;"
                        >
                            <span>Gastos Operativos (10%)</span>
                            <span>-2.160 €</span>
                        </li>
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>Ingresos Netos</span>
                            <strong>19.440 €</strong>
                        </li>
                    </ul>
                    <div
                        style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #eee; padding-top: 15px;"
                    >
                        <span>ROI Neto:</span>
                        <span class="roi-badge">8,10 %</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="executive-summary">
            <h3>Resumen Ejecutivo</h3>
            <p>
                Proyecto apto tanto para inversores orientados a reventa como
                para renta a largo plazo. Todos los estudios son unidades
                independientes con baño y cocina. Cumple ROI mínimo en ambas
                estrategias.
            </p>
        </div>

        <div style="text-align: center; margin-top: 60px;">
            <a
                href="/#contacto"
                class="btn-primary"
                style="background-color: var(--premises-accent); color: #000; padding: 15px 40px; text-decoration: none; border-radius: 50px; font-weight: 700; display: inline-block;"
                >ME INTERESA ESTE MODELO</a
            >
        </div>
    </section>
</ProjectLayout>
