---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import ProjectLayout from "../layouts/ProjectLayout.astro";
import Hero from "../components/Hero.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ProjectLayout
    title={`Proyectos | ${t("brand.name")}`}
    bodyClass="portfolio-page"
>
    <Hero
        title={t("projects.hero.title")}
        subtitle={t("projects.hero.subtitle")}
        backgroundImage="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
        height="50vh"
    >
        <p style="font-size: 1.1rem; opacity: 0.9; margin-top: 20px;">
            {t("projects.hero.description")}
        </p>
    </Hero>

    <section class="portfolio-container project-details container">
        <div class="projects-grid fade-in">
            <!-- Project 1 -->
            <a href="/local-comercial" class="project-card">
                <div class="project-image-container">
                    <img
                        src="/assets/photo-1616046229478-9901c5536a456111.jpg"
                        alt={t("projects.project1.title")}
                    />
                </div>
                <div class="project-info">
                    <div>
                        <p class="project-location">MURCIA</p>
                        <h3>{t("projects.project1.title")}</h3>
                    </div>
                    <span class="btn-view-project"
                        >{t("projects.viewMore")}</span
                    >
                </div>
            </a>

            <!-- Project 2 -->
            <a href="/alquiler-por-habitaciones" class="project-card">
                <div class="project-image-container">
                    <img
                        src="/assets/photo-1616046229478-9901c5536a456111.jpg"
                        alt={t("projects.project2.title")}
                    />
                </div>
                <div class="project-info">
                    <div>
                        <p class="project-location">MADRID</p>
                        <h3>{t("projects.project2.title")}</h3>
                    </div>
                    <span class="btn-view-project"
                        >{t("projects.viewMore")}</span
                    >
                </div>
            </a>

            <!-- Project 5 -->
            <a href="/vivienda-turistica" class="project-card">
                <div class="project-image-container">
                    <img
                        src="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
                        alt={t("projects.project5.title")}
                    />
                </div>
                <div class="project-info">
                    <div>
                        <p class="project-location">ÁGUILAS, MURCIA</p>
                        <h3>{t("projects.project5.title")}</h3>
                    </div>
                    <span class="btn-view-project"
                        >{t("projects.viewMore")}</span
                    >
                </div>
            </a>

            <!-- Project 7 -->
            <a href="/chalet-dividido" class="project-card">
                <div class="project-image-container">
                    <img
                        src="/assets/photo-1616046229478-9901c5536a456111.jpg"
                        alt={t("projects.project7.title")}
                    />
                </div>
                <div class="project-info">
                    <div>
                        <p class="project-location">ALICANTE</p>
                        <h3>{t("projects.project7.title")}</h3>
                    </div>
                    <span class="btn-view-project"
                        >{t("projects.viewMore")}</span
                    >
                </div>
            </a>

            <!-- Project 8 -->
            <a href="/duplex-turistico" class="project-card">
                <div class="project-image-container">
                    <img
                        src="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
                        alt={t("projects.project8.title")}
                    />
                </div>
                <div class="project-info">
                    <div>
                        <p class="project-location">MURCIA</p>
                        <h3>{t("projects.project8.title")}</h3>
                    </div>
                    <span class="btn-view-project"
                        >{t("projects.viewMore")}</span
                    >
                </div>
            </a>
        </div>
    </section>

    <section
        class="cta-portfolio fade-in"
        style="background: var(--component-bg); padding: 80px 0; text-align: center;"
    >
        <div class="container">
            <h2>{t("projects.cta.title")}</h2>
            <p style="margin-bottom: 30px;">
                {t("projects.cta.description")}
            </p>
            <a
                href="/#contacto"
                class="btn-primary"
                style="background-color: var(--color-primary); color: #000; padding: 15px 40px; text-decoration: none; border-radius: 50px; font-weight: 700; display: inline-block;"
                >{t("projects.cta.button")}</a
            >
        </div>
    </section>
</ProjectLayout>
