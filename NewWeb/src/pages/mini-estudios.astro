---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import ProjectLayout from "../layouts/ProjectLayout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ProjectLayout
    title={`Mini Estudios | ${t("brand.name")}`}
    bodyClass="studios-page"
    footerStyle="background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)), url('/assets/lab/lab-footer-bg.jpg') no-repeat center center/cover;"
>
    <section class="project-hero">
        <div class="hero-content fade-in">
            <p class="hero-location">GRANADA</p>
            <h1>{t("projects.studios.title")}</h1>
        </div>
    </section>

    <section class="project-details fade-in">
        <a href="/proyectos" class="back-link">{t("projects.back")}</a>

        <div class="detail-section" style="margin-top: 40px;">
            <h2>{t("projects.details.title")}</h2>
            <div class="info-grid">
                <div class="info-card">
                    <h4>{t("projects.common.details.type")}</h4>
                    <p>
                        {
                            t("projects.common.details.type.vivienda") ||
                                "Vivienda"
                        }
                    </p>
                </div>
                <div class="info-card">
                    <h4>{t("projects.common.details.location")}</h4>
                    <p>Granada</p>
                </div>
                <div class="info-card">
                    <h4>{t("projects.common.details.surface")}</h4>
                    <p>105 m²</p>
                </div>
                <div class="info-card">
                    <h4>{t("projects.common.details.distribution")}</h4>
                    <p>{t("projects.studios.details.distribution")}</p>
                </div>
            </div>
        </div>

        <div class="detail-section">
            <h2>{t("projects.division.costs.title")}</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>{t("contact.form.message") || "Concepto"}</th>
                        <th>{t("projects.costs.total") || "Importe"}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{t("projects.common.costs.compra")}</td>
                        <td>120.000 €</td>
                    </tr>
                    <tr>
                        <td>{t("projects.common.costs.reforma")} (30.000 x3)</td
                        >
                        <td>90.000 €</td>
                    </tr>
                    <tr>
                        <td>{t("projects.common.costs.licencias")}</td>
                        <td>12.000 €</td>
                    </tr>
                    <tr>
                        <td>{t("projects.common.costs.muebles")}</td>
                        <td>8.000 €</td>
                    </tr>
                    <tr>
                        <td>{t("projects.chalet.costs.imprevistos")}</td>
                        <td>5.000 €</td>
                    </tr>
                    <tr>
                        <td
                            ><strong
                                >{
                                    t("projects.costs.total") ||
                                        "Inversión Total"
                                }</strong
                            ></td
                        >
                        <td><strong>235.000 €</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="detail-section">
            <h2>{t("projects.division.roi.title")}</h2>
            <div
                style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px;"
            >
                <!-- Rentabilidad por Venta -->
                <div
                    class="info-card"
                    style="background: #fff; border: 1px solid #eee;"
                >
                    <h3 style="font-size: 1.5rem; margin-bottom: 20px;">
                        {t("projects.division.roi.sale.label")}
                    </h3>
                    <ul
                        style="list-style: none; padding: 0; margin-bottom: 20px;"
                    >
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>{t("projects.studios.roi.sale.price")}</span>
                            <strong>115.000 €</strong>
                        </li>
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>{t("projects.division.roi.sale.profit")}</span
                            >
                            <strong>110.000 €</strong>
                        </li>
                    </ul>
                    <div
                        style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #eee; padding-top: 15px;"
                    >
                        <span>{t("projects.division.roi.net")}</span>
                        <span class="roi-badge">46,80 %</span>
                    </div>
                </div>

                <!-- Rentabilidad por Alquiler -->
                <div
                    class="info-card"
                    style="background: #fff; border: 1px solid #eee;"
                >
                    <h3 style="font-size: 1.5rem; margin-bottom: 20px;">
                        {t("projects.division.roi.rent.label")}
                    </h3>
                    <ul
                        style="list-style: none; padding: 0; margin-bottom: 20px;"
                    >
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>{t("projects.studios.roi.rent.monthly")}</span
                            >
                            <strong>600 €</strong>
                        </li>
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>{t("projects.division.roi.rent.annual")}</span
                            >
                            <strong>21.600 €</strong>
                        </li>
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between; color: #666;"
                        >
                            <span
                                >{
                                    t("projects.division.roi.rent.expenses")
                                }</span
                            >
                            <span>-2.160 €</span>
                        </li>
                        <li
                            style="margin-bottom: 10px; display: flex; justify-content: space-between;"
                        >
                            <span>{t("projects.division.roi.rent.net")}</span>
                            <strong>19.440 €</strong>
                        </li>
                    </ul>
                    <div
                        style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #eee; padding-top: 15px;"
                    >
                        <span>{t("projects.division.roi.net")}</span>
                        <span class="roi-badge">8,27 %</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="executive-summary">
            <h3>{t("projects.executiveSummary")}</h3>
            <p>
                {t("projects.studios.summary")}
            </p>
        </div>

        <div style="text-align: center; margin-top: 60px;">
            <a
                href="/#contacto"
                class="btn-primary"
                style="background-color: var(--studios-accent); color: #000; padding: 15px 40px; text-decoration: none; border-radius: 50px; font-weight: 700; display: inline-block;"
                >{t("projects.interested")}</a
            >
        </div>
    </section>
</ProjectLayout>
