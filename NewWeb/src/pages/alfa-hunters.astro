---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="ALFA HUNTERS | Grupo Alfa"
    bodyClass="hunters-page"
    footerStyle="background: #1d1e20; color: #fff; padding: 60px 0;"
>
    <link slot="head" rel="stylesheet" href="/src/styles/hunters.css" />

    <!-- Hero Section -->
    <section class="hunters-hero">
        <video
            autoplay
            muted
            loop
            playsinline
            poster="/assets/hunters/hero-poster.jpg"
            class="hero-video"
        >
            <source src="/assets/hunters/hero-video.mp4" type="video/mp4" />
        </video>
        <div class="hero-overlay"></div>
        <div class="hero-content fade-in">
            <h1>ALFA HUNTERS</h1>
        </div>
    </section>

    <!-- Team Expansion Section -->
    <section class="team-expansion container">
        <h2 class="fade-in">
            ESTAMOS AMPLIANDO EL <span class="highlight">EQUIPO</span> DE <br
            /><span class="highlight">ALFA HUNTERS</span>
        </h2>
        <div class="benefits-grid">
            <div class="benefit-item fade-in">
                <h3>FLEXIBILIDAD HORARIA</h3>
                <p>
                    Gestiona tu propio tiempo y trabaja a tu ritmo para
                    conciliar tu vida personal y profesional.
                </p>
            </div>
            <div class="benefit-item fade-in">
                <h3>EQUIPO DE RESPALDO</h3>
                <p>
                    Contamos con profesionales experimentados que te apoyarán en
                    cada paso de tu formación.
                </p>
            </div>
            <div class="benefit-item fade-in">
                <h3>COMISIONES ATRACTIVAS</h3>
                <p>
                    Ofrecemos uno de los sistemas de comisiones más competitivos
                    del sector inmobiliario.
                </p>
            </div>
        </div>
    </section>

    <!-- detailed Benefits Section -->
    <section class="container" style="padding: 80px 20px;">
        <h2 class="text-center fade-in" style="margin-bottom: 50px;">
            ¿QUIERES SER UN ALFA HUNTER?
        </h2>
        <div class="steps-grid">
            <div class="step-item fade-in">
                <h3>Trabaja Cómodamente</h3>
                <p>
                    Puedes teletrabajar desde casa o desde cualquier lugar con
                    conexión a internet.
                </p>
            </div>
            <div class="step-item fade-in">
                <h3>Formación Gratuita</h3>
                <p>
                    Te enseñamos todo lo que necesitas para empezar, desde cero
                    y sin costes.
                </p>
            </div>
            <div class="step-item fade-in">
                <h3>Horarios Flexibles</h3>
                <p>Organiza tu jornada de trabajo como mejor te convenga.</p>
            </div>
            <div class="step-item fade-in">
                <h3>Posibilidad de Crecimiento</h3>
                <p>
                    Si demuestras actitud y resultados, puedes ascender rápido
                    dentro de la organización.
                </p>
            </div>
        </div>
    </section>

    <!-- Form Section -->
    <section class="form-section">
        <div class="container">
            <div class="form-container fade-in">
                <h2>Apúntate ahora y da el primer paso</h2>
                <p class="text-center" style="margin-bottom: 30px;">
                    Solo necesitamos tus datos para ponernos en contacto
                    contigo.
                </p>
                <form action="#" method="POST">
                    <div class="form-group">
                        <label for="name">Nombre Completo</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Tu nombre"
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label for="phone">Teléfono de contacto</label>
                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            placeholder="Tu teléfono"
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label for="email">Correo electrónico</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="tu@email.com"
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label for="location">¿Dónde vives?</label>
                        <input
                            type="text"
                            id="location"
                            name="location"
                            placeholder="Ciudad, Provincia"
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label>¿Tienes experiencia en ventas?</label>
                        <div
                            style="display: flex; gap: 20px; flex-wrap: wrap; margin-top: 10px;"
                        >
                            <label style="font-weight: 400;"
                                ><input
                                    type="radio"
                                    name="experience"
                                    value="2+"
                                /> Más de 2 años</label
                            >
                            <label style="font-weight: 400;"
                                ><input
                                    type="radio"
                                    name="experience"
                                    value="<2"
                                /> Menos de 2 años</label
                            >
                            <label style="font-weight: 400;"
                                ><input
                                    type="radio"
                                    name="experience"
                                    value="none"
                                /> Sin experiencia</label
                            >
                        </div>
                    </div>
                    <button type="submit" class="btn-submit">ENVIAR</button>
                </form>
                <p
                    style="font-size: 0.8rem; margin-top: 20px; color: #666; text-align: center;"
                >
                    Al enviar tu información aceptas que te contactemos para una
                    entrevista informativa. Tus datos serán tratados con
                    confidencialidad según nuestra <a
                        href="#"
                        style="color: var(--accent-color);"
                        >Política de Privacidad</a
                    >.
                </p>
            </div>
        </div>
    </section>
</BaseLayout>
