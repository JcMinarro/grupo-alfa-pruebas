---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import InfoGrid from "../components/InfoGrid.astro";
import GridItem from "../components/GridItem.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
    title={`ALFA HUNTERS | ${t("brand.name")}`}
    bodyClass="hunters-page"
>
    <Hero
        title="ALFA HUNTERS"
        backgroundImage="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
        backgroundVideo="/assets/hunters/hero-video.mp4"
        videoPoster="/assets/hunters/hero-poster.jpg"
        height="50vh"
        overlayOpacity={0.4}
    />
    <section
        class="team-expansion container fade-in"
        style="padding: 100px 0; text-align: center;"
    >
        <h2 style="margin-bottom: 60px;">
            {t("hunters.team.title.prefix")}
            <span class="highlight">{t("hunters.team.title.team")}</span>
            {t("hunters.team.title.of")}
            <br /><span class="highlight"
                >{t("hunters.team.title.hunters")}</span
            >
        </h2>
        <InfoGrid columns={3}>
            <GridItem
                title={t("hunters.benefits.flexibility.title")}
                description={t("hunters.benefits.flexibility.desc")}
            />
            <GridItem
                title={t("hunters.benefits.success.title")}
                description={t("hunters.benefits.success.desc")}
            />
            <GridItem
                title={t("hunters.benefits.commissions.title")}
                description={t("hunters.benefits.commissions.desc")}
            />
        </InfoGrid>
    </section>
    <!-- detailed
Benefits Section -->
    <section class="container" style="padding: 80px 20px;">
        <h2 class="text-center fade-in" style="margin-bottom: 50px;">
            {t("hunters.cta.title")}
        </h2>
        <div class="steps-grid">
            <div class="step-item fade-in">
                <h3>{t("hunters.cta.work.title")}</h3>
                <p>
                    {t("hunters.cta.work.desc")}
                </p>
            </div>
            <div class="step-item fade-in">
                <h3>{t("hunters.cta.training.title")}</h3>
                <p>
                    {t("hunters.cta.training.desc")}
                </p>
            </div>
            <div class="step-item fade-in">
                <h3>{t("hunters.cta.hours.title")}</h3>
                <p>{t("hunters.cta.hours.desc")}</p>
            </div>
            <div class="step-item fade-in">
                <h3>{t("hunters.cta.growth.title")}</h3>
                <p>
                    {t("hunters.cta.growth.desc")}
                </p>
            </div>
        </div>
    </section>
    <!-- Form Section -->
    <section class="form-section">
        <div class="container">
            <div class="form-container fade-in">
                <h2>{t("hunters.form.title")}</h2>
                <p class="text-center" style="margin-bottom: 30px;">
                    {t("hunters.form.subtitle")}
                </p>
                <form action="#" method="POST">
                    <div class="form-group">
                        <label for="name">{t("hunters.form.name")}</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder={t("hunters.form.name")}
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label for="phone">{t("hunters.form.phone")}</label>
                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            placeholder={t("hunters.form.phone")}
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label for="email">{t("hunters.form.email")}</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder={t("contact.form.email.placeholder")}
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label for="location"
                            >{t("hunters.form.location")}</label
                        >
                        <input
                            type="text"
                            id="location"
                            name="location"
                            placeholder={t("hunters.form.location.placeholder")}
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label>{t("hunters.form.experience.label")}</label>
                        <div
                            style="display: flex; gap: 20px; flex-wrap: wrap; margin-top: 10px;"
                        >
                            <label style="font-weight: 400;"
                                ><input
                                    type="radio"
                                    name="experience"
                                    value="2+"
                                />
                                {t("hunters.form.experience.more2")}</label
                            >
                            <label style="font-weight: 400;"
                                ><input
                                    type="radio"
                                    name="experience"
                                    value="<2"
                                />
                                {t("hunters.form.experience.less2")}</label
                            >
                            <label style="font-weight: 400;"
                                ><input
                                    type="radio"
                                    name="experience"
                                    value="none"
                                />
                                {t("hunters.form.experience.none")}</label
                            >
                        </div>
                    </div>
                    <button type="submit" class="btn-submit"
                        >{t("contact.form.submit")}</button
                    >
                </form>
                <p
                    style="font-size: 0.8rem; margin-top: 20px; color: #666; text-align: center;"
                >
                    {t("hunters.form.privacy")}
                </p>
            </div>
        </div>
    </section>
</BaseLayout>
