---
import ProjectLayout from "../layouts/ProjectLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectDetails from "../components/project/ProjectDetails.astro";
import ProjectFinancials from "../components/project/ProjectFinancials.astro";
import ProjectROI from "../components/project/ProjectROI.astro";
---

<ProjectLayout title="Dúplex Turístico | Grupo Alfa" bodyClass="duplex-page">
    <Hero
        title="Dúplex Turístico en Centro Histórico"
        location="CENTRO DE MURCIA"
        backgroundImage="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
        height="50vh"
    />

    <section class="project-details container fade-in">
        <a href="/proyectos" class="back-link">← Volver a Proyectos</a>

        <h2>Detalles del Proyecto</h2>
        <ProjectDetails
            type="Piso con Buhardilla"
            location="Casco Antiguo, Murcia"
            surface="100 m² (70 + 30)"
            distribution="Dúplex Turístico"
        />

        <div
            class="project-showcase"
            style="margin: 40px 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;"
        >
            <img
                src="/assets/photo-1616046229478-9901c5536a456111.jpg"
                alt="Interior 1"
                style="width: 100%; border-radius: 8px;"
            />
            <img
                src="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
                alt="Interior 2"
                style="width: 100%; border-radius: 8px;"
            />
        </div>

        <ProjectFinancials
            costs={[
                { concept: "Compra del Inmueble", amount: "85.000 €" },
                { concept: "Reforma Integral", amount: "50.000 €" },
                { concept: "Licencias y Arquitecto", amount: "8.000 €" },
                { concept: "Amueblamiento Turístico", amount: "12.000 €" },
                { concept: "Costes Imprevistos y Cierre", amount: "5.000 €" },
            ]}
            total="160.000 €"
        />

        <ProjectROI
            strategy="both"
            saleData={{
                price: "210.000 € (Rentado)",
                profit: "50.000 € (neto est.)",
                roi: "41,25 %",
            }}
            rentData={{
                monthly: "115 € / noche (media)",
                annual: "21.252 € (neta est.)",
                roi: "13,28 %",
            }}
        />

        <div class="executive-summary">
            <h3>Resumen Ejecutivo</h3>
            <p>
                Ideal para alquiler turístico en casco histórico. Activo único
                por configuración tipo dúplex. Alta rentabilidad tanto en
                explotación como en potencial de revalorización por ubicación
                Premium.
            </p>
        </div>

        <div style="text-align: center; margin-top: 60px;">
            <a
                href="/#contacto"
                class="btn-primary"
                style="background-color: var(--color-primary); color: #000; padding: 15px 40px; text-decoration: none; border-radius: 50px; font-weight: 700; display: inline-block;"
                >ME INTERESA ESTE MODELO</a
            >
        </div>
    </section>
</ProjectLayout>
