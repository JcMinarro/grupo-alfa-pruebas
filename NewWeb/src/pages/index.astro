---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
---

<BaseLayout title="Grupo Alfa | Inversión Inmobiliaria rentable y segura">
    <link slot="head" rel="stylesheet" href="/src/styles/home.css" />
    <link slot="head" rel="stylesheet" href="/src/styles/footer.css" />

    <!-- Hero Section -->
    <section id="inicio" class="hero">
        <div class="hero-overlay"></div>
        <div class="container hero-container">
            <div class="hero-content fade-in">
                <img
                    src="/assets/logo-alfa-black-text.png"
                    alt="Logo"
                    class="section-logo"
                />
                <img
                    src="/assets/logo-alfa-wolf.png"
                    alt="Grupo Alfa"
                    class="hero-logo"
                />
                <h2 class="hero-subtitle">INVERSIÓN INTELIGENTE</h2>
            </div>
        </div>
    </section>

    <!-- Value Props (Steps) -->
    <section class="steps-section">
        <div class="container">
            <div class="text-center fade-in" style="margin-bottom: 60px;">
                <h2 class="section-main-title">
                    CONVIERTE TU DINERO EN UN ACTIVO
                </h2>
                <h2 class="section-secondary-title">TOTALMENTE PASIVO</h2>
                <p class="section-context">En <strong>GRUPO ALFA</strong></p>
            </div>

            <div class="steps-grid">
                <div class="step-item fade-in">
                    <div class="step-icon">
                        <img
                            src="/assets/lupa-AE0r2VjNOpI4LRQ7.png"
                            alt="Localizamos"
                        />
                    </div>
                    <h3>Localizamos</h3>
                </div>
                <div class="step-item fade-in">
                    <div class="step-icon">
                        <img
                            src="/assets/gestion-A3Q7anMajGcEW1Lx.png"
                            alt="Gestionamos"
                        />
                    </div>
                    <h3>Gestionamos</h3>
                </div>
                <div class="step-item fade-in">
                    <div class="step-icon">
                        <img
                            src="/assets/mrtillo-AR032ZKJrRh87JyG.png"
                            alt="Reformamos"
                        />
                    </div>
                    <h3>Reformamos</h3>
                </div>
                <div class="step-item fade-in">
                    <div class="step-icon">
                        <img
                            src="/assets/euros-YD0w8Okj99HLq6az.png"
                            alt="Rentabilizamos"
                        />
                    </div>
                    <h3>Rentabilizamos</h3>
                </div>
            </div>

            <div class="process-flow fade-in">
                <div class="flow-item">
                    <p>Y podemos <span>Financiar</span></p>
                    <img
                        src="/assets/flecha-abajo-AzGN41EZW0T39oZP.png"
                        class="arrow-right"
                        alt="arrow"
                    />
                </div>
                <div class="flow-item">
                    <p>Tu Inversión Inmobiliaria</p>
                    <div class="flow-icon">
                        <img
                            src="/assets/casa-AR032qQw99I1yKM5.png"
                            alt="Casa"
                        />
                    </div>
                    <img
                        src="/assets/flecha-abajo-AzGN41EZW0T39oZP.png"
                        class="arrow-right"
                        alt="arrow"
                    />
                </div>
                <div class="flow-item">
                    <p>Y tú solo <span>Cobras</span></p>
                </div>
            </div>
        </div>
    </section>

    <!-- Libertad Financiera Section -->
    <section class="libertad-section">
        <div class="container text-center">
            <h2 class="section-main-title">CONSTRUYE TU</h2>
            <h2 class="section-secondary-title">LIBERTAD FINANCIERA</h2>
            <img
                src="/assets/logo-alfa-horizontal.png"
                alt="Logo"
                class="section-logo"
            />
            <p class="rentability">
                Consigue rentabilidades de hasta el <span>10%</span> o más.
            </p>
            <p class="description">
                Haz que tu dinero genere ingresos mientras disfrutas de tu
                tiempo libre.<br />
                Empieza hoy a invertir en proyectos inmobiliarios con toda la libertad
                financiera.
            </p>
        </div>
    </section>

    <!-- Quote/Bedroom Section -->
    <section class="quote-section">
        <div class="container text-center fade-in">
            <img
                src="/assets/logo-alfa-black-text.png"
                alt="Logo"
                class="section-logo"
                style="width: 150px; margin-bottom: 20px;"
            />
            <p class="quote-text">
                El socio ideal para transformar inmuebles en fuentes de ingresos
                100% pasivos. Nos ocupamos de todo.
            </p>
            <div class="bedroom-image">
                <img
                    src="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
                    alt="Bedroom"
                />
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section id="servicios" class="services-section">
        <div class="text-center" style="padding: 80px 0 20px;">
            <h2 class="section-secondary-title" style="margin-bottom: 40px;">
                NUESTROS SERVICIOS
            </h2>
        </div>

        <div class="services-list">
            <div class="service-row">
                <div class="container">
                    <div class="service-text">
                        <h3>PERSONAL SHOPPER INMOBILIARIO</h3>
                        <p>
                            Te ayudamos a encontrar propiedades con gran
                            potencial, al mejor precio y adaptadas a tu
                            presupuesto (pago al contado, con financiación o
                            alquiler con opción a compra, compra aplazada...)
                        </p>
                    </div>
                    <div class="service-icon-large">
                        <img
                            src="/assets/lupa-AE0r2VjNOpI4LRQ7.png"
                            alt="icon"
                        />
                    </div>
                </div>
            </div>

            <div class="service-row">
                <div class="container">
                    <div class="service-text">
                        <h3>REFORMA Y RESTAURACIÓN INTEGRAL</h3>
                        <p>
                            Somos especialistas en transformar casas antiguas,
                            pisos deteriorados y propiedades con historia en
                            auténticas joyas del mercado. Nuestro equipo incluye
                            arquitectos, técnicos y reformistas con años de
                            experiencia.
                        </p>
                    </div>
                    <div class="service-icon-large">
                        <img
                            src="/assets/mrtillo-AR032ZKJrRh87JyG.png"
                            alt="icon"
                        />
                    </div>
                </div>
            </div>

            <div class="service-row">
                <div class="container">
                    <div class="service-text">
                        <h3>BROKER HIPOTECARIO PERSONALIZADO</h3>
                        <p>
                            Trabajamos con las principales entidades financieras
                            para conseguirte las mejores condiciones
                            hipotecarias, tanto si eres particular como empresa.
                            Nosotros negociamos por ti.
                        </p>
                    </div>
                    <div class="service-icon-large">
                        <img
                            src="/assets/casa-AR032qQw99I1yKM5.png"
                            alt="icon"
                        />
                    </div>
                </div>
            </div>

            <div class="service-row">
                <div class="container">
                    <div class="service-text">
                        <h3>INTERIORISMO Y HOMESTAGING</h3>
                        <p>
                            Ponemos a punto el inmueble para que cause una
                            primera impresión irresistible. Creamos ambientes
                            donde tus futuros inquilinos o compradores se
                            imaginan viviendo desde el primer segundo.
                        </p>
                    </div>
                    <div class="service-icon-large">
                        <img
                            src="/assets/interiorismo-m6LbP1Zkv6HB177D.png"
                            alt="icon"
                        />
                    </div>
                </div>
            </div>

            <div class="service-row">
                <div class="container">
                    <div class="service-text">
                        <h3>GESTIÓN DE ALQUILER Y RENTABILIDAD</h3>
                        <p>
                            Maximizamos el rendimiento de tu inversión
                            encargándonos de todo el proceso de alquiler. Desde
                            la selección del inquilino hasta la gestión de
                            cobros y mantenimiento.
                        </p>
                    </div>
                    <div class="service-icon-large">
                        <img
                            src="/assets/llave-YX4x19levpIeRQRZ.png"
                            alt="icon"
                        />
                    </div>
                </div>
            </div>
        </div>

        <div
            class="text-center"
            style="margin-top: 60px; padding-bottom: 80px;"
        >
            <p style="font-style: italic; margin-bottom: 20px;">
                Te acompañamos en todos y cada uno de los pasos
            </p>
            <a href="/contacto" class="btn">QUIERO MI PROYECTO</a>
        </div>
    </section>

    <!-- Submarcas Section -->
    <section id="submarcas" class="submarcas-section fade-in">
        <div class="container">
            <div class="submarcas-grid">
                <a href="/flip-art" class="submarca-tag">FLIP ART</a>
                <a href="/lujo-rent" class="submarca-tag">LUJO RENT</a>
                <a href="/seguros" class="submarca-tag"
                    >GRUPO ALFA<br />SEGUROS</a
                >
                <a href="/alfa-clean" class="submarca-tag">ALFA CLEAN</a>
                <a href="/rey-subastos" class="submarca-tag">Rey Subastos</a>
                <a href="/alfa-lab" class="submarca-tag">ALFA LAB</a>
            </div>
        </div>
    </section>

    <!-- Office and Contact Section -->
    <section id="contacto" class="office-section">
        <div class="container">
            <div class="office-grid">
                <div class="office-info fade-in">
                    <h2 class="section-main-title">NUESTRA OFICINA</h2>
                    <p>Encuéntranos en esta dirección.</p>
                    <div class="contact-details">
                        <p>
                            C/ Conde del Valle de San Juan, 1<br />(Gran Vía
                            Escultor Salzillo, 1)
                        </p>
                        <p>30004, Murcia</p>
                    </div>
                </div>
                <div class="office-map fade-in">
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3144.136343513689!2d-1.131464323455642!3d37.98561730006764!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd6382101cc25555%3A0x6b8a8670868a867!2sC.%20Conde%20del%20Valle%20de%20San%20Juan%2C%201%2C%2030004%20Murcia!5e0!3m2!1sen!2ses!4v1700000000000!5m2!1sen!2ses"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>

            <div class="contact-section-home" style="margin-top: 80px;">
                <div class="office-grid">
                    <div class="fade-in">
                        <h2 class="section-main-title">Contáctanos</h2>
                        <p>
                            Responderemos encantados a<br />su consulta a la
                            mayor brevedad posible.
                        </p>
                        <div style="margin-top: 40px;">
                            <img
                                src="/assets/logo-alfa-wolf.png"
                                alt="Logo"
                                style="width: 100px;"
                            />
                        </div>
                    </div>
                    <div class="contact-form-home fade-in">
                        <ContactForm />
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
