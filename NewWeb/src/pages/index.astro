---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceList from "../components/ServiceList.astro";
import ContactForm from "../components/ContactForm.astro";
import Hero from "../components/Hero.astro";
---

<BaseLayout title="Grupo Alfa | Inversión Inmobiliaria rentable y segura">
    <!-- Hero Section -->
    <Hero
        id="inicio"
        backgroundImage="/assets/hero-bg.jpg"
        overlayOpacity={0.4}
        height="100vh"
    >
        <img
            src="/assets/logo-alfa-black-text.png"
            alt="Logo"
            class="section-logo"
            style="width: 250px; margin-bottom: 2rem;"
        />
        <img
            src="/assets/logo-alfa-wolf.png"
            alt="Grupo Alfa"
            class="hero-logo"
            style="width: 500px; margin-bottom: 1rem;"
        />
        <h2 class="hero-subtitle">INVERSIÓN INTELIGENTE</h2>
    </Hero>

    <!-- Value Props (Steps) -->
    <section class="steps-section">
        <div class="container">
            <div class="text-center fade-in" style="margin-bottom: 60px;">
                <h2 class="section-main-title">
                    CONVIERTE TU DINERO EN UN ACTIVO
                </h2>
                <h2 class="section-secondary-title text-primary">
                    TOTALMENTE PASIVO
                </h2>
                <p class="section-context">En <strong>GRUPO ALFA</strong></p>
            </div>

            <div class="steps-grid">
                <div class="step-item fade-in">
                    <div class="step-icon">
                        <img
                            src="/assets/lupa-AE0r2VjNOpI4LRQ7.png"
                            alt="Localizamos"
                        />
                    </div>
                    <h3>Localizamos</h3>
                </div>
                <div class="step-item fade-in">
                    <div class="step-icon">
                        <img
                            src="/assets/gestion-A3Q7anMajGcEW1Lx.png"
                            alt="Gestionamos"
                        />
                    </div>
                    <h3>Gestionamos</h3>
                </div>
                <div class="step-item fade-in">
                    <div class="step-icon">
                        <img
                            src="/assets/mrtillo-AR032ZKJrRh87JyG.png"
                            alt="Reformamos"
                        />
                    </div>
                    <h3>Reformamos</h3>
                </div>
                <div class="step-item fade-in">
                    <div class="step-icon">
                        <img
                            src="/assets/euros-YD0w8Okj99HLq6az.png"
                            alt="Rentabilizamos"
                        />
                    </div>
                    <h3>Rentabilizamos</h3>
                </div>
            </div>

            <div class="process-flow fade-in">
                <div class="flow-item">
                    <p>Y podemos <span>Financiar</span></p>
                </div>

                <div class="arrow-triangle-down"></div>

                <div class="flow-item">
                    <p>Tu Inversión Inmobiliaria</p>
                </div>

                <div class="arrow-triangle-down"></div>

                <div class="flow-item">
                    <div class="flow-icon">
                        <img src="/assets/casa-icon.png" alt="Casa" />
                    </div>
                    <p>Y tú solo <span>Cobras</span></p>
                </div>
            </div>
        </div>
    </section>

    <!-- Libertad Financiera Section -->
    <section class="libertad-section">
        <div class="container text-center">
            <h2 class="section-main-title">CONSTRUYE TU</h2>
            <h2 class="section-secondary-title text-primary">
                LIBERTAD FINANCIERA
            </h2>
            <img
                src="/assets/logo-alfa-wolf.png"
                alt="Logo"
                class="section-logo"
                style="height: 60px; filter: brightness(0) invert(1);"
            />
            <p class="rentability">
                Consigue rentabilidades de hasta el <span>20%</span> o más.
            </p>
            <p class="description">
                Haz que tu dinero genere ingresos mientras disfrutas de tu
                tiempo libre.<br />
                Empieza hoy a invertir en proyectos inmobiliarios con toda la libertad
                financiera.
            </p>
        </div>
    </section>

    <!-- Quote/Bedroom Section -->
    <section class="quote-section">
        <div class="container text-center fade-in">
            <img
                src="/assets/logo-alfa-black-text.png"
                alt="Logo"
                class="section-logo-small"
            />
            <p class="quote-text">
                El socio ideal para transformar inmuebles en fuentes de ingresos
                100% pasivos. Nos ocupamos de todo.
            </p>
            <div class="bedroom-image">
                <img
                    src="/assets/photo-1618773928121-c32242e63f39ad04.jpg"
                    alt="Bedroom"
                />
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section id="servicios" class="services-section">
        <div class="text-center services-header">
            <h2 class="section-secondary-title text-black">
                NUESTROS SERVICIOS
            </h2>
        </div>

        <ServiceList />

        <div
            class="text-center"
            style="margin-top: 60px; padding-bottom: 80px; color: var(--color-text-dark);"
        >
            <p style="font-style: italic; margin-bottom: 20px;">
                Te acompañamos en todos y cada uno de los pasos
            </p>
            <a href="/contacto" class="btn-primary">QUIERO MI PROYECTO</a>
        </div>
    </section>

    <!-- Submarcas Section -->
    <section id="submarcas" class="submarcas-section fade-in">
        <div class="container">
            <div class="submarcas-grid">
                <a href="/flip-art" class="submarca-tag">FLIP ART</a>
                <a href="/lujo-rent" class="submarca-tag">LUJO RENT</a>
                <a href="/seguros" class="submarca-tag"
                    >GRUPO ALFA<br />SEGUROS</a
                >
                <a href="/alfa-clean" class="submarca-tag">ALFA CLEAN</a>
                <a href="/rey-subastos" class="submarca-tag">Rey Subastos</a>
                <a href="/alfa-lab" class="submarca-tag">ALFA LAB</a>
            </div>
        </div>
    </section>

    <!-- Office and Contact Section -->
    <section id="contacto" class="office-section">
        <div class="container">
            <div class="office-grid">
                <div class="office-info fade-in">
                    <h2 class="section-main-title">NUESTRA OFICINA</h2>
                    <p>Encuéntranos en esta dirección.</p>
                    <div class="contact-details">
                        <p>
                            C/ Conde del Valle de San Juan, 1<br />(Gran Vía
                            Escultor Salzillo, 1)
                        </p>
                        <p>30004, Murcia</p>
                    </div>
                </div>
                <div class="office-map fade-in">
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3144.136343513689!2d-1.131464323455642!3d37.98561730006764!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd6382101cc25555%3A0x6b8a8670868a867!2sC.%20Conde%20del%20Valle%20de%20San%20Juan%2C%201%2C%2030004%20Murcia!5e0!3m2!1sen!2ses!4v1700000000000!5m2!1sen!2ses"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>

            <div class="home-contact-section">
                <div class="office-grid">
                    <div class="fade-in">
                        <h2 class="section-main-title">Contáctanos</h2>
                        <p>
                            Responderemos encantados a<br />su consulta a la
                            mayor brevedad posible.
                        </p>
                        <div class="contact-intro-logo">
                            <img src="/assets/logo-alfa-wolf.png" alt="Logo" />
                        </div>
                    </div>
                    <div class="contact-form-home fade-in">
                        <ContactForm theme="light" />
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
