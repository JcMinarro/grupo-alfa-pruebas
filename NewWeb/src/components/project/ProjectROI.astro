---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

interface SaleData {
    price: string;
    profit: string;
    roi: string;
}

interface RentData {
    monthly: string;
    annual: string;
    operationalCosts?: string;
    netAnnual?: string;
    roi: string;
}

interface Props {
    title?: string;
    strategy?: "sale" | "rent" | "both";
    saleData?: SaleData;
    rentData?: RentData;
    class?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
    title = t("projects.division.roi.title"),
    strategy = "both",
    saleData,
    rentData,
    class: className = "",
} = Astro.props;
---

<div class={`project-roi ${className}`}>
    <h2>{title}</h2>
    <div class="roi-grid">
        {
            (strategy === "sale" || strategy === "both") && saleData && (
                <div class="info-card">
                    <h3>{t("projects.division.roi.sale.label")}</h3>
                    <div class="roi-stats">
                        <div class="stat">
                            <span>{t("projects.common.roi.sale.price")}</span>
                            <strong>{saleData.price}</strong>
                        </div>
                        <div class="stat">
                            <span>{t("projects.common.roi.sale.profit")}</span>
                            <strong>{saleData.profit}</strong>
                        </div>
                    </div>
                    <div class="roi-highlight">
                        <span>{t("projects.common.roi.label")}</span>
                        <strong>{saleData.roi}</strong>
                    </div>
                </div>
            )
        }

        {
            (strategy === "rent" || strategy === "both") && rentData && (
                <div class="info-card">
                    <h3>{t("projects.division.roi.rent.label")}</h3>
                    <div class="roi-stats">
                        <div class="stat">
                            <span>{t("projects.common.roi.rent.monthly")}</span>
                            <strong>{rentData.monthly}</strong>
                        </div>
                        <div class="stat">
                            <span>{t("projects.common.roi.rent.annual")}</span>
                            <strong>{rentData.annual}</strong>
                        </div>
                    </div>
                    <div class="roi-highlight">
                        <span>{t("projects.common.roi.label")}</span>
                        <strong>{rentData.roi}</strong>
                    </div>
                </div>
            )
        }
    </div>
</div>

<style>
    .project-roi {
        margin-bottom: 60px;
    }

    h2 {
        font-size: 1.5rem;
        margin-bottom: 25px;
        text-transform: uppercase;
        border-left: 4px solid var(--color-primary);
        padding-left: 15px;
        color: var(--component-text);
    }

    .roi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 40px;
    }

    .info-card {
        padding: 30px;
        background: var(--component-bg);
        border: 1px solid var(--component-border);
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    .info-card h3 {
        font-size: 1.2rem;
        margin: 0;
        text-transform: uppercase;
        color: var(--component-text);
    }

    .roi-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .stat span {
        font-size: 0.75rem;
        opacity: 0.7;
        letter-spacing: 1px;
        color: var(--component-text-muted);
    }

    .stat strong {
        font-size: 1.1rem;
        color: var(--color-primary);
    }

    .roi-highlight {
        margin-top: auto;
        padding-top: 20px;
        border-top: 1px solid var(--component-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .roi-highlight span {
        font-weight: 700;
        letter-spacing: 2px;
        color: var(--component-text);
    }

    .roi-highlight strong {
        font-size: 2rem;
        color: var(--color-primary);
    }
</style>
